///|
fn arrow_outcome(directions : Array[String]) -> String {
  let mask = @block.arrow_mask(directions)
  let s = @block.arrow_size(mask, 37.5, 19)
  let z = @block.arrow_size(mask, 0, 0)
  [
    "\{mask} \{@block.arrow_axis(mask)} \{s.w} \{s.h} \{s.dx} \{s.dy} \{z.w} \{z.h} \{z.dx} \{z.dy}",
    @block.draw_arrow(mask, s.w, s.h, " a=\"b\""),
    @block.draw_arrow(mask, 70.25, 120.5, ""),
  ].join("\n")
}

///|
test "sizes and outlines arrows as pele does" {
  for item in arrow_cases {
    let (directions, expected) = item
    assert_eq(arrow_outcome(directions), expected, msg=directions.join(","))
  }
}
