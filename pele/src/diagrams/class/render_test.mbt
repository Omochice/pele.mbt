///|
test "draws namespaces as nested groups around their classes" {
  assert_eq(
    snapshot(
      drawn(
        "classDiagram\nnamespace Outer {\n  class A\n  namespace Inner[\"In here\"] {\n    class B\n  }\n}\nclass C\nA --> B\nB --> C",
      ),
    ),
