///|
test "draws a lollipop interface as a ring with its name beside the class" {
  assert_eq(
    snapshot(drawn("classDiagram\nbar ()-- foo\nfoo --() baz")),
    "80 x 230 []\n<svg xmlns=\"http://www.w3.org/2000/svg\" class=\"pele pele-class\" viewBox=\"0 0 80 230\" width=\"80\" height=\"230\" style=\"max-width:100%;height:auto;--_bg:var(--pele-bg,#fff);--_fg:var(--pele-fg,#1f1f1f);--_m:var(--pele-muted,#6e6e6e);--_l:var(--pele-line,#1f1f1f);--_s:var(--pele-surface,#f3f3f3);--_a:var(--pele-surface-alt,#e6e6e6);--_b:var(--pele-border,#8a8a8a);--_c:var(--pele-accent,#5b7bd5);color:var(--_fg);--_r:var(--pele-radius,4px);--_hw:var(--pele-heading-weight,bold);--_fm:var(--pele-font-mono,monospace);font:16px sans-serif;letter-spacing:normal;word-spacing:normal;text-transform:none;direction:ltr;font-family:var(--pele-font,sans-serif)\" fill=\"var(--_fg)\" role=\"graphics-document document\" aria-roledescription=\"class\"><g class=\"pele-edges\" fill=\"none\" stroke=\"var(--_l)\" stroke-linecap=\"round\"><g class=\"pele-edge pele-relation\" data-id=\"id_interface0_foo_1\"><path d=\"M40,39L40,85\"/><circle class=\"pele-marker\" cx=\"40\" cy=\"34\" r=\"5\"/></g><g class=\"pele-edge pele-relation\" data-id=\"id_foo_interface1_2\"><path d=\"M40,145L40,191\"/><circle class=\"pele-marker\" cx=\"40\" cy=\"196\" r=\"5\"/></g></g><g class=\"pele-nodes\"><g class=\"pele-node pele-class\" data-id=\"foo\" transform=\"translate(40,115)\"><rect x=\"-32\" y=\"-30\" width=\"64\" height=\"60\" fill=\"var(--_s)\" stroke=\"var(--_b)\" style=\"rx:var(--_r)\"/><path class=\"pele-divider\" d=\"M-32,10H32M-32,20H32\" fill=\"none\" stroke=\"var(--_b)\"/><text class=\"pele-label\" font-weight=\"var(--_hw)\" text-anchor=\"middle\" xml:space=\"preserve\"><tspan x=\"0\" y=\"-4.4\">foo</tspan></text></g><g class=\"pele-node pele-interface\" data-id=\"interface0\" transform=\"translate(40,18.5)\"><text class=\"pele-label\" font-size=\"14\" x=\"0\" y=\"4.9\" text-anchor=\"middle\">bar</text></g><g class=\"pele-node pele-interface\" data-id=\"interface1\" transform=\"translate(40,211.5)\"><text class=\"pele-label\" font-size=\"14\" x=\"0\" y=\"4.9\" text-anchor=\"middle\">baz</text></g></g></svg>",
