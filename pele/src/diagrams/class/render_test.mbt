///|
test "keeps a lollipop interface in the namespace of its class" {
  assert_eq(
    snapshot(drawn("classDiagram\nnamespace N {\n  class A\n}\nbar ()-- A")),
    "120 x 213 []\n<svg xmlns=\"http://www.w3.org/2000/svg\" class=\"pele pele-class\" viewBox=\"0 0 120 213\" width=\"120\" height=\"213\" style=\"max-width:100%;height:auto;--_bg:var(--pele-bg,#fff);--_fg:var(--pele-fg,#1f1f1f);--_m:var(--pele-muted,#6e6e6e);--_l:var(--pele-line,#1f1f1f);--_s:var(--pele-surface,#f3f3f3);--_a:var(--pele-surface-alt,#e6e6e6);--_b:var(--pele-border,#8a8a8a);--_c:var(--pele-accent,#5b7bd5);color:var(--_fg);--_r:var(--pele-radius,4px);--_hw:var(--pele-heading-weight,bold);--_fm:var(--pele-font-mono,monospace);font:16px sans-serif;letter-spacing:normal;word-spacing:normal;text-transform:none;direction:ltr;font-family:var(--pele-font,sans-serif)\" fill=\"var(--_fg)\" role=\"graphics-document document\" aria-roledescription=\"class\"><g class=\"pele-clusters\"><g class=\"pele-cluster pele-namespace\" data-id=\"N\"><rect x=\"8\" y=\"8\" width=\"104\" height=\"197\" fill=\"var(--_a)\" fill-opacity=\"0.5\" stroke=\"var(--_b)\" style=\"rx:var(--_r)\"/><text class=\"pele-cluster-label\" fill=\"var(--_m)\" x=\"27.78\" y=\"33.6\" text-anchor=\"middle\">N</text></g></g><g class=\"pele-edges\" fill=\"none\" stroke=\"var(--_l)\" stroke-linecap=\"round\"><g class=\"pele-edge pele-relation\" data-id=\"id_interface0_A_1\"><path d=\"M60,79L60,125\"/><circle class=\"pele-marker\" cx=\"60\" cy=\"74\" r=\"5\"/></g></g><g class=\"pele-nodes\"><g class=\"pele-node pele-class\" data-id=\"A\" transform=\"translate(60,155)\"><rect x=\"-32\" y=\"-30\" width=\"64\" height=\"60\" fill=\"var(--_s)\" stroke=\"var(--_b)\" style=\"rx:var(--_r)\"/><path class=\"pele-divider\" d=\"M-32,10H32M-32,20H32\" fill=\"none\" stroke=\"var(--_b)\"/><text class=\"pele-label\" font-weight=\"var(--_hw)\" text-anchor=\"middle\" xml:space=\"preserve\"><tspan x=\"0\" y=\"-4.4\">A</tspan></text></g><g class=\"pele-node pele-interface\" data-id=\"interface0\" transform=\"translate(60,58.5)\"><text class=\"pele-label\" font-size=\"14\" x=\"0\" y=\"4.9\" text-anchor=\"middle\">bar</text></g></g></svg>",
  )
}

///|
test "wraps a linked class in an anchor and reports it" {
  assert_eq(
    snapshot(
      drawn(
        "classDiagram\nclass A\nclass B\nclass C\nlink A \"https://example.com/a\" \"Tip A\"\nclick B href \"https://example.com/b\" _self\ncallback C \"fn\" \"Tip C\"",
      ),
    ),
    "288 x 76 [A https://example.com/a false, B https://example.com/b false]\n<svg xmlns=\"http://www.w3.org/2000/svg\" class=\"pele pele-class\" viewBox=\"0 0 288 76\" width=\"288\" height=\"76\" style=\"max-width:100%;height:auto;--_bg:var(--pele-bg,#fff);--_fg:var(--pele-fg,#1f1f1f);--_m:var(--pele-muted,#6e6e6e);--_l:var(--pele-line,#1f1f1f);--_s:var(--pele-surface,#f3f3f3);--_a:var(--pele-surface-alt,#e6e6e6);--_b:var(--pele-border,#8a8a8a);--_c:var(--pele-accent,#5b7bd5);color:var(--_fg);--_r:var(--pele-radius,4px);--_hw:var(--pele-heading-weight,bold);--_fm:var(--pele-font-mono,monospace);font:16px sans-serif;letter-spacing:normal;word-spacing:normal;text-transform:none;direction:ltr;font-family:var(--pele-font,sans-serif)\" fill=\"var(--_fg)\" role=\"graphics-document document\" aria-roledescription=\"class\"><g class=\"pele-nodes\"><g class=\"pele-node pele-class clickable\" data-id=\"A\" transform=\"translate(40,38)\"><a href=\"https://example.com/a\" target=\"_blank\" rel=\"noopener\"><title>Tip A</title><rect x=\"-32\" y=\"-30\" width=\"64\" height=\"60\" fill=\"var(--_s)\" stroke=\"var(--_b)\" style=\"rx:var(--_r)\"/><path class=\"pele-divider\" d=\"M-32,10H32M-32,20H32\" fill=\"none\" stroke=\"var(--_b)\"/><text class=\"pele-label\" font-weight=\"var(--_hw)\" text-anchor=\"middle\" xml:space=\"preserve\"><tspan x=\"0\" y=\"-4.4\">A</tspan></text></a></g><g class=\"pele-node pele-class clickable\" data-id=\"B\" transform=\"translate(144,38)\"><a href=\"https://example.com/b\" target=\"_self\" rel=\"noopener\"><rect x=\"-32\" y=\"-30\" width=\"64\" height=\"60\" fill=\"var(--_s)\" stroke=\"var(--_b)\" style=\"rx:var(--_r)\"/><path class=\"pele-divider\" d=\"M-32,10H32M-32,20H32\" fill=\"none\" stroke=\"var(--_b)\"/><text class=\"pele-label\" font-weight=\"var(--_hw)\" text-anchor=\"middle\" xml:space=\"preserve\"><tspan x=\"0\" y=\"-4.4\">B</tspan></text></a></g><g class=\"pele-node pele-class clickable\" data-id=\"C\" transform=\"translate(248,38)\"><title>Tip C</title><rect x=\"-32\" y=\"-30\" width=\"64\" height=\"60\" fill=\"var(--_s)\" stroke=\"var(--_b)\" style=\"rx:var(--_r)\"/><path class=\"pele-divider\" d=\"M-32,10H32M-32,20H32\" fill=\"none\" stroke=\"var(--_b)\"/><text class=\"pele-label\" font-weight=\"var(--_hw)\" text-anchor=\"middle\" xml:space=\"preserve\"><tspan x=\"0\" y=\"-4.4\">C</tspan></text></g></g></svg>",
  )
}

///|
test "applies style, classDef, cssClass and the ::: shorthand" {
  assert_eq(
    snapshot(
      drawn(
        "classDiagram\nclass A\nclass B:::hot\nclass C\nclass D {\n +x$\n}\nclassDef default stroke:#00f\nstyle A fill:#f9f,stroke:#333,stroke-width:4px\nclassDef hot fill:#fdd,color:#900\nclassDef cold fill:#ddf\ncssClass \"C,D\" cold\nstyle D color:#090",
      ),
    ),
    "392 x 99 []\n<svg xmlns=\"http://www.w3.org/2000/svg\" class=\"pele pele-class\" viewBox=\"0 0 392 99\" width=\"392\" height=\"99\" style=\"max-width:100%;height:auto;--_bg:var(--pele-bg,#fff);--_fg:var(--pele-fg,#1f1f1f);--_m:var(--pele-muted,#6e6e6e);--_l:var(--pele-line,#1f1f1f);--_s:var(--pele-surface,#f3f3f3);--_a:var(--pele-surface-alt,#e6e6e6);--_b:var(--pele-border,#8a8a8a);--_c:var(--pele-accent,#5b7bd5);color:var(--_fg);--_r:var(--pele-radius,4px);--_hw:var(--pele-heading-weight,bold);--_fm:var(--pele-font-mono,monospace);font:16px sans-serif;letter-spacing:normal;word-spacing:normal;text-transform:none;direction:ltr;font-family:var(--pele-font,sans-serif)\" fill=\"var(--_fg)\" role=\"graphics-document document\" aria-roledescription=\"class\"><g class=\"pele-nodes\"><g class=\"pele-node pele-class\" data-id=\"A\" transform=\"translate(40,49.5)\"><rect x=\"-32\" y=\"-30\" width=\"64\" height=\"60\" fill=\"var(--_s)\" stroke=\"var(--_b)\" style=\"rx:var(--_r);stroke:#333;fill:#f9f;stroke-width:4px;\"/><path class=\"pele-divider\" d=\"M-32,10H32M-32,20H32\" fill=\"none\" stroke=\"var(--_b)\" style=\"stroke:#333\"/><text class=\"pele-label\" font-weight=\"var(--_hw)\" text-anchor=\"middle\" xml:space=\"preserve\"><tspan x=\"0\" y=\"-4.4\">A</tspan></text></g><g class=\"pele-node pele-class hot\" data-id=\"B\" transform=\"translate(144,49.5)\"><rect x=\"-32\" y=\"-30\" width=\"64\" height=\"60\" fill=\"var(--_s)\" stroke=\"var(--_b)\" style=\"rx:var(--_r);stroke:#00f;fill:#fdd;\"/><path class=\"pele-divider\" d=\"M-32,10H32M-32,20H32\" fill=\"none\" stroke=\"var(--_b)\" style=\"stroke:#00f\"/><text class=\"pele-label\" font-weight=\"var(--_hw)\" style=\"fill:#900;\" text-anchor=\"middle\" xml:space=\"preserve\"><tspan x=\"0\" y=\"-4.4\">B</tspan></text></g><g class=\"pele-node pele-class cold\" data-id=\"C\" transform=\"translate(248,49.5)\"><rect x=\"-32\" y=\"-30\" width=\"64\" height=\"60\" fill=\"var(--_s)\" stroke=\"var(--_b)\" style=\"rx:var(--_r);stroke:#00f;fill:#ddf;\"/><path class=\"pele-divider\" d=\"M-32,10H32M-32,20H32\" fill=\"none\" stroke=\"var(--_b)\" style=\"stroke:#00f\"/><text class=\"pele-label\" font-weight=\"var(--_hw)\" text-anchor=\"middle\" xml:space=\"preserve\"><tspan x=\"0\" y=\"-4.4\">C</tspan></text></g><g class=\"pele-node pele-class cold\" data-id=\"D\" transform=\"translate(352,49.5)\"><rect x=\"-32\" y=\"-41.5\" width=\"64\" height=\"83\" fill=\"var(--_s)\" stroke=\"var(--_b)\" style=\"rx:var(--_r);stroke:#00f;fill:#ddf;\"/><path class=\"pele-divider\" d=\"M-32,-1.5H32M-32,31.5H32\" fill=\"none\" stroke=\"var(--_b)\" style=\"stroke:#00f\"/><text class=\"pele-label\" font-weight=\"var(--_hw)\" style=\"fill:#090;\" text-anchor=\"middle\" xml:space=\"preserve\"><tspan x=\"0\" y=\"-15.9\">D</tspan></text><g class=\"pele-members\" font-size=\"14\"><text class=\"pele-member pele-attribute pele-static\" style=\"fill:#090;text-decoration:underline\" x=\"-20\" y=\"19.9\">+x</text></g></g></g></svg>",
  )
