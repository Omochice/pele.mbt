///|
/// The SVG of the group that carries `data-id="id"`, through the end tag that closes it.
fn group_of(svg : String, id : String) -> String {
  let start = @util.index_of(svg, "data-id=\"\{id}\"")
  let from = @util.last_index_of(svg, "<g", from=start)
  let mut depth = 0
  let mut at = from
  while at < svg.length() {
    if @util.starts_with_at(svg, "</g>", at) {
      depth -= 1
      if depth == 0 {
        return @util.slice(svg, from, end=at + 4)
      }
    } else if @util.starts_with_at(svg, "<g ", at) ||
      @util.starts_with_at(svg, "<g>", at) {
      depth += 1
    }
    at += 1
  }
  @util.slice(svg, from)
}

///|
fn svg_of(source : String, monospace? : Array[String]) -> String {
  match drawn(source, monospace?) {
    Ok(result) => result.svg
    Err(failure) => abort(failure.message)
  }
}

///|
test "measures members in the monospace font when monospace lists them" {
  let width = (svg : String) => {
    let box = group_of(svg, "A")
    let at = @util.index_of(box, " width=\"") + 8
    @util.parse_float(
      @util.slice(box, at, end=@util.index_of(box, "\"", from=at)),
    )
  }
  let plain = svg_of("classDiagram\nclass A {\n  +title: string\n}")
  let mono = svg_of("classDiagram\nclass A {\n  +title: string\n}", monospace=[
    "members",
  ])
  inspect(
    mono.contains(
      "<g class=\"pele-members\" font-size=\"14\" font-family=\"var(--_fm)\">",
    ),
    content="true",
  )
  inspect(plain.contains("font-family=\"var(--_fm)\""), content="false")
  inspect(width(mono) > width(plain), content="true")
}

///|
test "ignores monospace values that do not list members" {
  let src = "classDiagram\nclass A {\n  +title: string\n  +draw()*\n}"
  let plain = svg_of(src)
  for monospace in [[], ["member"], ["attributes"]] {
    assert_eq(svg_of(src, monospace~), plain)
  }
  let configured = match
    drawn(src, config={
      "class": { "monoMembers": true, "monospace": ["members"] },
    }) {
    Ok(result) => result.svg
    Err(failure) => failure.message
  }
  assert_eq(configured, plain)
  assert_eq(
    svg_of(src, monospace=["attributes", "members"]),
    svg_of(src, monospace=["members"]),
  )
}

///|
test "keeps a class's own font-family on its members when monospace lists them" {
  let members = (svg : String) => {
    let box = group_of(svg, "A")
    let at = @util.index_of(box, "<g class=\"pele-members\"")
    @util.slice(box, at, end=@util.index_of(box, "</g>", from=at) + 4)
  }
  for
    rule in [
      "style A color:black,font-family:serif", "classDef serif color:black,font-family:serif\nclass A:::serif",
    ] {
    let src = "classDiagram\nclass A {\n  +title: string\n}\nclass B {\n  +title: string\n}\n\{rule}"
    let svg = svg_of(src, monospace=["members"])
    assert_eq(members(svg), members(svg_of(src)))
    inspect(
      group_of(svg, "B").contains("font-family=\"var(--_fm)\""),
      content="true",
    )
  }
}

///|
test "uses the label of a class in place of its name" {
  assert_eq(
    snapshot(
      drawn(
        "classDiagram\nclass A[\"A class with a label\"]\nclass `Animal Class!`\nA --> `Animal Class!`",
      ),
    ),
    "187 x 192 []\n<svg xmlns=\"http://www.w3.org/2000/svg\" class=\"pele pele-class\" viewBox=\"0 0 187 192\" width=\"187\" height=\"192\" style=\"max-width:100%;height:auto;--_bg:var(--pele-bg,#fff);--_fg:var(--pele-fg,#1f1f1f);--_m:var(--pele-muted,#6e6e6e);--_l:var(--pele-line,#1f1f1f);--_s:var(--pele-surface,#f3f3f3);--_a:var(--pele-surface-alt,#e6e6e6);--_b:var(--pele-border,#8a8a8a);--_c:var(--pele-accent,#5b7bd5);color:var(--_fg);--_r:var(--pele-radius,4px);--_hw:var(--pele-heading-weight,bold);--_fm:var(--pele-font-mono,monospace);font:16px sans-serif;letter-spacing:normal;word-spacing:normal;text-transform:none;direction:ltr;font-family:var(--pele-font,sans-serif)\" fill=\"var(--_fg)\" role=\"graphics-document document\" aria-roledescription=\"class\"><g class=\"pele-edges\" fill=\"none\" stroke=\"var(--_l)\" stroke-linecap=\"round\"><g class=\"pele-edge pele-relation\" data-id=\"id_A_Animal Class!_1\"><path d=\"M93.37,68L93.37,117\"/><path class=\"pele-marker\" d=\"M93.37,124L90.01,116L96.73,116Z\" fill=\"var(--_l)\" stroke=\"none\"/></g></g><g class=\"pele-nodes\"><g class=\"pele-node pele-class\" data-id=\"A\" transform=\"translate(93.37,38)\"><rect x=\"-85.37\" y=\"-30\" width=\"170.74\" height=\"60\" fill=\"var(--_s)\" stroke=\"var(--_b)\" style=\"rx:var(--_r)\"/><path class=\"pele-divider\" d=\"M-85.37,10H85.37M-85.37,20H85.37\" fill=\"none\" stroke=\"var(--_b)\"/><text class=\"pele-label\" font-weight=\"var(--_hw)\" text-anchor=\"middle\" xml:space=\"preserve\"><tspan x=\"0\" y=\"-4.4\">A class with a label</tspan></text></g><g class=\"pele-node pele-class\" data-id=\"Animal Class!\" transform=\"translate(93.37,154)\"><rect x=\"-64.9\" y=\"-30\" width=\"129.81\" height=\"60\" fill=\"var(--_s)\" stroke=\"var(--_b)\" style=\"rx:var(--_r)\"/><path class=\"pele-divider\" d=\"M-64.9,10H64.9M-64.9,20H64.9\" fill=\"none\" stroke=\"var(--_b)\"/><text class=\"pele-label\" font-weight=\"var(--_hw)\" text-anchor=\"middle\" xml:space=\"preserve\"><tspan x=\"0\" y=\"-4.4\">Animal Class!</tspan></text></g></g></svg>",
  )
}

