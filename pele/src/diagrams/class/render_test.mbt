///|
test "draws notes, and joins a note for a class to it with a dotted line" {
  assert_eq(
    snapshot(
      drawn(
        "classDiagram\nclass MyClass\nnote \"General<br>note\"\nnote for MyClass \"About **it**\"",
      ),
    ),
    "211 x 184 []\n<svg xmlns=\"http://www.w3.org/2000/svg\" class=\"pele pele-class\" viewBox=\"0 0 211 184\" width=\"211\" height=\"184\" style=\"max-width:100%;height:auto;--_bg:var(--pele-bg,#fff);--_fg:var(--pele-fg,#1f1f1f);--_m:var(--pele-muted,#6e6e6e);--_l:var(--pele-line,#1f1f1f);--_s:var(--pele-surface,#f3f3f3);--_a:var(--pele-surface-alt,#e6e6e6);--_b:var(--pele-border,#8a8a8a);--_c:var(--pele-accent,#5b7bd5);color:var(--_fg);--_r:var(--pele-radius,4px);--_hw:var(--pele-heading-weight,bold);--_w:var(--pele-bold-weight,bold);--_fm:var(--pele-font-mono,monospace);font:16px sans-serif;letter-spacing:normal;word-spacing:normal;text-transform:none;direction:ltr;font-family:var(--pele-font,sans-serif)\" fill=\"var(--_fg)\" role=\"graphics-document document\" aria-roledescription=\"class\"><g class=\"pele-edges\" fill=\"none\" stroke=\"var(--_l)\" stroke-linecap=\"round\"><g class=\"pele-edge pele-note-edge\" data-id=\"edgeNote1\"><path d=\"M158.31,52.5L158.31,116\" stroke-dasharray=\"2 4\"/></g></g><g class=\"pele-nodes\"><g class=\"pele-node pele-class\" data-id=\"MyClass\" transform=\"translate(158.31,146)\"><rect x=\"-44.46\" y=\"-30\" width=\"88.91\" height=\"60\" fill=\"var(--_s)\" stroke=\"var(--_b)\" style=\"rx:var(--_r)\"/><path class=\"pele-divider\" d=\"M-44.46,10H44.46M-44.46,20H44.46\" fill=\"none\" stroke=\"var(--_b)\"/><text class=\"pele-label\" font-weight=\"var(--_hw)\" text-anchor=\"middle\" xml:space=\"preserve\"><tspan x=\"0\" y=\"-4.4\">MyClass</tspan></text></g><g class=\"pele-node pele-note\" data-id=\"note0\" transform=\"translate(44.9,34)\"><path d=\"M-36.9,-26H28.9L36.9,-18V26H-36.9Z\" fill=\"var(--_a)\" stroke=\"var(--_b)\" stroke-linejoin=\"round\"/><path d=\"M28.9,-26V-18H36.9\" fill=\"none\" stroke=\"var(--_b)\" stroke-linejoin=\"round\"/><text class=\"pele-label\" font-size=\"14\" text-anchor=\"middle\" xml:space=\"preserve\"><tspan x=\"0\" y=\"-4.1\">General</tspan><tspan x=\"0\" y=\"13.9\">note</tspan></text></g><g class=\"pele-node pele-note\" data-id=\"note1\" transform=\"translate(158.31,34)\"><path d=\"M-36.51,-18.5H28.51L36.51,-10.5V18.5H-36.51Z\" fill=\"var(--_a)\" stroke=\"var(--_b)\" stroke-linejoin=\"round\"/><path d=\"M28.51,-18.5V-10.5H36.51\" fill=\"none\" stroke=\"var(--_b)\" stroke-linejoin=\"round\"/><text class=\"pele-label\" font-size=\"14\" text-anchor=\"middle\" xml:space=\"preserve\"><tspan x=\"0\" y=\"4.9\">About </tspan><tspan font-weight=\"var(--_w)\">it</tspan></text></g></g></svg>",
  )
  assert_eq(
