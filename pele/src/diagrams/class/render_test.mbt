// Ported from pele v1.8.0, tests/render/class.test.ts; the snapshots were taken from pele's render.

///|
fn drawn(
  source : String,
  max_width? : Double,
  config? : Map[String, Json],
  auto_direction? : Bool,
  monospace? : Array[String],
) -> Result[@types.RenderResult, @errors.Failure] {
  let options = {
    ..@types.RenderOptions::default(),
    max_width,
    config,
    auto_direction,
    monospace,
  }
  Ok(@core.render([@class.class], source, options)) catch {
    @errors.PeleError(failure) => Err(failure)
  }
}

///|
fn snapshot(result : Result[@types.RenderResult, @errors.Failure]) -> String {
  match result {
    Ok(r) => {
      let links = r.links.map(link => "\{link.id} \{link.href} \{link.internal}")
      "\{r.width} x \{r.height} [\{links.join(", ")}]\n\{r.svg}"
    }
    Err(failure) => "error: " + failure.message
  }
}

///|
test "is drawn for both keywords, with the front matter title" {
  assert_eq(
    snapshot(drawn("classDiagram\n  Animal <|-- Duck")),
    "94 x 192 []\n<svg xmlns=\"http://www.w3.org/2000/svg\" class=\"pele pele-class\" viewBox=\"0 0 94 192\" width=\"94\" height=\"192\" style=\"max-width:100%;height:auto;--_bg:var(--pele-bg,#fff);--_fg:var(--pele-fg,#1f1f1f);--_m:var(--pele-muted,#6e6e6e);--_l:var(--pele-line,#1f1f1f);--_s:var(--pele-surface,#f3f3f3);--_a:var(--pele-surface-alt,#e6e6e6);--_b:var(--pele-border,#8a8a8a);--_c:var(--pele-accent,#5b7bd5);color:var(--_fg);--_r:var(--pele-radius,4px);--_hw:var(--pele-heading-weight,bold);--_fm:var(--pele-font-mono,monospace);font:16px sans-serif;letter-spacing:normal;word-spacing:normal;text-transform:none;direction:ltr;font-family:var(--pele-font,sans-serif)\" fill=\"var(--_fg)\" role=\"graphics-document document\" aria-roledescription=\"class\"><g class=\"pele-edges\" fill=\"none\" stroke=\"var(--_l)\" stroke-linecap=\"round\"><g class=\"pele-edge pele-relation\" data-id=\"id_Animal_Duck_1\"><path d=\"M46.67,80L46.67,124\"/><path class=\"pele-marker\" d=\"M46.67,68L52.67,80L40.67,80Z\" stroke-linejoin=\"round\"/></g></g><g class=\"pele-nodes\"><g class=\"pele-node pele-class\" data-id=\"Animal\" transform=\"translate(46.67,38)\"><rect x=\"-38.67\" y=\"-30\" width=\"77.34\" height=\"60\" fill=\"var(--_s)\" stroke=\"var(--_b)\" style=\"rx:var(--_r)\"/><path class=\"pele-divider\" d=\"M-38.67,10H38.67M-38.67,20H38.67\" fill=\"none\" stroke=\"var(--_b)\"/><text class=\"pele-label\" font-weight=\"var(--_hw)\" text-anchor=\"middle\" xml:space=\"preserve\"><tspan x=\"0\" y=\"-4.4\">Animal</tspan></text></g><g class=\"pele-node pele-class\" data-id=\"Duck\" transform=\"translate(46.67,154)\"><rect x=\"-32\" y=\"-30\" width=\"64\" height=\"60\" fill=\"var(--_s)\" stroke=\"var(--_b)\" style=\"rx:var(--_r)\"/><path class=\"pele-divider\" d=\"M-32,10H32M-32,20H32\" fill=\"none\" stroke=\"var(--_b)\"/><text class=\"pele-label\" font-weight=\"var(--_hw)\" text-anchor=\"middle\" xml:space=\"preserve\"><tspan x=\"0\" y=\"-4.4\">Duck</tspan></text></g></g></svg>",
  )
  assert_eq(
    snapshot(drawn("classDiagram-v2\n  Animal <|-- Duck")),
    "94 x 192 []\n<svg xmlns=\"http://www.w3.org/2000/svg\" class=\"pele pele-class\" viewBox=\"0 0 94 192\" width=\"94\" height=\"192\" style=\"max-width:100%;height:auto;--_bg:var(--pele-bg,#fff);--_fg:var(--pele-fg,#1f1f1f);--_m:var(--pele-muted,#6e6e6e);--_l:var(--pele-line,#1f1f1f);--_s:var(--pele-surface,#f3f3f3);--_a:var(--pele-surface-alt,#e6e6e6);--_b:var(--pele-border,#8a8a8a);--_c:var(--pele-accent,#5b7bd5);color:var(--_fg);--_r:var(--pele-radius,4px);--_hw:var(--pele-heading-weight,bold);--_fm:var(--pele-font-mono,monospace);font:16px sans-serif;letter-spacing:normal;word-spacing:normal;text-transform:none;direction:ltr;font-family:var(--pele-font,sans-serif)\" fill=\"var(--_fg)\" role=\"graphics-document document\" aria-roledescription=\"class\"><g class=\"pele-edges\" fill=\"none\" stroke=\"var(--_l)\" stroke-linecap=\"round\"><g class=\"pele-edge pele-relation\" data-id=\"id_Animal_Duck_1\"><path d=\"M46.67,80L46.67,124\"/><path class=\"pele-marker\" d=\"M46.67,68L52.67,80L40.67,80Z\" stroke-linejoin=\"round\"/></g></g><g class=\"pele-nodes\"><g class=\"pele-node pele-class\" data-id=\"Animal\" transform=\"translate(46.67,38)\"><rect x=\"-38.67\" y=\"-30\" width=\"77.34\" height=\"60\" fill=\"var(--_s)\" stroke=\"var(--_b)\" style=\"rx:var(--_r)\"/><path class=\"pele-divider\" d=\"M-38.67,10H38.67M-38.67,20H38.67\" fill=\"none\" stroke=\"var(--_b)\"/><text class=\"pele-label\" font-weight=\"var(--_hw)\" text-anchor=\"middle\" xml:space=\"preserve\"><tspan x=\"0\" y=\"-4.4\">Animal</tspan></text></g><g class=\"pele-node pele-class\" data-id=\"Duck\" transform=\"translate(46.67,154)\"><rect x=\"-32\" y=\"-30\" width=\"64\" height=\"60\" fill=\"var(--_s)\" stroke=\"var(--_b)\" style=\"rx:var(--_r)\"/><path class=\"pele-divider\" d=\"M-32,10H32M-32,20H32\" fill=\"none\" stroke=\"var(--_b)\"/><text class=\"pele-label\" font-weight=\"var(--_hw)\" text-anchor=\"middle\" xml:space=\"preserve\"><tspan x=\"0\" y=\"-4.4\">Duck</tspan></text></g></g></svg>",
