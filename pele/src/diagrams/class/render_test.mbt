///|
test "turns a diagram that runs across to run down in a narrow width" {
  assert_eq(
    snapshot(
      drawn(
        "classDiagram\ndirection LR\nA --> B\nB --> C\nC --> D\nD --> E",
        max_width=400,
      ),
    ),
    "80 x 540 []\n<svg xmlns=\"http://www.w3.org/2000/svg\" class=\"pele pele-class\" viewBox=\"0 0 80 540\" width=\"80\" height=\"540\" style=\"max-width:100%;height:auto;--_bg:var(--pele-bg,#fff);--_fg:var(--pele-fg,#1f1f1f);--_m:var(--pele-muted,#6e6e6e);--_l:var(--pele-line,#1f1f1f);--_s:var(--pele-surface,#f3f3f3);--_a:var(--pele-surface-alt,#e6e6e6);--_b:var(--pele-border,#8a8a8a);--_c:var(--pele-accent,#5b7bd5);color:var(--_fg);--_r:var(--pele-radius,4px);--_hw:var(--pele-heading-weight,bold);--_fm:var(--pele-font-mono,monospace);font:16px sans-serif;letter-spacing:normal;word-spacing:normal;text-transform:none;direction:ltr;font-family:var(--pele-font,sans-serif)\" fill=\"var(--_fg)\" role=\"graphics-document document\" aria-roledescription=\"class\"><g class=\"pele-edges\" fill=\"none\" stroke=\"var(--_l)\" stroke-linecap=\"round\"><g class=\"pele-edge pele-relation\" data-id=\"id_A_B_1\"><path d=\"M40,68L40,117\"/><path class=\"pele-marker\" d=\"M40,124L36.64,116L43.36,116Z\" fill=\"var(--_l)\" stroke=\"none\"/></g><g class=\"pele-edge pele-relation\" data-id=\"id_B_C_2\"><path d=\"M40,184L40,233\"/><path class=\"pele-marker\" d=\"M40,240L36.64,232L43.36,232Z\" fill=\"var(--_l)\" stroke=\"none\"/></g><g class=\"pele-edge pele-relation\" data-id=\"id_C_D_3\"><path d=\"M40,300L40,349\"/><path class=\"pele-marker\" d=\"M40,356L36.64,348L43.36,348Z\" fill=\"var(--_l)\" stroke=\"none\"/></g><g class=\"pele-edge pele-relation\" data-id=\"id_D_E_4\"><path d=\"M40,416L40,465\"/><path class=\"pele-marker\" d=\"M40,472L36.64,464L43.36,464Z\" fill=\"var(--_l)\" stroke=\"none\"/></g></g><g class=\"pele-nodes\"><g class=\"pele-node pele-class\" data-id=\"A\" transform=\"translate(40,38)\"><rect x=\"-32\" y=\"-30\" width=\"64\" height=\"60\" fill=\"var(--_s)\" stroke=\"var(--_b)\" style=\"rx:var(--_r)\"/><path class=\"pele-divider\" d=\"M-32,10H32M-32,20H32\" fill=\"none\" stroke=\"var(--_b)\"/><text class=\"pele-label\" font-weight=\"var(--_hw)\" text-anchor=\"middle\"