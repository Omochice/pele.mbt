///|
test "themes through custom properties, with no style element" {
  assert_eq(
    snapshot(
      drawn("classDiagram\nclass A {\n +x\n}\nA --> B : uses\nnote for A \"n\""),
    ),
    "80 x 333 []\n<svg xmlns=\"http://www.w3.org/2000/svg\" class=\"pele pele-class\" viewBox=\"0 0 80 333\" width=\"80\" height=\"333\" style=\"max-width:100%;height:auto;--_bg:var(--pele-bg,#fff);--_fg:var(--pele-fg,#1f1f1f);--_m:var(--pele-muted,#6e6e6e);--_l:var(--pele-line,#1f1f1f);--_s:var(--pele-surface,#f3f3f3);--_a:var(--pele-surface-alt,#e6e6e6);--_b:var(--pele-border,#8a8a8a);--_c:var(--pele-accent,#5b7bd5);color:var(--_fg);--_r:var(--pele-radius,4px);--_hw:var(--pele-heading-weight,bold);--_fm:var(--pele-font-mono,monospace);font:16px sans-serif;letter-spacing:normal;word-spacing:normal;text-transform:none;direction:ltr;font-family:var(--pele-font,sans-serif)\" fill=\"var(--_fg)\" role=\"graphics-document document\" aria-roledescription=\"class\"><g class=\"pele-edges\" fill=\"none\" stroke=\"var(--_l)\" stroke-linecap=\"round\"><g class=\"pele-edge pele-note-edge\" data-id=\"edgeNote0\"><path d=\"M40,45L40,101\" stroke-dasharray=\"2 4\"/></g><g class=\"pele-edge pele-relation\" data-id=\"id_A_B_1\"><path d=\"M40,184L40,258\"/><path class=\"pele-marker\" d=\"M40,265L36.64,257L43.36,257Z\" fill=\"var(--_l)\" stroke=\"none\"/></g></g><g class=\"pele-edge-labels\" font-size=\"14\"><g class=\"pele-edge-label\" data-id=\"id_A_B_1\"><rect x=\"21.22\" y=\"214\" width=\"37.57\" height=\"21\" rx=\"3\" fill=\"var(--_bg)\"/><text x=\"40\" y=\"229.4\" text-anchor=\"middle\">uses</text></g></g><g class=\"pele-nodes\"><g class=\"pele-node pele-class\" data-id=\"A\" transform=\"translate(40,142.5)\"><rect x=\"-32\" y=\"-41.5\" width=\"64\" height=\"83\" fill=\"var(--_s)\" stroke=\"var(--_b)\" style=\"rx:var(--_r)\"/><path class=\"pele-divider\" d=\"M-32,-1.5H32M-32,31.5H32\" fill=\"none\" stroke=\"var(--_b)\"/><text class=\"pele-label\" font-weight=\"var(--_hw)\" text-anchor=\"middle\" xml:space=\"preserve\"><tspan x=\"0\" y=\"-15.9\">A</tspan></text><g class=\"pele-members\" font-size=\"14\"><text class=\"pele-member pele-attribute\" x=\"-20\" y=\"19.9\">+x</text></g></g><g class=\"pele-node pele-class\" data-id=\"B\" transform=\"translate(40,295)\"><rect x=\"-32\" y=\"-30\" width=\"64\" height=\"60\" fill=\"var(--_s)\" stroke=\"var(--_b)\" style=\"rx:var(--_r)\"/><path class=\"pele-divider\" d=\"M-32,10H32M-32,20H32\" fill=\"none\" stroke=\"var(--_b)\"/><text class=\"pele-label\" font-weight=\"var(--_hw)\" text-anchor=\"middle\" xml:space=\"preserve\"><tspan x=\"0\" y=\"-4.4\">B</tspan></text></g><g class=\"pele-node pele-note\" data-id=\"note0\" transform=\"translate(40,26.5)\"><path d=\"M-20,-18.5H12L20,-10.5V18.5H-20Z\" fill=\"var(--_a)\" stroke=\"var(--_b)\" stroke-linejoin=\"round\"/><path d=\"M12,-18.5V-10.5H20\" fill=\"none\" stroke=\"var(--_b)\" stroke-linejoin=\"round\"/><text class=\"pele-label\" font-size=\"14\" x=\"0\" y=\"4.9\" text-anchor=\"middle\">n</text></g></g></svg>",
  )
}

