///|
test "draws a class as a box with a title, attributes and methods" {
  assert_eq(
    snapshot(
      drawn(
        "classDiagram\nclass Duck {\n  +String beakColor\n  -int age\n  +swim()\n  +quack() bool\n}",
      ),
    ),
