///|
test "makes a namespace of each part of a dotted name, or one flat namespace in compact mode" {
  assert_eq(
    snapshot(
      drawn("classDiagram\nnamespace Company.Engineering {\n  class Dev\n}"),
    ),
    "170 x 196 []\n<svg xmlns=\"http://www.w3.org/2000/svg\" class=\"pele pele-class\" viewBox=\"0 0 170 196\" width=\"170\" height=\"196\" style=\"max-width:100%;height:auto;--_bg:var(--pele-bg,#fff);--_fg:var(--pele-fg,#1f1f1f);--_m:var(--pele-muted,#6e6e6e);--_l:var(--pele-line,#1f1f1f);--_s:var(--pele-surface,#f3f3f3);--_a:var(--pele-surface-alt,#e6e6e6);--_b:var(--pele-border,#8a8a8a);--_c:var(--pele-accent,#5b7bd5);color:var(--_fg);--_r:var(--pele-radius,4px);--_hw:var(--pele-heading-weight,bold);--_fm:var(--pele-font-mono,monospace);font:16px sans-serif;letter-spacing:normal;word-spacing:normal;text-transform:none;direction:ltr;font-family:var(--pele-font,sans-serif)\" fill=\"var(--_fg)\" role=\"graphics-document document\" aria-roledescription=\"class\"><g class=\"pele-clusters\"><g class=\"pele-cluster pele-namespace\" data-id=\"Company\"><rect x=\"8\" y=\"8\" width=\"153.38\" height=\"180\" fill=\"var(--_a)\" fill-opacity=\"0.5\" stroke=\"var(--_b)\" style=\"rx:var(--_r)\"/><text class=\"pele-cluster-label\" fill=\"var(--_m)\" x=\"56.23\" y=\"33.6\" text-anchor=\"middle\">Company</text></g><g class=\"pele-cluster pele-namespace\" data-id=\"Company.Engineering\"><rect x=\"28\" y=\"48\" width=\"113.38\" height=\"120\" fill=\"var(--_a)\" fill-opacity=\"0.5\" stroke=\"var(--_b)\" style=\"rx:var(--_r)\"/><text class=\"pele-cluster-label\" fill=\"var(--_m)\" x=\"84.69\" y=\"73.6\" text-anchor=\"middle\">Engineering</text></g></g><g class=\"pele-nodes\"><g class=\"pele-node pele-class\" data-id=\"Dev\" transform=\"translate(84.69,118)\"><rect x=\"-32\" y=\"-30\" width=\"64\" height=\"60\" fill=\"var(--_s)\" stroke=\"var(--_b)\" style=\"rx:var(--_r)\"/><path class=\"pele-divider\" d=\"M-32,10H32M-32,20H32\" fill=\"none\" stroke=\"var(--_b)\"/><text class=\"pele-label\" font-weight=\"var(--_hw)\" text-anchor=\"middle\" xml:space=\"preserve\"><tspan x=\"0\" y=\"-4.4\">Dev</tspan></text></g></g></svg>",
  )
  assert_eq(
    snapshot(
      drawn("classDiagram\nnamespace Company.Engineering {\n  class Dev\n}", config={
        "class": { "hierarchicalNamespaces": false },
      }),
    ),
    "203 x 136 []\n<svg xmlns=\"http://www.w3.org/2000/svg\" class=\"pele pele-class\" viewBox=\"0 0 203 136\" width=\"203\" height=\"136\" style=\"max-width:100%;height:auto;--_bg:var(--pele-bg,#fff);--_fg:var(--pele-fg,#1f1f1f);--_m:var(--pele-muted,#6e6e6e);--_l:var(--pele-line,#1f1f1f);--_s:var(--pele-surface,#f3f3f3);--_a:var(--pele-surface-alt,#e6e6e6);--_b:var(--pele-border,#8a8a8a);--_c:var(--pele-accent,#5b7bd5);color:var(--_fg);--_r:var(--pele-radius,4px);--_hw:var(--pele-heading-weight,bold);--_fm:var(--pele-font-mono,monospace);font:16px sans-serif;letter-spacing:normal;word-spacing:normal;text-transform:none;direction:ltr;font-family:var(--pele-font,sans-serif)\" fill=\"var(--_fg)\" role=\"graphics-document document\" aria-roledescription=\"class\"><g class=\"pele-clusters\"><g class=\"pele-cluster pele-namespace\" data-id=\"Company.Engineering\"><rect x=\"8\" y=\"8\" width=\"186.29\" height=\"120\" fill=\"var(--_a)\" fill-opacity=\"0.5\" stroke=\"var(--_b)\" style=\"rx:var(--_r)\"/><text class=\"pele-cluster-label\" fill=\"var(--_m)\" x=\"101.14\" y=\"33.6\" text-anchor=\"middle\">Company.Engineering</text></g></g><g class=\"pele-nodes\"><g class=\"pele-node pele-class\" data-id=\"Dev\" transform=\"translate(101.14,78)\"><rect x=\"-32\" y=\"-30\" width=\"64\" height=\"60\" fill=\"var(--_s)\" stroke=\"var(--_b)\" style=\"rx:var(--_r)\"/><path class=\"pele-divider\" d=\"M-32,10H32M-32,20H32\" fill=\"none\" stroke=\"var(--_b)\"/><text class=\"pele-label\" font-weight=\"var(--_hw)\" text-anchor=\"middle\" xml:space=\"preserve\"><tspan x=\"0\" y=\"-4.4\">Dev</tspan></text></g></g></svg>",
