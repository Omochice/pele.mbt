///|
test "distinguishes done, active, and critical tasks" {
  inspect(
    svg(
      "gantt\n dateFormat YYYY-MM-DD\n P :p, 2024-01-01, 9d\n A :active, a, 2024-01-01, 9d\n D :done, d, 2024-01-01, 9d\n C :crit, c, 2024-01-01, 9d\n CD :crit, done, cd, 2024-01-01, 9d\n CA :crit, active, ca, 2024-01-01, 9d",
      now=1389873600000,
    ),
    content="800x217 [] <svg xmlns=\"http://www.w3.org/2000/svg\" class=\"pele pele-gantt\" viewBox=\"0 0 800 217\" width=\"800\" height=\"217\" style=\"max-width:100%;height:auto;--_bg:var(--pele-bg,#fff);--_fg:var(--pele-fg,#1f1f1f);--_m:var(--pele-muted,#6e6e6e);--_l:var(--pele-line,#1f1f1f);--_s:var(--pele-surface,#f3f3f3);--_a:var(--pele-surface-alt,#e6e6e6);--_b:var(--pele-border,#8a8a8a);--_c:var(--pele-accent,#5b7bd5);color:var(--_fg);--_r:var(--pele-radius,4px);--_fm:var(--pele-font-mono,monospace);font:16px sans-serif;letter-spacing:normal;word-spacing:normal;text-transform:none;direction:ltr;font-family:var(--pele-font,sans-serif)\" fill=\"var(--_fg)\" role=\"graphics-document document\" aria-roledescription=\"gantt\"><g class=\"pele-grid\" fill=\"none\"><path d=\"M38.68,8V188M118.98,8V188M199.27,8V188M279.56,8V188M359.85,8V188M440.15,8V188M520.44,8V188M600.73,8V188M681.02,8V188M761.32,8V188\" stroke=\"var(--_b)\" stroke-dasharray=\"1 3\"/><path d=\"M38.68,188H761.32\" stroke=\"var(--_b)\"/></g><g class=\"pele-tasks\" font-size=\"13\"><g class=\"pele-task\" data-id=\"p\"><rect x=\"38.68\" y=\"11\" width=\"722.63\" height=\"24\" fill=\"var(--_c)\" stroke=\"var(--_c)\" style=\"rx:var(--_r)\"/><text class=\"pele-label\" fill=\"var(--_bg)\" x=\"400\" y=\"27.55\" text-anchor=\"middle\">P</text></g><g class=\"pele-task pele-active\" data-id=\"a\"><rect x=\"38.68\" y=\"41\" width=\"722.63\" height=\"24\" fill=\"var(--_c)\" fill-opacity=\"0.25\" stroke=\"var(--_c)\" style=\"rx:var(--_r)\"/><text class=\"pele-label\" x=\"400\" y=\"57.55\" text-anchor=\"middle\">A</text></g><g class=\"pele-task pele-done\" data-id=\"d\"><rect x=\"38.68\" y=\"71\" width=\"722.63\" height=\"24\" fill=\"var(--_a)\" stroke=\"var(--_b)\" style=\"rx:var(--_r)\"/><text class=\"pele-label\" x=\"400\" y=\"87.55\" text-anchor=\"middle\">D</text></g><g class=\"pele-task pele-crit\" data-id=\"c\"><rect x=\"38.68\" y=\"101\" width=\"722.63\" height=\"24\" fill=\"var(--pele-critical,#e45756)\" stroke=\"var(--pele-critical,#e45756)\" style=\"rx:var(--_r)\"/><text class=\"pele-label\" fill=\"var(--_bg)\" x=\"400\" y=\"117.55\" text-anchor=\"middle\">C</text></g><g class=\"pele-task pele-done pele-crit\" data-id=\"cd\"><rect x=\"38.68\" y=\"131\" width=\"722.63\" height=\"24\" fill=\"var(--_a)\" stroke=\"var(--pele-critical,#e45756)\" style=\"rx:var(--_r)\"/><text class=\"pele-label\" x=\"400\" y=\"147.55\" text-anchor=\"middle\">CD</text></g><g class=\"pele-task pele-active pele-crit\" data-id=\"ca\"><rect x=\"38.68\" y=\"161\" width=\"722.63\" height=\"24\" fill=\"var(--pele-critical,#e45756)\" fill-opacity=\"0.25\" stroke=\"var(--pele-critical,#e45756)\" style=\"rx:var(--_r)\"/><text class=\"pele-label\" x=\"400\" y=\"177.55\" text-anchor=\"middle\">CA</text></g></g><g class=\"pele-section-labels\" font-size=\"13\"></g><g class=\"pele-axis\" font-size=\"12\" fill=\"var(--_m)\"><text x=\"38.68\" y=\"204.7\" text-anchor=\"middle\">2024-01-01</text><text x=\"118.98\" y=\"204.7\" text-anchor=\"middle\">2024-01-02</text><text x=\"199.27\" y=\"204.7\" text-anchor=\"middle\">2024-01-03</text><text x=\"279.56\" y=\"204.7\" text-anchor=\"middle\">2024-01-04</text><text x=\"359.85\" y=\"204.7\" text-anchor=\"middle\">2024-01-05</text><text x=\"440.15\" y=\"204.7\" text-anchor=\"middle\">2024-01-06</text><text x=\"520.44\" y=\"204.7\" text-anchor=\"middle\">2024-01-07</text><text x=\"600.73\" y=\"204.7\" text-anchor=\"middle\">2024-01-08</text><text x=\"681.02\" y=\"204.7\" text-anchor=\"middle\">2024-01-09</text><text x=\"761.32\" y=\"204.7\" text-anchor=\"middle\">2024-01-10</text></g></svg>",
