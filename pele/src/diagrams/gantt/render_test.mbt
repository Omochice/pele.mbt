// Ported from pele's tests/render/gantt.test.ts as snapshots of pele's output, taken with local time
// fixed to UTC under the default options.

///|
fn svg(source : String, now~ : Double, max_width? : Double) -> String {
  let options = {
    ..@types.RenderOptions::default(),
    now: Some(now),
    max_width,
  }
  let result = @core.render([@gantt.gantt], source, options) catch {
    @errors.PeleError(failure) =>
      return "error: \{failure.code.to_string()}: \{failure.message}"
  }
  let links = result.links.map(link => "\"\{link.id}=\{link.href}\"")
  "\{result.width}x\{result.height} [\{links.join(",")}] \{result.svg}"
}

///|
test "draws bars, section bands and labels, an axis, a title and today" {
  inspect(
    svg(
      "gantt\n  title A Gantt Diagram\n  dateFormat YYYY-MM-DD\n  section Section\n  A task :a1, 2014-01-01, 30d\n  Another task :after a1, 20d\n  section Another\n  Task in Another :2014-01-12, 12d\n  another task :24d",
      now=1389873600000,
    ),
    content="800x197 [] <svg xmlns=\"http://www.w3.org/2000/svg\" class=\"pele pele-gantt\" viewBox=\"0 0 800 197\" width=\"800\" height=\"197\" style=\"max-width:100%;height:auto;--_bg:var(--pele-bg,#fff);--_fg:var(--pele-fg,#1f1f1f);--_m:var(--pele-muted,#6e6e6e);--_l:var(--pele-line,#1f1f1f);--_s:var(--pele-surface,#f3f3f3);--_a:var(--pele-surface-alt,#e6e6e6);--_b:var(--pele-border,#8a8a8a);--_c:var(--pele-accent,#5b7bd5);color:var(--_fg);--_r:var(--pele-radius,4px);--_tw:var(--pele-title-weight,bold);--_fm:var(--pele-font-mono,monospace);font:16px sans-serif;letter-spacing:normal;word-spacing:normal;text-transform:none;direction:ltr;font-family:var(--pele-font,sans-serif)\" fill=\"var(--_fg)\" role=\"graphics-document document\" aria-roledescription=\"gantt\"><text class=\"pele-title\" font-weight=\"var(--_tw)\" text-anchor=\"middle\" xml:space=\"preserve\"><tspan x=\"400\" y=\"25.6\">A Gantt Diagram</tspan></text><g class=\"pele-sections\"><rect class=\"pele-section pele-section-0\" x=\"0\" y=\"48\" width=\"800\" height=\"60\" fill=\"var(--_s)\"/><rect class=\"pele-section pele-section-1\" x=\"0\" y=\"108\" width=\"800\" height=\"60\" fill=\"none\"/></g><g class=\"pele-grid\" fill=\"none\"><path d=\"M132.23,48V168M227.96,48V168M323.69,48V168M419.42,48V168M515.15,48V168M610.88,48V168M706.61,48V168\" stroke=\"var(--_b)\" stroke-dasharray=\"1 3\"/><path d=\"M77.53,168H761.32\" stroke=\"var(--_b)\"/></g><g class=\"pele-today\"><path d=\"M289.5,48V168\" fill=\"none\" stroke=\"var(--_c)\" stroke-width=\"2\"/><path d=\"M285.5,43H293.5L289.5,49Z\" fill=\"var(--_c)\"/></g><g class=\"pele-tasks\" font-size=\"13\"><g class=\"pele-task\" data-id=\"a1\"><rect x=\"77.53\" y=\"51\" width=\"410.27\" height=\"24\" fill=\"var(--_c)\" stroke=\"var(--_c)\" style=\"rx:var(--_r)\"/><text class=\"pele-label\" fill=\"var(--_bg)\" x=\"282.66\" y=\"67.55\" text-anchor=\"middle\">A task</text></g><g class=\"pele-task\" data-id=\"task1\"><rect x=\"487.8\" y=\"81\" width=\"273.52\" height=\"24\" fill=\"var(--_c)\" stroke=\"var(--_c)\" style=\"rx:var(--_r)\"/><text class=\"pele-label\" fill=\"var(--_bg)\" x=\"624.56\" y=\"97.55\" text-anchor=\"middle\">Another task</text></g><g class=\"pele-task\" data-id=\"task2\"><rect x=\"227.96\" y=\"111\" width=\"164.11\" height=\"24\" fill=\"var(--_c)\" stroke=\"var(--_c)\" style=\"rx:var(--_r)\"/><text class=\"pele-label\" fill=\"var(--_bg)\" x=\"310.01\" y=\"127.55\" text-anchor=\"middle\">Task in Another</text></g><g class=\"pele-task\" data-id=\"task3\"><rect x=\"392.07\" y=\"141\" width=\"328.22\" height=\"24\" fill=\"var(--_c)\" stroke=\"var(--_c)\" style=\"rx:var(--_r)\"/><text class=\"pele-label\" fill=\"var(--_bg)\" x=\"556.18\" y=\"157.55\" text-anchor=\"middle\">another task</text></g></g><g class=\"pele-section-labels\" font-size=\"13\"><text class=\"pele-section-label\" data-id=\"Section\" x=\"37.68\" y=\"82.55\" text-anchor=\"middle\">Section</text><text class=\"pele-section-label\" data-id=\"Another\" x=\"38.76\" y=\"142.55\" text-anchor=\"middle\">Another</text></g><g class=\"pele-axis\" font-size=\"12\" fill=\"var(--_m)\"><text x=\"132.23\" y=\"184.7\" text-anchor=\"middle\">2014-01-05</text><text x=\"227.96\" y=\"184.7\" text-anchor=\"middle\">2014-01-12</text><text x=\"323.69\" y=\"184.7\" text-anchor=\"middle\">2014-01-19</text><text x=\"419.42\" y=\"184.7\" text-anchor=\"middle\">2014-01-26</text><text x=\"515.15\" y=\"184.7\" text-anchor=\"middle\">2014-02-02</text><text x=\"610.88\" y=\"184.7\" text-anchor=\"middle\">2014-02-09</text><text x=\"706.61\" y=\"184.7\" text-anchor=\"middle\">2014-02-16</text></g></svg>",
  )
}

