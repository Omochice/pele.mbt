///|
test "accessible names are written into the document" {
  inspect(
    svg(
      "journey\n  accTitle: Short name\n  accDescr {\n    A longer\n    description\n  }\n  a: 3\n",
    ),
    content="184x195 <svg xmlns=\"http://www.w3.org/2000/svg\" class=\"pele pele-journey\" viewBox=\"0 0 184 195\" width=\"184\" height=\"195\" style=\"max-width:100%;height:auto;--_bg:var(--pele-bg,#fff);--_fg:var(--pele-fg,#1f1f1f);--_m:var(--pele-muted,#6e6e6e);--_l:var(--pele-line,#1f1f1f);--_s:var(--pele-surface,#f3f3f3);--_a:var(--pele-surface-alt,#e6e6e6);--_b:var(--pele-border,#8a8a8a);--_c:var(--pele-accent,#5b7bd5);color:var(--_fg);--_r:var(--pele-radius,4px);--_fm:var(--pele-font-mono,monospace);font:16px sans-serif;letter-spacing:normal;word-spacing:normal;text-transform:none;direction:ltr;font-family:var(--pele-font,sans-serif)\" fill=\"var(--_fg)\" role=\"graphics-document document\" aria-roledescription=\"journey\" aria-labelledby=\"pele-title\" aria-describedby=\"pele-desc\"><title id=\"pele-title\">Short name</title><desc id=\"pele-desc\">A longer\ndescription</desc><path class=\"pele-grid\" d=\"M26,72H176M26,98H176M26,124H176M26,150H176M26,176H176\" fill=\"none\" stroke=\"var(--_a)\"/><g class=\"pele-scale\" font-size=\"12\" text-anchor=\"end\" fill=\"var(--_m)\"><text x=\"20\" y=\"76.2\">5</text><text x=\"20\" y=\"102.2\">4</text><text x=\"20\" y=\"128.2\">3</text><text x=\"20\" y=\"154.2\">2</text><text x=\"20\" y=\"180.2\">1</text></g><path class=\"pele-stems\" d=\"M104,45V113\" fill=\"none\" stroke=\"var(--_b)\" stroke-dasharray=\"2 3\"/><g class=\"pele-face pele-face-neutral\" transform=\"translate(104,124)\"><circle r=\"11\" fill=\"var(--_bg)\" stroke=\"var(--_l)\"/><g fill=\"var(--_l)\"><circle cx=\"-3.6\" cy=\"-2.8\" r=\"1.3\"/><circle cx=\"3.6\" cy=\"-2.8\" r=\"1.3\"/></g><path d=\"M-4.5,4.5H4.5\" fill=\"none\" stroke=\"var(--_l)\" stroke-linecap=\"round\"/></g><g class=\"pele-node pele-task\" data-id=\"a\"><rect x=\"32\" y=\"8\" width=\"144\" height=\"37\" fill=\"var(--_s)\" stroke=\"var(--_b)\" style=\"rx:var(--_r)\"/><text font-size=\"14\" x=\"104\" y=\"31.4\" text-anchor=\"middle\">a</text></g></svg>",
  )
}

///|
test "tags are shown as written and a line break is honored" {
  inspect(
    svg(
      "journey\n  title fa:fa-check <u>T</u>\n  <b>bold</b> a<T><br>two: 3: <i>Me</i>\n",
    ),
    content=(
      #|184x303 <svg xmlns="http://www.w3.org/2000/svg" class="pele pele-journey" viewBox="0 0 184 303" width="184" height="303" style="max-width:100%;height:auto;--_bg:var(--pele-bg,#fff);--_fg:var(--pele-fg,#1f1f1f);--_m:var(--pele-muted,#6e6e6e);--_l:var(--pele-line,#1f1f1f);--_s:var(--pele-surface,#f3f3f3);--_a:var(--pele-surface-alt,#e6e6e6);--_b:var(--pele-border,#8a8a8a);--_c:var(--pele-accent,#5b7bd5);color:var(--_fg);--_r:var(--pele-radius,4px);--_tw:var(--pele-title-weight,bold);--_fm:var(--pele-font-mono,monospace);font:16px sans-serif;letter-spacing:normal;word-spacing:normal;text-transform:none;direction:ltr;font-family:var(--pele-font,sans-serif)" fill="var(--_fg)" role="graphics-document document" aria-roledescription="journey"><text class="pele-title" font-weight="var(--_tw)" text-anchor="middle" xml:space="preserve"><tspan x="92" y="25.6">fa:fa-check &lt;u&gt;T&lt;/u&gt;</tspan></text><path class="pele-grid" d="M26,143H176M26,169H176M26,195H176M26,221H176M26,247H176" fill="none" stroke="var(--_a)"/><g class="pele-scale" font-size="12" text-anchor="end" fill="var(--_m)"><text x="20" y="147.2">5</text><text x="20" y="173.2">4</text><text x="20" y="199.2">3</text><text x="20" y="225.2">2</text><text x="20" y="251.2">1</text></g><path class="pele-stems" d="M104,116V184" fill="none" stroke="var(--_b)" stroke-dasharray="2 3"/><g class="pele-face pele-face-neutral" transform="translate(104,195)"><circle r="11" fill="var(--_bg)" stroke="var(--_l)"/><g fill="var(--_l)"><circle cx="-3.6" cy="-2.8" r="1.3"/><circle cx="3.6" cy="-2.8" r="1.3"/></g><path d="M-4.5,4.5H4.5" fill="none" stroke="var(--_l)" stroke-linecap="round"/></g><g class="pele-node pele-task" data-id="&lt;b&gt;bold&lt;/b&gt; a&lt;T&gt;&lt;br&gt;two"><rect x="32" y="48" width="144" height="68" fill="var(--_s)" stroke="var(--_b)" style="rx:var(--_r)"/><text font-size="14" text-anchor="middle" xml:space="preserve"><tspan x="104" y="69.9">&lt;b&gt;bold&lt;/b&gt; a&lt;T&gt;</tspan><tspan x="104" y="87.9">two</tspan></text><circle class="pele-actor" cx="104" cy="103" r="5" fill="var(--pele-series-1,#4c78a8)" stroke="var(--_s)"><title>&lt;i&gt;Me&lt;/i&gt;</title></circle></g><g class="pele-legend" font-size="14"><g class="pele-legend-item" data-id="&lt;i&gt;Me&lt;/i&gt;"><circle cx="69.87" cy="284.5" r="5" fill="var(--pele-series-1,#4c78a8)"/><text x="112" y="289.4" text-anchor="middle">&lt;i&gt;Me&lt;/i&gt;</text></g></g></svg>
    ),
  )
}

///|
test "a top to bottom journey with a section change and a long name" {
  inspect(
    svg(
      "journey\n  section A\n  long long long long long long long long long long long long long long long long long long long long long long long long long long long long long long : 4: X, Y\n  section B\n  b: 2: Y\n",
      max_width=260,
    ),
    content=(
