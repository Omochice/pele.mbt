ecap=\"round\"/></g><g class=\"pele-node pele-task\" data-id=\"a\"><rect x=\"32\" y=\"8\" width=\"144\" height=\"53\" fill=\"var(--_s)\" stroke=\"var(--_b)\" style=\"rx:var(--_r)\"/><text font-size=\"14\" x=\"104\" y=\"31.4\" text-anchor=\"middle\">a</text></g><g class=\"pele-node pele-task\" data-id=\"b\"><rect x=\"188\" y=\"8\" width=\"144\" height=\"53\" fill=\"var(--_s)\" stroke=\"var(--_b)\" style=\"rx:var(--_r)\"/><text font-size=\"14\" x=\"260\" y=\"31.4\" text-anchor=\"middle\">b</text><circle class=\"pele-actor\" cx=\"260\" cy=\"48\" r=\"5\" fill=\"var(--pele-series-1,#4c78a8)\" stroke=\"var(--_s)\"><title>Real</title></circle></g><g class=\"pele-legend\" font-size=\"14\"><g class=\"pele-legend-item\" data-id=\"Real\"><circle cx=\"164.61\" cy=\"229.5\" r=\"5\" fill=\"var(--pele-series-1,#4c78a8)\"/><text x=\"190\" y=\"234.4\" text-anchor=\"middle\">Real</text></g></g></svg>",
