///|
/// The size and the SVG of a journey, or the message when it cannot be drawn.
fn svg(source : String, max_width? : Double) -> String {
  let options = { ..@types.RenderOptions::default(), max_width, }
  let result = @core.render([@journey.journey], source, options) catch {
    @errors.PeleError(failure) => return failure.message
  }
  "\{result.width}x\{result.height} \{result.svg}"
}

///|
test "a journey with a title, a section, tasks and a legend" {
  inspect(
    svg("journey\n  title T\n  section S\n  a: 5: Me\n  b: 1: Me, You\n"),
    content="340x327 <svg xmlns=\"http://www.w3.org/2000/svg\" class=\"pele pele-journey\" viewBox=\"0 0 340 327\" width=\"340\" height=\"327\" style=\"max-width:100%;height:auto;--_bg:var(--pele-bg,#fff);--_fg:var(--pele-fg,#1f1f1f);--_m:var(--pele-muted,#6e6e6e);--_l:var(--pele-line,#1f1f1f);--_s:var(--pele-surface,#f3f3f3);--_a:var(--pele-surface-alt,#e6e6e6);--_b:var(--pele-border,#8a8a8a);--_c:var(--pele-accent,#5b7bd5);color:var(--_fg);--_r:var(--pele-radius,4px);--_tw:var(--pele-title-weight,bold);--_hw:var(--pele-heading-weight,bold);--_fm:var(--pele-font-mono,monospace);font:16px sans-serif;letter-spacing:normal;word-spacing:normal;text-transform:none;direction:ltr;font-family:var(--pele-font,sans-serif)\" fill=\"var(--_fg)\" role=\"graphics-document document\" aria-roledescription=\"journey\"><text class=\"pele-title\" font-weight=\"var(--_tw)\" text-anchor=\"middle\" xml:space=\"preserve\"><tspan x=\"170\" y=\"25.6\">T</tspan></text><path class=\"pele-grid\" d=\"M26,167H332M26,193H332M26,219H332M26,245H332M26,271H332\" fill=\"none\" stroke=\"var(--_a)\"/><g class=\"pele-scale\" font-size=\"12\" text-anchor=\"end\" fill=\"var(--_m)\"><text x=\"20\" y=\"171.2\">5</text><text x=\"20\" y=\"197.2\">4</text><text x=\"20\" y=\"223.2\">3</text><text x=\"20\" y=\"249.2\">2</text><text x=\"20\" y=\"275.2\">1</text></g><path class=\"pele-stems\" d=\"M104,140V156M260,140V260\" fill=\"none\" stroke=\"var(--_b)\" stroke-dasharray=\"2 3\"/><path class=\"pele-edge\" d=\"M104,167L260,271\" fill=\"none\" stroke=\"var(--_l)\" stroke-linejoin=\"round\"/><g class=\"pele-face pele-face-happy\" transform=\"translate(104,167)\"><circle r=\"11\" fill=\"var(--_bg)\" stroke=\"var(--_l)\"/><g fill=\"var(--_l)\"><circle cx=\"-3.6\" cy=\"-2.8\" r=\"1.3\"/><circle cx=\"3.6\" cy=\"-2.8\" r=\"1.3\"/></g><path d=\"M-5,2A6,6 0 0 0 5,2\" fill=\"none\" stroke=\"var(--_l)\" stroke-linecap=\"round\"/></g><g class=\"pele-face pele-face-sad\" transform=\"translate(260,271)\"><circle r=\"11\" fill=\"var(--_bg)\" stroke=\"var(--_l)\"/><g fill=\"var(--_l)\"><circle cx=\"-3.6\" cy=\"-2.8\" r=\"1.3\"/><circle cx=\"3.6\" cy=\"-2.8\" r=\"1.3\"/></g><path d=\"M-5,6.5A6,6 0 0 1 5,6.5\" fill=\"none\" stroke=\"var(--_l)\" stroke-linecap=\"round\"/></g><g class=\"pele-cluster pele-section\" data-id=\"S\"><rect x=\"32\" y=\"48\" width=\"300\" height=\"33\" fill=\"var(--_a)\" style=\"rx:var(--_r)\"/><text font-size=\"14\" font-weight=\"var(--_hw)\" text-anchor=\"middle\" xml:space=\"preserve\"><tspan x=\"182\" y=\"69.4\">S</tspan></text><g class=\"pele-node pele-task\" data-id=\"a\"><rect x=\"32\" y=\"87\" width=\"144\" height=\"53\" fill=\"var(--_s)\" stroke=\"var(--_b)\" style=\"rx:var(--_r)\"/><text font-size=\"14\" x=\"104\" y=\"110.4\" text-anchor=\"middle\">a</text><circle class=\"pele-actor\" cx=\"104\" cy=\"127\" r=\"5\" fill=\"var(--pele-series-1,#4c78a8)\" stroke=\"var(--_s)\"><title>Me</title></circle></g><g class=\"pele-node pele-task\" data-id=\"b\"><rect x=\"188\" y=\"87\" width=\"144\" height=\"53\" fill=\"var(--_s)\" stroke=\"var(--_b)\" style=\"rx:var(--_r)\"/><text font-size=\"14\" x=\"260\" y=\"110.4\" text-anchor=\"middle\">b</text><circle class=\"pele-actor\" cx=\"253.5\" cy=\"127\" r=\"5\" fill=\"var(--pele-series-1,#4c78a8)\" stroke=\"var(--_s)\"><title>Me</title></circle><circle class=\"pele-actor\" cx=\"266.5\" cy=\"127\" r=\"5\" fill=\"var(--pele-series-2,#f58518)\" stroke=\"var(--_s)\"><title>You</title></circle></g></g><g class=\"pele-legend\" font-size=\"14\"><g class=\"pele-legend-item\" data-id=\"Me\"><circle cx=\"138.82\" cy=\"308.5\" r=\"5\" fill=\"var(--pele-series-1,#4c78a8)\"/><text x=\"159.55\" y=\"313.4\" text-anchor=\"middle\">Me</text></g><g class=\"pele-legend-item\" data-id=\"You\"><circle cx=\"194.27\" cy=\"308.5\" r=\"5\" fill=\"var(--pele-series-2,#f58518)\"/><text x=\"217.72\" y=\"313.4\" text-anchor=\"middle\">You</text></g></g></svg>",
  )
}

///|
