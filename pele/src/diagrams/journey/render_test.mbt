\">Me</text></g><path class=\"pele-edge\" d=\"M150,163v16\" fill=\"none\" stroke=\"var(--_l)\"/><g class=\"pele-node pele-journey-step\" data-id=\"1\"><rect x=\"8\" y=\"179\" width=\"284\" height=\"108\" fill=\"var(--_s)\" stroke=\"var(--_b)\" style=\"rx:var(--_r)\"/><text class=\"pele-label\" x=\"21.89\" y=\"202.4\" text-anchor=\"middle\">b</text><g class=\"pele-face pele-face-sad\" transform=\"translate(264,198)\"><circle r=\"11\" fill=\"var(--_bg)\" stroke=\"var(--_l)\"/><g fill=\"var(--_l)\"><circle cx=\"-3.6\" cy=\"-2.8\" r=\"1.3\"/><circle cx=\"3.6\" cy=\"-2.8\" r=\"1.3\"/></g><path d=\"M-5,6.5A6,6 0 0 1 5,6.5\" fill=\"none\" stroke=\"var(--_l)\" stroke-linecap=\"round\"/></g><text class=\"pele-journey-score\" x=\"264\" y=\"223\" font-size=\"14\" text-anchor=\"middle\">1</text><circle class=\"pele-actor\" cx=\"24\" cy=\"243.5\" r=\"5\" fill=\"var(--pele-series-1,#4c78a8)\"/><text class=\"pele-journey-actor\" font-size=\"14\" x=\"45.72\" y=\"248.4\" text-anchor=\"middle\">Me</text><circle class=\"pele-actor\" cx=\"24\" cy=\"268.5\" r=\"5\" fill=\"var(--pele-series-2,#f58518)\"/><text class=\"pele-journey-actor\" font-size=\"14\" x=\"48.45\" y=\"273.4\" text-anchor=\"middle\">You</text></g></svg>",
