  inspect(
    svg("mindmap\n  root\n    a\n    b", max_width=400),
    content="242x64 <svg xmlns=\"http://www.w3.org/2000/svg\" class=\"pele pele-mindmap\" viewBox=\"0 0 242 64\" width=\"242\" height=\"64\" style=\"max-width:100%;height:auto;--_bg:var(--pele-bg,#fff);--_fg:var(--pele-fg,#1f1f1f);--_m:var(--pele-muted,#6e6e6e);--_l:var(--pele-line,#1f1f1f);--_s:var(--pele-surface,#f3f3f3);--_a:var(--pele-surface-alt,#e6e6e6);--_b:var(--pele-border,#8a8a8a);--_c:var(--pele-accent,#5b7bd5);color:var(--_fg);--_fm:var(--pele-font-mono,monospace);font:16px sans-serif;letter-spacing:normal;word-spacing:normal;text-transform:none;direction:ltr;font-family:var(--pele-font,sans-serif)\" fill=\"var(--_fg)\" role=\"graphics-document document\" aria-roledescription=\"mindmap\"><g transform=\"translate(120.68,32)\"><g class=\"pele-branch pele-section-0\"><g class=\"pele-edges\" fill=\"none\" stroke=\"var(--pele-series-1,#4c78a8)\" stroke-width=\"1.5\"><path class=\"pele-edge\" d=\"M39.78,0C65.78,0 65.78,0 91.78,0\"/></g><g class=\"pele-node pele-shape-text\" data-id=\"a\" transform=\"translate(102.23,0)\"><text class=\"pele-label\" x=\"0\" y=\"5.6\" text-anchor=\"middle\">a</text></g></g><g class=\"pele-branch pele-section-1\"><g class=\"pele-edges\" fill=\"none\" stroke=\"var(--pele-series-2,#f58518)\" stroke-width=\"1.5\"><path class=\"pele-edge\" d=\"M-39.78,0C-65.78,0 -65.78,0 -91.78,0\"/></g><g class=\"pele-node pele-shape-text\" data-id=\"b\" transform=\"translate(-102.23,0)\"><text class=\"pele-label\" x=\"0\" y=\"5.6\" text-anchor=\"middle\">b</text></g></g><g class=\"pele-node pele-shape-stadium pele-root\" data-id=\"root\" transform=\"translate(0,0)\"><rect x=\"-39.78\" y=\"-24\" width=\"79.57\" height=\"48\" rx=\"24\" fill=\"var(--_s)\" stroke=\"var(--_b)\"/><text class=\"pele-label\" x=\"0\" y=\"5.6\" text-anchor=\"middle\">root</text></g></g></svg>",
