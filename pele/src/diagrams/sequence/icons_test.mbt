///|
/// A host that has exactly the icons in `pairs`, by name.
fn host(pairs : Array[(String, String)]) -> @types.IconResolver {
  let icons = Map::from_array(pairs)
  name => icons.get(name)
}

///|
/// The size and drawing of `source` for a host with `icons`, or the message of its error.
fn with_icons(source : String, icons~ : @types.IconResolver) -> String {
  let options = { ..@types.RenderOptions::default(), icons: Some(icons), }
  let result = @core.render([@sequence.sequence], source, options) catch {
    @errors.PeleError(failure) => return failure.message
  }
  "\{result.width}x\{result.height} \{result.svg}"
}

///|
test "the title, actors, boxes, messages and notes draw the host's icons" {
  inspect(
    with_icons(
      "sequenceDiagram\n  title fa:fa-car Title\n  participant A as fa:fa-car Alice\n  actor B as fa:fa-car Bob\n  box fa:fa-car Group\n    participant C\n  end\n  A ->> B : fa:fa-car hello\n  Note over A,B : fa:fa-car note\n",
      icons=host([("fa:fa-car", "<path id=\"car\"/>")]),
    ),
    content="333x327 <svg xmlns=\"http://www.w3.org/2000/svg\" class=\"pele pele-sequence\" viewBox=\"0 0 333 327\" width=\"333\" height=\"327\" style=\"max-width:100%;height:auto;--_bg:var(--pele-bg,#fff);--_fg:var(--pele-fg,#1f1f1f);--_m:var(--pele-muted,#6e6e6e);--_l:var(--pele-line,#1f1f1f);--_s:var(--pele-surface,#f3f3f3);--_a:var(--pele-surface-alt,#e6e6e6);--_b:var(--pele-border,#8a8a8a);--_c:var(--pele-accent,#5b7bd5);color:var(--_fg);--_r:var(--pele-radius,4px);--_tw:var(--pele-title-weight,bold);--_fm:var(--pele-font-mono,monospace);font:16px sans-serif;letter-spacing:normal;word-spacing:normal;text-transform:none;direction:ltr;font-family:var(--pele-font,sans-serif)\" fill=\"var(--_fg)\" role=\"graphics-document document\" aria-roledescription=\"sequence\"><g transform=\"translate(53.56,44)\"><text class=\"pele-title\" font-weight=\"var(--_tw)\" text-anchor=\"middle\" xml:space=\"preserve\"><tspan x=\"103.78\" y=\"-18.4\" text-anchor=\"start\"> Title</tspan></text><svg class=\"pele-icon\" data-icon=\"fa:fa-car\" x=\"83.78\" y=\"-32.8\" width=\"17.6\" height=\"17.6\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path id=\"car\"/></svg><g class=\"pele-boxes\" font-size=\"14\"><g class=\"pele-cluster pele-box\" data-id=\"fa:fa-car Group\"><rect x=\"186.47\" y=\"0\" width=\"84\" height=\"275\" fill=\"var(--_a)\" stroke=\"var(--_b)\" fill-opacity=\"0.5\" style=\"rx:var(--_r)\"/><text class=\"pele-cluster-label\" fill=\"var(--_m)\" text-anchor=\"middle\" xml:space=\"preserve\"><tspan x=\"215.82\" y=\"22.4\" text-anchor=\"start\"> Group</tspan></text><svg class=\"pele-icon\" data-icon=\"fa:fa-car\" x=\"198.32\" y=\"9.8\" width=\"15.4\" height=\"15.4\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path id=\"car\"/></svg></g></g><g class=\"pele-lifelines\" fill=\"none\" stroke=\"var(--_b)\"><path class=\"pele-lifeline\" data-id=\"A\" d=\"M0,97V203\"/><path class=\"pele-lifeline\" data-id=\"B\" d=\"M116.02,97V203\"/><path class=\"pele-lifeline\" data-id=\"C\" d=\"M228.47,97V203\"/></g><g class=\"pele-edges\" fill=\"none\" stroke=\"var(--_l)\" stroke-linecap=\"round\"><g class=\"pele-edge pele-message\" data-id=\"i0\"><path d=\"M0,140H109.02\"/><path class=\"pele-marker\" d=\"M116.02,140L108.02,143.36L108.02,136.64Z\" fill=\"var(--_l)\" stroke=\"none\"/></g></g><g class=\"pele-edge-labels\" font-size=\"14\"><g class=\"pele-edge-label\" data-id=\"i0\"><text text-anchor=\"middle\" xml:space=\"preserve\"><tspan x=\"50.03\" y=\"130.4\" text-anchor=\"start\"> hello</tspan></text><svg class=\"pele-icon\" data-icon=\"fa:fa-car\" x=\"32.53\" y=\"117.8\" width=\"15.4\" height=\"15.4\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path id=\"car\"/></svg></g></g><g class=\"pele-notes\" font-size=\"14\" fill=\"var(--_a)\" stroke=\"var(--_b)\"><g class=\"pele-note\" data-id=\"i1\"><rect x=\"-16\" y=\"150\" width=\"148.02\" height=\"33\" style=\"rx:var(--_r)\"/><text class=\"pele-label\" stroke=\"none\" fill=\"var(--_fg)\" text-anchor=\"middle\" xml:space=\"preserve\"><tspan x=\"51.19\" y=\"171.4\" text-anchor=\"start\"> note</tspan></text><svg class=\"pele-icon\" data-icon=\"fa:fa-car\" x=\"33.69\" y=\"158.8\" width=\"15.4\" height=\"15.4\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path id=\"car\"/></svg></g></g><g class=\"pele-nodes\"><g class=\"pele-node pele-actor pele-actor-participant pele-actor-footer\" data-id=\"A\"><rect x=\"-45.56\" y=\"203\" width=\"91.12\" height=\"44\" fill=\"var(--_s)\" stroke=\"var(--_b)\" style=\"rx:var(--_r)\"/><text class=\"pele-label\" text-anchor=\"middle\" xml:space=\"preserve\"><tspan x=\"-9.56\" y=\"230.6\" text-anchor=\"start\"> Alice</tspan></text><svg class=\"pele-icon\" data-icon=\"fa:fa-car\" x=\"-29.56\" y=\"216.2\" width=\"17.6\" height=\"17.6\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path id=\"car\"/></svg></g><g class=\"pele-node pele-actor pele-actor-actor pele-actor-footer\" data-id=\"B\"><circle cx=\"116.02\" cy=\"210\" r=\"6\" fill=\"var(--_s)\" stroke=\"var(--_b)\"/><path d=\"M116.02,216V227M106.02,220H126.02M108.02,237L116.02,227L124.02,237\" fill=\"none\" stroke=\"var(--_b)\"/><text class=\"pele-label\" text-anchor=\"middle\" xml:space=\"preserve\"><tspan x=\"109.56\" y=\"258.6\" text-anchor=\"start\"> Bob</tspan></text><svg class=\"pele-icon\" data-icon=\"fa:fa-car\" x=\"89.56\" y=\"244.2\" width=\"17.6\" height=\"17.6\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path id=\"car\"/></svg></g><g class=\"pele-node pele-actor pele-actor-participant pele-actor-footer\" data-id=\"C\"><rect x=\"196.47\" y=\"203\" width=\"64\" height=\"44\" fill=\"var(--_s)\" stroke=\"var(--_b)\" style=\"rx:var(--_r)\"/><text class=\"pele-label\" x=\"228.47\" y=\"230.6\" text-anchor=\"middle\">C</text></g><g class=\"pele-node pele-actor pele-actor-participant\" data-id=\"A\"><rect x=\"-45.56\" y=\"53\" width=\"91.12\" height=\"44\" fill=\"var(--_s)\" stroke=\"var(--_b)\" style=\"rx:var(--_r)\"/><text class=\"pele-label\" text-anchor=\"middle\" xml:space=\"preserve\"><tspan x=\"-9.56\" y=\"80.6\" text-anchor=\"start\"> Alice</tspan></text><svg class=\"pele-icon\" data-icon=\"fa:fa-car\" x=\"-29.56\" y=\"66.2\" width=\"17.6\" height=\"17.6\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path id=\"car\"/></svg></g><g class=\"pele-node pele-actor pele-actor-actor\" data-id=\"B\"><circle cx=\"116.02\" cy=\"42\" r=\"6\" fill=\"var(--_s)\" stroke=\"var(--_b)\"/><path d=\"M116.02,48V59M106.02,52H126.02M108.02,69L116.02,59L124.02,69\" fill=\"none\" stroke=\"var(--_b)\"/><text class=\"pele-label\" text-anchor=\"middle\" xml:space=\"preserve\"><tspan x=\"109.56\" y=\"90.6\" text-anchor=\"start\"> Bob</tspan></text><svg class=\"pele-icon\" data-icon=\"fa:fa-car\" x=\"89.56\" y=\"76.2\" width=\"17.6\" height=\"17.6\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path id=\"car\"/></svg></g><g class=\"pele-node pele-actor pele-actor-participant\" data-id=\"C\"><rect x=\"196.47\" y=\"53\" width=\"64\" height=\"44\" fill=\"var(--_s)\" stroke=\"var(--_b)\" style=\"rx:var(--_r)\"/><text class=\"pele-label\" x=\"228.47\" y=\"80.6\" text-anchor=\"middle\">C</text></g></g></g></svg>",
  )
}
