///|
test "puts the title above the diagram" {
  inspect(
    snapshot(
      "---\ntitle: A rather long state diagram title\n---\nstateDiagram-v2\na --> b",
    ),
    content=(
      #|257 x 184 
      #|<svg xmlns="http://www.w3.org/2000/svg" class="pele pele-state" viewBox="0 0 257 184" width="257" height="184" style="max-width:100%;height:auto;--_bg:var(--pele-bg,#fff);--_fg:var(--pele-fg,#1f1f1f);--_m:var(--pele-muted,#6e6e6e);--_l:var(--pele-line,#1f1f1f);--_s:var(--pele-surface,#f3f3f3);--_a:var(--pele-surface-alt,#e6e6e6);--_b:var(--pele-border,#8a8a8a);--_c:var(--pele-accent,#5b7bd5);color:var(--_fg);--_tw:var(--pele-title-weight,bold);--_fm:var(--pele-font-mono,monospace);font:16px sans-serif;letter-spacing:normal;word-spacing:normal;text-transform:none;direction:ltr;font-family:var(--pele-font,sans-serif)" fill="var(--_fg)" role="graphics-document document" aria-roledescription="state"><text class="pele-title" font-weight="var(--_tw)" text-anchor="middle" xml:space="preserve"><tspan x="128.5" y="25.6">A rather long state diagram title</tspan></text><g transform="translate(92.5,36)"><g class="pele-edges" fill="none" stroke="var(--_l)" stroke-linecap="round"><g class="pele-edge pele-transition" data-id="edge0"><path d="M36,52L36,89"/><path class="pele-marker" d="M36,96L32.64,88L39.36,88Z" fill="var(--_l)" stroke="none"/></g></g><g class="pele-nodes"><g class="pele-node pele-state" data-id="a" transform="translate(36,30)"><rect x="-28" y="-22" width="56" height="44" rx="10" fill="var(--_s)" stroke="var(--_b)"/><text class="pele-label" x="0" y="5.6" text-anchor="middle">a</text></g><g class="pele-node pele-state" data-id="b" transform="translate(36,118)"><rect x="-28" y="-22" width="56" height="44" rx="10" fill="var(--_s)" stroke="var(--_b)"/><text class="pele-label" x="0" y="5.6" text-anchor="middle">b</text></g></g></g></svg>
