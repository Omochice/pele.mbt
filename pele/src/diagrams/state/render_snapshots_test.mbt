///|
test "links states that have a click statement" {
  inspect(
    snapshot(
      "stateDiagram-v2\na --> b\nb --> c\nclick a \"https://example.com/x\" \"Go there\"\nclick b href \"https://example.org\"\nclick c \"javascript:alert(1)\" \"no\"",
    ),
    content=(
      #|72 x 236 a|https://example.com/x|false;b|https://example.org/|false
