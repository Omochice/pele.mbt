///|
test "draws notes beside their states in both directions" {
  inspect(
    snapshot(
      "stateDiagram-v2\na --> b\nnote right of a : on the right\nnote left of b\n first line\n second line\nend note",
    ),
    content=(
      #|349 x 156 
      #|<svg xmlns="http://www.w3.org/2000/svg" class="pele pele-state" viewBox="0 0 349 156" width="349" height="156" style="max-width:100%;height:auto;--_bg:var(--pele-bg,#fff);--_fg:var(--pele-fg,#1f1f1f);--_m:var(--pele-muted,#6e6e6e);--_l:var(--pele-line,#1f1f1f);--_s:var(--pele-surface,#f3f3f3);--_a:var(--pele-surface-alt,#e6e6e6);--_b:var(--pele-border,#8a8a8a);--_c:var(--pele-accent,#5b7bd5);color:var(--_fg);--_fm:var(--pele-font-mono,monospace);font:16px sans-serif;letter-spacing:normal;word-spacing:normal;text-transform:none;direction:ltr;font-family:var(--pele-font,sans-serif)" fill="var(--_fg)" role="graphics-document document" aria-roledescription="state"><g class="pele-edges" fill="none" stroke="var(--_l)" stroke-linecap="round"><g class="pele-edge pele-transition" data-id="edge0"><path d="M174.81,52L174.81,96L174.81,93"/><path class="pele-marker" d="M174.81,100L171.45,92L178.17,92Z" fill="var(--_l)" stroke="none"/></g><g class="pele-edge pele-note-edge" stroke="var(--_b)" stroke-dasharray="3 4" data-id="a-a----note-1"><path d="M202.81,30L246.81,30"/></g><g class="pele-edge pele-note-edge" stroke="var(--_b)" stroke-dasharray="3 4" data-id="b----note-2-b"><path d="M102.81,122L146.81,122"/></g></g><g class="pele-nodes"><g class="pele-node pele-state" data-id="a" transform="translate(174.81,30)"><rect x="-28" y="-22" width="56" height="44" rx="10" fill="var(--_s)" stroke="var(--_b)"/><text class="pele-label" x="0" y="5.6" text-anchor="middle">a</text></g><g class="pele-node pele-state" data-id="b" transform="translate(174.81,122)"><rect x="-28" y="-22" width="56" height="44" rx="10" fill="var(--_s)" stroke="var(--_b)"/><text class="pele-label" x="0" y="5.6" text-anchor="middle">b</text></g><g class="pele-note" data-id="a----note-1" transform="translate(293.83,30)"><path d="M-47.02,-18.5H39.02L47.02,-10.5V18.5H-47.02Z" fill="var(--_bg)" stroke="var(--_b)"/><path d="M39.02,-18.5V-10.5H47.02" fill="none" stroke="var(--_b)"/><text class="pele-label" font-size="14" fill="var(--_m)" x="0" y="4.9" text-anchor="middle">on the right</text></g><g class="pele-note" data-id="b----note-2" transform="translate(55.41,122)"><path d="M-47.41,-26H39.41L47.41,-18V26H-47.41Z" fill="var(--_bg)" stroke="var(--_b)"/><path d="M39.41,-26V-18H47.41" fill="none" stroke="var(--_b)"/><text class="pele-label" font-size="14" fill="var(--_m)" text-anchor="middle" xml:space="preserve"><tspan x="0" y="-4.1">first line</tspan><tspan x="0" y="13.9">second line</tspan></text></g></g></svg>
    ),
  )
}

