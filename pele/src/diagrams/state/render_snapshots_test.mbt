    content=(
      #|210 x 116 
      #|<svg xmlns="http://www.w3.org/2000/svg" class="pele pele-state" viewBox="0 0 210 116" width="210" height="116" style="max-width:100%;height:auto;--_bg:var(--pele-bg,#fff);--_fg:var(--pele-fg,#1f1f1f);--_m:var(--pele-muted,#6e6e6e);--_l:var(--pele-line,#1f1f1f);--_s:var(--pele-surface,#f3f3f3);--_a:var(--pele-surface-alt,#e6e6e6);--_b:var(--pele-border,#8a8a8a);--_c:var(--pele-accent,#5b7bd5);color:var(--_fg);--_w:var(--pele-bold-weight,bold);--_fm:var(--pele-font-mono,monospace);font:16px sans-serif;letter-spacing:normal;word-spacing:normal;text-transform:none;direction:ltr;font-family:var(--pele-font,sans-serif)" fill="var(--_fg)" role="graphics-document document" aria-roledescription="state"><g class="pele-nodes"><g class="pele-node pele-state" data-id="s1" transform="translate(48.51,58)"><rect x="-40.51" y="-50" width="81.01" height="100" rx="10" fill="var(--_s)" stroke="var(--_b)"/><path d="M-40.51,-10H40.51" fill="none" stroke="var(--_b)"/><text class="pele-label" x="0" y="-22.4" text-anchor="middle">Title</text><text class="pele-state-description" font-size="14" x="0" y="13.4" text-anchor="middle">first</text><text class="pele-state-description" font-size="14" font-weight="var(--_w)" text-anchor="middle" xml:space="preserve"><tspan x="0" y="34.4">second</tspan></text></g><g class="pele-node pele-state" data-id="s2" transform="translate(165.02,58)"><rect x="-36.01" y="-22" width="72.02" height="44" rx="10" fill="var(--_s)" stroke="var(--_b)"/><text class="pele-label" x="0" y="5.6" text-anchor="middle">Other</text></g></g></svg>
