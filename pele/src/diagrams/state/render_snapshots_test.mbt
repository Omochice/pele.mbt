// The snapshots were taken from pele v1.8.0's render under the default options.

///|
/// What rendering gives: the size and links, then the document, or the error.
fn snapshot(source : String, max_width? : Double) -> String {
  match drawn(source, max_width?) {
    Ok(r) => {
      let links = r.links.map(l => "\{l.id}|\{l.href}|\{l.internal}").join(";")
      "\{r.width} x \{r.height} \{links}\n\{r.svg}"
    }
    Err(failure) => "error \{failure.code.to_string()}\n\{failure.message}"
  }
}

///|
test "draws a transition between start, state and end" {
  inspect(
    snapshot("stateDiagram-v2\n[*] --> a\na --> [*]"),
    content=(
      #|72 x 180 
      #|<svg xmlns="http://www.w3.org/2000/svg" class="pele pele-state" viewBox="0 0 72 180" width="72" height="180" style="max-width:100%;height:auto;--_bg:var(--pele-bg,#fff);--_fg:var(--pele-fg,#1f1f1f);--_m:var(--pele-muted,#6e6e6e);--_l:var(--pele-line,#1f1f1f);--_s:var(--pele-surface,#f3f3f3);--_a:var(--pele-surface-alt,#e6e6e6);--_b:var(--pele-border,#8a8a8a);--_c:var(--pele-accent,#5b7bd5);color:var(--_fg);--_fm:var(--pele-font-mono,monospace);font:16px sans-serif;letter-spacing:normal;word-spacing:normal;text-transform:none;direction:ltr;font-family:var(--pele-font,sans-serif)" fill="var(--_fg)" role="graphics-document document" aria-roledescription="state"><g class="pele-edges" fill="none" stroke="var(--_l)" stroke-linecap="round"><g class="pele-edge pele-transition" data-id="edge0"><path d="M36,22L36,59"/><path class="pele-marker" d="M36,66L32.64,58L39.36,58Z" fill="var(--_l)" stroke="none"/></g><g class="pele-edge pele-transition" data-id="edge1"><path d="M36,110L36,147"/><path class="pele-marker" d="M36,154L32.64,146L39.36,146Z" fill="var(--_l)" stroke="none"/></g></g><g class="pele-nodes"><g class="pele-node pele-state-start" data-id="root_start" transform="translate(36,15)"><circle r="7" fill="var(--_l)"/></g><g class="pele-node pele-state" data-id="a" transform="translate(36,88)"><rect x="-28" y="-22" width="56" height="44" rx="10" fill="var(--_s)" stroke="var(--_b)"/><text class="pele-label" x="0" y="5.6" text-anchor="middle">a</text></g><g class="pele-node pele-state-end" data-id="root_end" transform="translate(36,163)"><circle r="8.5" fill="var(--_bg)" stroke="var(--_l)"/><circle r="5" fill="var(--_l)"/></g></g></svg>
    ),
  )
}

///|
test "draws a state with a title over description lines" {
