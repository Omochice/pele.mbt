///|
test "render_usecase: notes, JSON tables, classes and styles" {
  inspect(
    svg_of(
      "usecase-beta\nactor User\nnote for User \"Starts the workflow\"\nnote for Login \"`Needs a **session**`\"\nUser --> Login\njson Payload@{\n  \"2\": \"second\",\n  \"1\": \"first\",\n  \"colors\": [\"Red\", \"Green\"],\n  \"address\": { \"city\": \"Oslo\" },\n  \"none\": null,\n  \"empty\": {}\n}\nLogin --> Payload",
    ),
    content="<svg xmlns=\"http://www.w3.org/2000/svg\" class=\"pele pele-usecase\" viewBox=\"0 0 759 251\" width=\"759\" height=\"251\" style=\"max-width:100%;height:auto;--_bg:var(--pele-bg,#fff);--_fg:var(--pele-fg,#1f1f1f);--_m:var(--pele-muted,#6e6e6e);--_l:var(--pele-line,#1f1f1f);--_s:var(--pele-surface,#f3f3f3);--_a:var(--pele-surface-alt,#e6e6e6);--_b:var(--pele-border,#8a8a8a);--_c:var(--pele-accent,#5b7bd5);color:var(--_fg);--_r:var(--pele-radius,4px);--_hw:var(--pele-heading-weight,bold);--_w:var(--pele-bold-weight,bold);--_fm:var(--pele-font-mono,monospace);font:16px sans-serif;letter-spacing:normal;word-spacing:normal;text-transform:none;direction:ltr;font-family:var(--pele-font,sans-serif)\" fill=\"var(--_fg)\" role=\"graphics-document document\" aria-roledescription=\"usecase\"><g class=\"pele-edges\" fill=\"none\" stroke=\"var(--_l)\" stroke-linecap=\"round\"><g class=\"pele-edge pele-association\" data-id=\"edge-0\"><path d=\"M314.34,62.25C366.69,62.25 366.69,118.5 419.05,118.5L425.05,118.5\"/><path class=\"pele-marker\" d=\"M432.05,118.5L424.05,121.86L424.05,115.14Z\" fill=\"var(--_l)\" stroke=\"none\"/></g><g class=\"pele-edge pele-association\" data-id=\"edge-1\"><path d=\"M518.42,125.5L583.42,125.5\"/><path class=\"pele-marker\" d=\"M590.42,125.5L582.42,128.86L582.42,122.14Z\" fill=\"var(--_l)\" stroke=\"none\"/></g><g class=\"pele-edge pele-note\" data-id=\"note-0-edge\"><path d=\"M152.26,77.25C210.3,77.25 210.3,62.25 268.34,62.25\" stroke-dasharray=\"2 3\"/></g><g class=\"pele-edge pele-note\" data-id=\"note-1-edge\"><path d=\"M358.42,173.75C395.23,173.75 395.23,132.5 432.05,132.5\" stroke-dasharray=\"2 3\"/></g></g><g class=\"pele-nodes\"><g class=\"pele-node pele-actor usecase-actor usecase-actor-normal\" data-id=\"User\" transform=\"translate(291.34,77.25)\"><g class=\"pele-actor-figure\" transform=\"translate(0,-15)\"><circle cy=\"-21\" r=\"9\" fill=\"var(--_s)\" stroke=\"var(--_b)\"/><path d=\"M0,-12V10M-14,-3H14M0,10L-12,30M0,10L12,30\" fill=\"none\" stroke=\"var(--_b)\"/></g><text class=\"pele-label\" x=\"0\" y=\"38.6\" text-anchor=\"middle\">User</text></g><g class=\"pele-node pele-usecase usecase-element usecase-ellipse\" data-id=\"Login\" transform=\"translate(474.42,125.5)\"><ellipse rx=\"44\" ry=\"26\" fill=\"var(--_s)\" stroke=\"var(--_b)\"/><text class=\"pele-label\" x=\"0\" y=\"5.6\" text-anchor=\"middle\">Login</text></g><g class=\"pele-node pele-note usecase-note\" data-id=\"note-0\" transform=\"translate(80.13,77.25)\"><path d=\"M-72.13,-19.5H63.13L72.13,-10.5V19.5H-72.13Z\" fill=\"var(--_a)\" stroke=\"var(--_b)\" stroke-linejoin=\"round\"/><path d=\"M63.13,-19.5V-10.5H72.13\" fill=\"none\" stroke=\"var(--_b)\" stroke-linejoin=\"round\"/><text class=\"pele-label\" font-size=\"14\" x=\"0\" y=\"4.9\" text-anchor=\"middle\">Starts the workflow</text></g><g class=\"pele-node pele-note usecase-note\" data-id=\"note-1\" transform=\"translate(291.34,173.75)\"><path d=\"M-67.08,-19.5H58.08L67.08,-10.5V19.5H-67.08Z\" fill=\"var(--_a)\" stroke=\"var(--_b)\" stroke-linejoin=\"round\"/><path d=\"M58.08,-19.5V-10.5H67.08\" fill=\"none\" stroke=\"var(--_b)\" stroke-linejoin=\"round\"/><text class=\"pele-label\" font-size=\"14\" text-anchor=\"middle\" xml:space=\"preserve\"><tspan x=\"0\" y=\"4.9\">Needs a </tspan><tspan font-weight=\"var(--_w)\">session</tspan></text></g><g class=\"pele-node pele-json usecase-json-table\" data-id=\"Payload\" transform=\"translate(670.34,125.5)\"><rect x=\"-79.91\" y=\"-117.5\" width=\"159.83\" height=\"235\" fill=\"var(--_s)\" stroke=\"var(--_b)\" style=\"rx:var(--_r)\"/><path class=\"pele-json-lines\" d=\"M-79.91,-85.5H79.91M14.78,-85.5V117.5\" fill=\"none\" stroke=\"var(--_b)\"/><text class=\"pele-label\" font-weight=\"var(--_hw)\" text-anchor=\"middle\" xml:space=\"preserve\"><tspan x=\"0\" y=\"-95.9\">Payload</tspan></text><g font-size=\"14\"><text class=\"pele-json-key\" fill=\"var(--_m)\" x=\"-66.02\" y=\"-66.1\" text-anchor=\"middle\">2</text><text class=\"pele-json-value\" x=\"47.35\" y=\"-66.1\" text-anchor=\"middle\">second</text><text class=\"pele-json-key\" fill=\"var(--_m)\" x=\"-66.02\" y=\"-37.1\" text-anchor=\"middle\">1</text><text class=\"pele-json-value\" x=\"36.05\" y=\"-37.1\" text-anchor=\"middle\">first</text><text class=\"pele-json-key\" fill=\"var(--_m)\" x=\"-51.24\" y=\"-8.1\" text-anchor=\"middle\">colors</text><text class=\"pele-json-value\" x=\"37.62\" y=\"-8.1\" text-anchor=\"middle\">Red</text><text class=\"pele-json-value\" x=\"44.23\" y=\"20.9\" text-anchor=\"middle\">Green</text><text class=\"pele-json-key\" fill=\"var(--_m)\" x=\"-32.57\" y=\"49.9\" text-anchor=\"middle\">address.city</text><text class=\"pele-json-value\" x=\"39.17\" y=\"49.9\" text-anchor=\"middle\">Oslo</text><text class=\"pele-json-key\" fill=\"var(--_m)\" x=\"-54.34\" y=\"78.9\" text-anchor=\"middle\">none</text><text class=\"pele-json-value\" x=\"35.67\" y=\"78.9\" text-anchor=\"middle\">null</text><text class=\"pele-json-key\" fill=\"var(--_m)\" x=\"-50.85\" y=\"107.9\" text-anchor=\"middle\">empty</text><text class=\"pele-json-value\" x=\"29.45\" y=\"107.9\" text-anchor=\"middle\">{}</text></g></g></g></svg>",
