///|
test "render_usecase: loops on a node across the flow" {
  inspect(
    svg_of(
      "usecase-beta\nLogin loop@..> : include Login\nLogin -- again --> Login\nLogin --> Login",
    ),
    content="<svg xmlns=\"http://www.w3.org/2000/svg\" class=\"pele pele-usecase\" viewBox=\"0 0 104 340\" width=\"104\" height=\"340\" style=\"max-width:100%;height:auto;--_bg:var(--pele-bg,#fff);--_fg:var(--pele-fg,#1f1f1f);--_m:var(--pele-muted,#6e6e6e);--_l:var(--pele-line,#1f1f1f);--_s:var(--pele-surface,#f3f3f3);--_a:var(--pele-surface-alt,#e6e6e6);--_b:var(--pele-border,#8a8a8a);--_c:var(--pele-accent,#5b7bd5);color:var(--_fg);--_fm:var(--pele-font-mono,monospace);font:16px sans-serif;letter-spacing:normal;word-spacing:normal;text-transform:none;direction:ltr;font-family:var(--pele-font,sans-serif)\" fill=\"var(--_fg)\" role=\"graphics-document document\" aria-roledescription=\"usecase\"><g class=\"pele-edges\" fill=\"none\" stroke=\"var(--_l)\" stroke-linecap=\"round\"><g class=\"pele-edge pele-include\" data-id=\"loop\"><path d=\"M44,195.57C36,221.57 68,221.57 62.06,202.26\" stroke-dasharray=\"5 4\"/><path class=\"pele-marker\" d=\"M60,195.57L65.56,202.22L59.14,204.2Z\" fill=\"var(--_l)\" stroke=\"none\"/></g><g class=\"pele-edge pele-association\" data-id=\"edge-0\"><path d=\"M38,194.65C24,228.65 80,228.65 68.67,201.12\"/><path class=\"pele-marker\" d=\"M66,194.65L72.15,200.77L65.94,203.33Z\" fill=\"var(--_l)\" stroke=\"none\"/></g><g class=\"pele-edge pele-association\" data-id=\"edge-1\"><path d=\"M32,193.16C12,235.16 92,235.16 75.01,199.48\"/><path class=\"pele-marker\" d=\"M72,193.16L78.47,198.94L72.41,201.83Z\" fill=\"var(--_l)\" stroke=\"none\"/></g></g><g class=\"pele-edge-labels\" font-size=\"14\"><g class=\"pele-edge-label\" data-id=\"loop\"><rect x=\"17.7\" y=\"221.07\" width=\"68.59\" height=\"21\" rx=\"3\" fill=\"var(--_bg)\"/><text fill=\"var(--_m)\" x=\"52\" y=\"236.47\" text-anchor=\"middle\">«include»</text></g><g class=\"pele-edge-label\" data-id=\"edge-0\"><rect x=\"30.88\" y=\"226.15\" width=\"42.24\" height=\"21\" rx=\"3\" fill=\"var(--_bg)\"/><text x=\"52\" y=\"241.55\" text-anchor=\"middle\">again</text></g></g><g class=\"pele-nodes\"><g class=\"pele-node pele-usecase usecase-element usecase-ellipse\" data-id=\"Login\" transform=\"translate(52,170)\"><ellipse rx=\"44\" ry=\"26\" fill=\"var(--_s)\" stroke=\"var(--_b)\"/><text class=\"pele-label\" x=\"0\" y=\"5.6\" text-anchor=\"middle\">Login</text></g></g></svg>",
  )
  inspect(
    svg_of(
      "usecase-beta\ndirection TB\nLogin loop@..> : include Login\nactor A\nA --> A",
