<g class=\"pele-node pele-usecase usecase-element usecase-ellipse\" data-id=\"Auth\" transform=\"translate(671.19,79.5)\"><ellipse rx=\"44\" ry=\"26\" fill=\"var(--_s)\" stroke=\"var(--_b)\"/><text class=\"pele-label\" x=\"0\" y=\"5.6\" text-anchor=\"middle\">Auth</text></g><g class=\"pele-node pele-usecase usecase-element usecase-ellipse\" data-id=\"Audit\" transform=\"translate(169.34,156)\"><ellipse rx=\"44\" ry=\"26\" fill=\"var(--_s)\" stroke=\"var(--_b)\"/><text class=\"pele-label\" x=\"0\" y=\"5.6\" text-anchor=\"middle\">Audit</text></g><g class=\"pele-node pele-usecase usecase-element usecase-ellipse\" data-id=\"Far\" transform=\"translate(903.19,129.5)\"><ellipse rx=\"44\" ry=\"26\" fill=\"var(--_s)\" stroke=\"var(--_b)\"/><text class=\"pele-label\" x=\"0\" y=\"5.6\" text-anchor=\"middle\">Far</text></g></g></svg>",
