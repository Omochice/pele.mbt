///|
/// A host that has exactly the icons in `pairs`, by name.
fn host(pairs : Array[(String, String)]) -> @types.IconResolver {
  let icons = Map::from_array(pairs)
  name => icons.get(name)
}

///|
test "render_usecase: icon actors, stereotypes, labels and edge labels draw the host's icons" {
  inspect(
    svg_of(
      "usecase-beta\nactor Icon(\"fa:fa-car Registered\")@{ icon: \"user\" } <<fa:fa-car Bot>>\nactor Missing@{ icon: \"nobody\" }\nIcon -- \"fa:fa-car go\" --> Login\n",
      icons=host([
        ("user", "<path id=\"user\"/>"),
        ("fa:fa-car", "<path id=\"car\"/>"),
      ]),
    ),
    content="<svg xmlns=\"http://www.w3.org/2000/svg\" class=\"pele pele-usecase\" viewBox=\"0 0 327 248\" width=\"327\" height=\"248\" style=\"max-width:100%;height:auto;--_bg:var(--pele-bg,#fff);--_fg:var(--pele-fg,#1f1f1f);--_m:var(--pele-muted,#6e6e6e);--_l:var(--pele-line,#1f1f1f);--_s:var(--pele-surface,#f3f3f3);--_a:var(--pele-surface-alt,#e6e6e6);--_b:var(--pele-border,#8a8a8a);--_c:var(--pele-accent,#5b7bd5);color:var(--_fg);--_r:var(--pele-radius,4px);--_fm:var(--pele-font-mono,monospace);font:16px sans-serif;letter-spacing:normal;word-spacing:normal;text-transform:none;direction:ltr;font-family:var(--pele-font,sans-serif)\" fill=\"var(--_fg)\" role=\"graphics-document document\" aria-roledescription=\"usecase\"><g class=\"pele-edges\" fill=\"none\" stroke=\"var(--_l)\" stroke-linecap=\"round\"><g class=\"pele-edge pele-association\" data-id=\"edge-0\"><path d=\"M81.9,38C113.86,38 113.86,63 145.81,63L223.77,63\"/><path class=\"pele-marker\" d=\"M230.77,63L222.77,66.36L222.77,59.64Z\" fill=\"var(--_l)\" stroke=\"none\"/></g></g><g class=\"pele-edge-labels\" font-size=\"14\"><g class=\"pele-edge-label\" data-id=\"edge-0\"><rect x=\"147.81\" y=\"52.5\" width=\"44.96\" height=\"21\" rx=\"3\" fill=\"var(--_bg)\"/><text text-anchor=\"middle\" xml:space=\"preserve\"><tspan x=\"169.31\" y=\"67.9\" text-anchor=\"start\"> go</tspan></text><svg class=\"pele-icon\" data-icon=\"fa:fa-car\" x=\"151.81\" y=\"55.3\" width=\"15.4\" height=\"15.4\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path id=\"car\"/></svg></g></g><g class=\"pele-nodes\"><g class=\"pele-node pele-actor usecase-actor usecase-actor-icon\" data-id=\"Icon\" transform=\"translate(58.9,63)\"><g class=\"pele-actor-figure\" transform=\"translate(0,-25)\"><rect x=\"-22\" y=\"-26\" width=\"44\" height=\"44\" fill=\"var(--_s)\" stroke=\"var(--_b)\" style=\"rx:var(--_r)\"/><svg class=\"pele-icon\" data-icon=\"user\" x=\"-14\" y=\"-18\" width=\"28\" height=\"28\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path id=\"user\"/></svg></g><text class=\"pele-stereotype\" font-size=\"13\" fill=\"var(--_m)\" text-anchor=\"middle\" xml:space=\"preserve\"><tspan x=\"-27.23\" y=\"25.55\" text-anchor=\"start\">«</tspan><tspan x=\"-3.44\" y=\"25.55\" text-anchor=\"start\"> Bot»</tspan></text><svg class=\"pele-icon\" data-icon=\"fa:fa-car\" x=\"-19.69\" y=\"13.85\" width=\"14.3\" height=\"14.3\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path id=\"car\"/></svg><text class=\"pele-label\" text-anchor=\"middle\" xml:space=\"preserve\"><tspan x=\"-30.9\" y=\"48.6\" text-anchor=\"start\"> Registered</tspan></text><svg class=\"pele-icon\" data-icon=\"fa:fa-car\" x=\"-50.9\" y=\"34.2\" width=\"17.6\" height=\"17.6\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path id=\"car\"/></svg></g><g class=\"pele-node pele-actor usecase-actor usecase-actor-icon\" data-id=\"Missing\" transform=\"translate(58.9,195)\"><g class=\"pele-actor-figure\" transform=\"translate(0,-15)\"><rect x=\"-22\" y=\"-26\" width=\"44\" height=\"44\" fill=\"var(--_s)\" stroke=\"var(--_b)\" style=\"rx:var(--_r)\"/><svg class=\"pele-icon\" data-icon=\"nobody\" x=\"-14\" y=\"-18\" width=\"28\" height=\"28\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"></svg></g><text class=\"pele-label\" x=\"0\" y=\"38.6\" text-anchor=\"middle\">Missing</text></g><g class=\"pele-node pele-usecase usecase-element usecase-ellipse\" data-id=\"Login\" transform=\"translate(274.77,63)\"><ellipse rx=\"44\" ry=\"26\" fill=\"var(--_s)\" stroke=\"var(--_b)\"/><text class=\"pele-label\" x=\"0\" y=\"5.6\" text-anchor=\"middle\">Login</text></g></g></svg>",
  )
}

///|
test "render_usecase: boundary titles and use cases draw the host's icons" {
  inspect(
    svg_of(
      "usecase-beta\nsystemBoundary Shop[\"fa:fa-car The shop\"]\n  Browse(\"fa:fa-car Browse\") <<fa:fa-car Core>>\nend\nsystemBoundary P[\"fa:fa-car Pack\"]@{ type: package }\n  Pay\nend\n",
      icons=host([("fa:fa-car", "<path id=\"car\"/>")]),
    ),
    content="<svg xmlns=\"http://www.w3.org/2000/svg\" class=\"pele pele-usecase\" viewBox=\"0 0 178 304\" width=\"178\" height=\"304\" style=\"max-width:100%;height:auto;--_bg:var(--pele-bg,#fff);--_fg:var(--pele-fg,#1f1f1f);--_m:var(--pele-muted,#6e6e6e);--_l:var(--pele-line,#1f1f1f);--_s:var(--pele-surface,#f3f3f3);--_a:var(--pele-surface-alt,#e6e6e6);--_b:var(--pele-border,#8a8a8a);--_c:var(--pele-accent,#5b7bd5);color:var(--_fg);--_r:var(--pele-radius,4px);--_fm:var(--pele-font-mono,monospace);font:16px sans-serif;letter-spacing:normal;word-spacing:normal;text-transform:none;direction:ltr;font-family:var(--pele-font,sans-serif)\" fill=\"var(--_fg)\" role=\"graphics-document document\" aria-roledescription=\"usecase\"><g class=\"pele-clusters\"><g class=\"pele-cluster pele-boundary system-boundary system-boundary-rect\" data-id=\"Shop\"><rect x=\"8\" y=\"8\" width=\"161.79\" height=\"132\" fill=\"var(--_a)\" fill-opacity=\"0.5\" stroke=\"var(--_b)\" style=\"rx:var(--_r)\"/><text class=\"pele-cluster-label\" fill=\"var(--_m)\" text-anchor=\"middle\" xml:space=\"preserve\"><tspan x=\"63.32\" y=\"33.6\" text-anchor=\"start\"> The shop</tspan></text><svg class=\"pele-icon\" data-icon=\"fa:fa-car\" x=\"43.32\" y=\"19.2\" width=\"17.6\" height=\"17.6\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path id=\"car\"/></svg></g><g class=\"pele-cluster pele-boundary system-boundary system-boundary-package\" data-id=\"P\"><rect class=\"pele-boundary-tab\" x=\"24.9\" y=\"172\" width=\"80.02\" height=\"36\" fill=\"var(--_a)\" fill-opacity=\"0.5\" stroke=\"var(--_b)\"/><rect x=\"24.9\" y=\"208\" width=\"128\" height=\"88\" fill=\"var(--_a)\" fill-opacity=\"0.5\" stroke=\"var(--_b)\"/><text class=\"pele-cluster-label\" fill=\"var(--_m)\" text-anchor=\"middle\" xml:space=\"preserve\"><tspan x=\"54.9\" y=\"195.6\" text-anchor=\"start\"> Pack</tspan></text><svg class=\"pele-icon\" data-icon=\"fa:fa-car\" x=\"34.9\" y=\"181.2\" width=\"17.6\" height=\"17.6\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path id=\"car\"/></svg></g></g><g class=\"pele-nodes\"><g class=\"pele-node pele-usecase usecase-element usecase-ellipse\" data-id=\"Browse\" transform=\"translate(88.9,84)\"><ellipse rx=\"60.9\" ry=\"36\" fill=\"var(--_s)\" stroke=\"var(--_b)\"/><text class=\"pele-stereotype\" font-size=\"13\" fill=\"var(--_m)\" text-anchor=\"middle\" xml:space=\"preserve\"><tspan x=\"-31.56\" y=\"-7.45\" text-anchor=\"start\">«</tspan><tspan x=\"-7.77\" y=\"-7.45\" text-anchor=\"start\"> Core»</tspan></text><svg class=\"pele-icon\" data-icon=\"fa:fa-car\" x=\"-24.02\" y=\"-19.15\" width=\"14.3\" height=\"14.3\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path id=\"car\"/></svg><text class=\"pele-label\" text-anchor=\"middle\" xml:space=\"preserve\"><tspan x=\"-18.9\" y=\"15.6\" text-anchor=\"start\"> Browse</tspan></text><svg class=\"pele-icon\" data-icon=\"fa:fa-car\" x=\"-38.9\" y=\"1.2\" width=\"17.6\" height=\"17.6\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path id=\"car\"/></svg></g><g class=\"pele-node pele-usecase usecase-element usecase-ellipse\" data-id=\"Pay\" transform=\"translate(88.9,250)\"><ellipse rx=\"44\" ry=\"26\" fill=\"var(--_s)\" stroke=\"var(--_b)\"/><text class=\"pele-label\" x=\"0\" y=\"5.6\" text-anchor=\"middle\">Pay</text></g></g></svg>",
  )
}

///|
test "render_usecase: json tables and notes draw the host's icons" {
  inspect(
    svg_of(
      "usecase-beta\njson Payload@{\n  \"fa:fa-car key\": \"fa:fa-car value that is long enough to need more than a single line of the box\"\n}\nactor A\nnote for A \"fa:fa-car note\"\n",
      icons=host([("fa:fa-car", "<path id=\"car\"/>")]),
    ),
    content="<svg xmlns=\"http://www.w3.org/2000/svg\" class=\"pele pele-usecase\" viewBox=\"0 0 439 195\" width=\"439\" height=\"195\" style=\"max-width:100%;height:auto;--_bg:var(--pele-bg,#fff);--_fg:var(--pele-fg,#1f1f1f);--_m:var(--pele-muted,#6e6e6e);--_l:var(--pele-line,#1f1f1f);--_s:var(--pele-surface,#f3f3f3);--_a:var(--pele-surface-alt,#e6e6e6);--_b:var(--pele-border,#8a8a8a);--_c:var(--pele-accent,#5b7bd5);color:var(--_fg);--_r:var(--pele-radius,4px);--_hw:var(--pele-heading-weight,bold);--_fm:var(--pele-font-mono,monospace);font:16px sans-serif;letter-spacing:normal;word-spacing:normal;text-transform:none;direction:ltr;font-family:var(--pele-font,sans-serif)\" fill=\"var(--_fg)\" role=\"graphics-document document\" aria-roledescription=\"usecase\"><g class=\"pele-edges\" fill=\"none\" stroke=\"var(--_l)\" stroke-linecap=\"round\"><g class=\"pele-edge pele-note\" data-id=\"note-0-edge\"><path d=\"M200.73,53C294.27,53 294.27,38 387.82,38\" stroke-dasharray=\"2 3\"/></g></g><g class=\"pele-nodes\"><g class=\"pele-node pele-actor usecase-actor usecase-actor-normal\" data-id=\"A\" transform=\"translate(410.82,53)\"><g class=\"pele-actor-figure\" transform=\"translate(0,-15)\"><circle cy=\"-21\" r=\"9\" fill=\"var(--_s)\" stroke=\"var(--_b)\"/><path d=\"M0,-12V10M-14,-3H14M0,10L-12,30M0,10L12,30\" fill=\"none\" stroke=\"var(--_b)\"/></g><text class=\"pele-label\" x=\"0\" y=\"38.6\" text-anchor=\"middle\">A</text></g><g class=\"pele-node pele-note usecase-note\" data-id=\"note-0\" transform=\"translate(163.41,53)\"><path d=\"M-37.32,-19.5H28.32L37.32,-10.5V19.5H-37.32Z\" fill=\"var(--_a)\" stroke=\"var(--_b)\" stroke-linejoin=\"round\"/><path d=\"M28.32,-19.5V-10.5H37.32\" fill=\"none\" stroke=\"var(--_b)\" stroke-linejoin=\"round\"/><text class=\"pele-label\" font-size=\"14\" text-anchor=\"middle\" xml:space=\"preserve\"><tspan x=\"-6.82\" y=\"4.9\" text-anchor=\"start\"> note</tspan></text><svg class=\"pele-icon\" data-icon=\"fa:fa-car\" x=\"-24.32\" y=\"-7.7