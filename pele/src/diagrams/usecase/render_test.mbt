  )
}

///|
test "render_usecase: a diagram that runs across turned to run down on a narrow host" {
  inspect(
    svg_of(
      "usecase-beta\nactor A\nA --> B\nB --> C\nC --> D\nD --> E\nE --> F",
      max_width=400,
    ),
    content="<svg xmlns=\"http://www.w3.org/2000/svg\" class=\"pele pele-usecase\" viewBox=\"0 0 104 726\" width=\"104\" height=\"726\" style=\"max-width:100%;height:auto;--_bg:var(--pele-bg,#fff);--_fg:var(--pele-fg,#1f1f1f);--_m:var(--pele-muted,#6e6e6e);--_l:var(--pele-line,#1f1f1f);--_s:var(--pele-surface,#f3f3f3);--_a:var(--pele-surface-alt,#e6e6e6);--_b:var(--pele-border,#8a8a8a);--_c:var(--pele-accent,#5b7bd5);color:var(--_fg);--_fm:var(--pele-font-mono,monospace);font:16px sans-serif;letter-spacing:normal;word-spacing:normal;text-transform:none;direction:ltr;font-family:var(--pele-font,sans-serif)\" fill=\"var(--_fg)\" role=\"graphics-document document\" aria-roledescription=\"usecase\"><g class=\"pele-edges\" fill=\"none\" stroke=\"var(--_l)\" stroke-linecap=\"round\"><g class=\"pele-edge pele-association\" data-id=\"edge-0\"><path d=\"M52,100L52,163\"/><path class=\"pele-marker\" d=\"M52,170L48.64,162L55.36,162Z\" fill=\"var(--_l)\" stroke=\"none\"/></g><g class=\"pele-edge pele-association\" data-id=\"edge-1\"><path d=\"M52,222L52,287\"/><path class=\"pele-marker\" d=\"M52,294L48.64,286L55.36,286Z\" fill=\"var(--_l)\" stroke=\"none\"/></g><g class=\"pele-edge pele-association\" data-id=\"edge-2\"><path d=\"M52,346L52,411\"/><path class=\"pele-marker\" d=\"M52,418L48.64,410L55.36,410Z\" fill=\"var(--_l)\" stroke=\"none\"/></g><g class=\"pele-edge pele-association\" data-id=\"edge-3\"><path d=\"M52,470L52,535\"/><path class=\"pele-marker\" d=\"M52,542L48.64,534L55.36,534Z\" fill=\"var(--_l)\" stroke=\"none\"/></g><g class=\"pele-edge pele-association\" data-id=\"edge-4\"><path d=\"M52,594L52,659\"/><path class=\"pele-marker\" d=\"M52,666L48.64,658L55.36,658Z\" fill=\"var(--_l)\" stroke=\"none\"/></g></g><g class=\"pele-nodes\"><g class=\"pele-node pele-actor usecase-actor usecase-actor-normal\" data-id=\"A\" transform=\"translate(52,53)\"><g class=\"pele-actor-figure\" transform=\"translate(0,-15)\"><circle cy=\"-21\" r=\"9\" fill=\"var(--_s)\" stroke=\"var