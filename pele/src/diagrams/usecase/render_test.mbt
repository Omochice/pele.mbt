// The expected documents were taken from pele's render.

///|
/// The document drawn for a source, or the message of the error.
fn svg_of(
  source : String,
  max_width? : Double,
  icons? : @types.IconResolver,
) -> String {
  let options = { ..@types.RenderOptions::default(), max_width, icons, }
  @core.render([@usecase.usecase], source, options).svg catch {
    @errors.PeleError(failure) => failure.message
  }
}

///|
test "render_usecase: actors of each kind, with stereotypes and business slashes" {
  inspect(
    svg_of(
      "usecase-beta\nactor N(\"Normal one\")\nactor H@{ type: hollow }\nactor W@{ type: awesome }\nactor I@{ icon: \"fa:user\" } <<Bot>>\nactor B@{ business: true }\nactor C@{ type: hollow, business: true }",
    ),
    content="<svg xmlns=\"http://www.w3.org/2000/svg\" class=\"pele pele-usecase\" viewBox=\"0 0 99 736\" width=\"99\" height=\"736\" style=\"max-width:100%;height:auto;--_bg:var(--pele-bg,#fff);--_fg:var(--pele-fg,#1f1f1f);--_m:var(--pele-muted,#6e6e6e);--_l:var(--pele-line,#1f1f1f);--_s:var(--pele-surface,#f3f3f3);--_a:var(--pele-surface-alt,#e6e6e6);--_b:var(--pele-border,#8a8a8a);--_c:var(--pele-accent,#5b7bd5);color:var(--_fg);--_r:var(--pele-radius,4px);--_fm:var(--pele-font-mono,monospace);font:16px sans-serif;letter-spacing:normal;word-spacing:normal;text-transform:none;direction:ltr;font-family:var(--pele-font,sans-serif)\" fill=\"var(--_fg)\" role=\"graphics-document document\" aria-roledescription=\"usecase\"><g class=\"pele-nodes\"><g class=\"pele-node pele-actor usecase-actor usecase-actor-normal\" data-id=\"N\" transform=\"translate(49.34,53)\"><g class=\"pele-actor-figure\" transform=\"translate(0,-15)\"><circle cy=\"-21\" r=\"9\" fill=\"var(--_s)\" stroke=\"var(--_b)\"/><path d=\"M0,-12V10M-14,-3H14M0,10L-12,30M0,10L12,30\" fill=\"none\" stroke=\"var(--_b)\"/></g><text class=\"pele-label\" x=\"0\" y=\"38.6\" text-anchor=\"middle\">Normal one</text></g><g class=\"pele-node pele-actor usecase-actor usecase-actor-hollow\" data-id=\"H\" transform=\"translate(49.34,175)\"><g class=\"pele-actor-figure\" transform=\"translate(0,-15)\"><circle cy=\"-21\" r=\"8\" fill=\"var(--_bg)\" stroke=\"var(--_b)\"/><path d=\"M-20,-9H20V0H5.5L20,15.5L12,25.5L0,12L-12,25.5L-20,15.5L-5.5,0H-20Z\" fill=\"var(--_bg)\" stroke=\"var(--_b)\" stroke-linejoin=\"round\"/></g><text class=\"pele-label\" x=\"0\" y=\"38.6\" text-anchor=\"middle\">H</text></g><g class=\"pele-node pele-actor usecase-actor usecase-actor-awesome\" data-id=\"W\" transform=\"translate(49.34,297)\"><g class=\"pele-actor-figure\" transform=\"translate(0,-15)\"><path d=\"M0,-30A11,11 0 1 1 0,-8A11,11 0 1 1 0,-30ZM-20,25C-20,9 -12,-3 0,-3C12,-3 20,9 20,25C20,28 18,30 15,30H-15C-18,30 -20,28 -20,25Z\" fill=\"var(--_b)\"/></g><text class=\"pele-label\" x=\"0\" y=\"38.6\" text-anchor=\"middle\">W</text></g><g class=\"pele-node pele-actor usecase-actor usecase-actor-icon\" data-id=\"I\" transform=\"translate(49.34,429)\"><g class=\"pele-actor-figure\" transform=\"translate(0,-25)\"><rect x=\"-22\" y=\"-26\" width=\"44\" height=\"44\" fill=\"var(--_s)\" stroke=\"var(--_b)\" style=\"rx:var(--_r)\"/><svg class=\"pele-icon\" data-icon=\"fa:user\" x=\"-14\" y=\"-18\" width=\"28\" height=\"28\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"></svg></g><text class=\"pele-stereotype\" font-size=\"13\" fill=\"var(--_m)\" x=\"0\" y=\"25.55\" text-anchor=\"middle\">«Bot»</text><text class=\"pele-label\" x=\"0\" y=\"48.6\" text-anchor=\"middle\">I</text></g><g class=\"pele-node pele-actor usecase-actor usecase-actor-normal usecase-business\" data-id=\"B\" transform=\"translate(49.34,561)\"><g class=\"pele-actor-figure\" transform=\"translate(0,-15)\"><circle cy=\"-21\" r=\"9\" fill=\"var(--_s)\" stroke=\"var(--_b)\"/><path d=\"M0,-12V10M-14,-3H14M0,10L-12,30M0,10L12,30\" fill=\"none\" stroke=\"var(--_b)\"/><path class=\"pele-business\" d=\"M1.08,-12.09L8.28,-24.51\" fill=\"none\" stroke=\"var(--_b)\"/></g><text class=\"pele-label\" x=\"0\" y=\"38.6\" text-anchor=\"middle\">B</text></g><g class=\"pele-node pele-actor usecase-actor usecase-actor-hollow usecase-business\" data-id=\"C\" transform=\"translate(49.34,683)\"><g class=\"pele-actor-figure\" transform=\"translate(0,-15)\"><circle cy=\"-21\" r=\"8\" fill=\"var(--_bg)\" stroke=\"var(--_b)\"/><path d=\"M-20,-9H20V0H5.5L20,15.5L12,25.5L0,12L-12,25.5L-20,15.5L-5.5,0H-20Z\" fill=\"var(--_bg)\" stroke=\"var(--_b)\" stroke-linejoin=\"round\"/><path class=\"pele-business\" d=\"M0.96,-13.08L7.36,-24.12\" fill=\"none\" stroke=\"var(--_b)\"/></g><text class=\"pele-label\" x=\"0\" y=\"38.6\" text-anchor=\"middle\">C</text></g></g></svg>",
  )
}

///|
test "render_usecase: use cases as ovals, boxes and business ovals" {
  inspect(
    svg_of(
      "usecase-beta\nLogin(\"Sign in\")\nReport[Generate report]\n\"Reset password\"\nU(Use)@{ business: true } <<Core>>\nV(\"`**bold** and *italic*`\")\nA(\"*n* <b>x</b> \\n &amp;\")",
    ),
    content="<svg xmlns=\"http://www.w3.org/2000/svg\" class=\"pele pele-usecase\" viewBox=\"0 0 222 504\" width=\"222\" height=\"504\" style=\"max-width:100%;height:auto;--_bg:var(--pele-bg,#fff);--_fg:var(--pele-fg,#1f1f1f);--_m:var(--pele-muted,#6e6e6e);--_l:var(--pele-line,#1f1f1f);--_s:var(--pele-surface,#f3f3f3);--_a:var(--pele-surface-alt,#e6e6e6);--_b:var(--pele-border,#8a8a8a);--_c:var(--pele-accent,#5b7bd5);color:var(--_fg);--_r:var(--pele-radius,4px);--_w:var(--pele-bold-weight,bold);--_fm:var(--pele-font-mono,monospace);font:16px sans-serif;letter-spacing:normal;word-spacing:normal;text-transform:none;direction:ltr;font-family:var(--pele-font,sans-serif)\" fill=\"var(--_fg)\" role=\"graphics-document document\" aria-roledescription=\"usecase\"><g class=\"pele-nodes\"><g class=\"pele-node pele-usecase usecase-element usecase-ellipse\" data-id=\"Login\" transform=\"translate(110.94,34)\"><ellipse rx=\"46.46\" ry=\"26\" fill=\"var(--_s)\" stroke=\"var(--_b)\"/><text class=\"pele-label\" x=\"0\" y=\"5.6\" text-anchor=\"middle\">Sign in</text></g><g class=\"pele-node pele-usecase usecase-element usecase-rect\" data-id=\"Report\" transform=\"translate(110.94,116)\"><rect x=\"-72.47\" y=\"-24\" width=\"144.94\" height=\"48\" fill=\"var(--_s)\" stroke=\"var(--_b)\" style=\"rx:var(--_r)\"/><text class=\"pele-label\" x=\"0\" y=\"5.6\" text-anchor=\"middle\">Generate report</text></g><g class=\"pele-node pele-usecase usecase-element usecase-ellipse\" data-id=\"Reset_password\" transform=\"translate(110.94,198)\"><ellipse rx=\"79.35\" ry=\"26\" fill=\"var(--_s)\" stroke=\"var(--_b)\"/><text class=\"pele-label\" x=\"0\" y=\"5.6\" text-anchor=\"middle\">Reset password</text></g><g class=\"pele-node pele-usecase usecase-element usecase-ellipse usecase-business\" data-id=\"U\" transform=\"translate(110.94,292)\"><ellipse rx=\"49.63\" ry=\"36\" fill=\"var(--_s)\" stroke=\"var(--_b)\"/><path class=\"pele-business\" d=\"M34.63,25.79L44.63,-15.75\" fill=\"none\" stroke=\"var(--_b)\"/><text class=\"pele-stereotype\" font-size=\"13\" fill=\"var(--_m)\" x=\"0\" y=\"-7.45\" text-anchor=\"middle\">«Core»</text><text class=\"pele-label\" x=\"0\" y=\"15.6\" text-anchor=\"middle\">Use</text></g><g class=\"pele-node pele-usecase usecase-element usecase-ellipse\" data-id=\"V\" transform=\"translate(110.94,386)\"><ellipse rx=\"72.68\" ry=\"26\" fill=\"var(--_s)\" stroke=\"var(--_b)\"/><text class=\"pele-label\" text-anchor=\"middle\" xml:space=\"preserve\"><tspan x=\"0\" y=\"5.6\" font-weight=\"var(--_w)\">bold</tspan><tspan> and </tspan><tspan font-style=\"italic\">italic</tspan></text></g><g class=\"pele-node pele-usecase usecase-element usecase-ellipse\" data-id=\"A\" transform=\"translate(110.94,470)\"><ellipse rx=\"102.94\" ry=\"26\" fill=\"var(--_s)\" stroke=\"var(--_b)\"/><text class=\"pele-label\" x=\"0\" y=\"5.6\" text-anchor=\"middle\">*n* &lt;b&gt;x&lt;/b&gt; \\n &amp;amp;</text></g></g></svg>",
  )
}

///|
test "render_usecase: boundaries around their members, with titles clear of the edges" {
  inspect(
    svg_of(
      "usecase-beta\nactor User\nactor Bank\nsystemBoundary Shop[\"The shop\"]\n  Browse\n  Pay\n  actor Clerk\nend\nUser --> Browse\nUser --> Pay\nPay --> Bank\nClerk --> Pay",
    ),
    content="<svg xmlns=\"http://www.w3.org/2000/svg\" class=\"pele pele-usecase\" viewBox=\"0 0 530 266\" width=\"530\" height=\"266\" style=\"max-width:100%;height:auto;--_bg:var(--pele-bg,#fff);--_fg:var(--pele-fg,#1f1f1f);--_m:var(--pele-muted,#6e6e6e);--_l:var(--pele-line,#1f1f1f);--_s:var(--pele-surface,#f3f3f3);--_a:var(--pele-surface-alt,#e6e6e6);--_b:var(--pele-border,#8a8a8a);--_c:var(--pele-accent,#5b7bd5);color:var(--_fg);--_r:var(--pele-radius,4px);--_fm:var(--pele-font-mono,monospace);font:16px sans-serif;letter-spacing:normal;word-spacing:normal;text-transform:none;direction:ltr;font-family:var(--pele-font,sans-serif)\" fill=\"var(--_fg)\" role=\"graphics-document document\" aria-roledescription=\"usecase\"><g class=\"pele-clusters\"><g class=\"pele-cluster pele-boundary system-boundary system-boundary-rect\" data-id=\"Shop\"><rect x=\"120\" y=\"8\" width=\"289.34\" height=\"250\" fill=\"var(--_a)\" fill-opacity=\"0.5\" stroke=\"var(--_b)\" style=\"rx:var(--_r)\"/><text class=\"pele-cluster-label\" fill=\"var(--_m)\" x=\"264.67\" y=\"33.6\" text-anchor=\"middle\">The shop</text></g></g><g class=\"pele-edges\" fill=\"none\" stroke=\"var(--_l)\" stroke-linecap=\"round\"><g class=\"pele-edge pele-association\" data-id=\"edge-0\"><path d=\"M51,77C85.5,77 85.5,74 120,74L265,74\"/><path class=\"pele-marker\" d=\"M272,74L264,77.36L264,70.64Z\" fill=\"var(--_l)\" stroke=\"none\"/></g><g class=\"pele-edge pele-association\" data-id=\"edge-1\"><path d=\"M51,91C85.5,91 85.5,124 120,124L200,124C232.65,124 232.65,151.5 265.3,151.5L271.3,151.5\"/><path class=\"pele-marker\" d=\"M278.3,151.5L270.3,154.86L270.3,148.14Z\" fill=\"var(--_l)\" stroke=\"none\"/></g><g class=\"pele-edge pele-association\" data-id=\"edge-2\"><path d=\"M364.67,158.5L409.34,158.5C437.34,158.5 437.34,143.5 465.34,143.5L471.34,143.5\"/><path class=\"pele-marker\" d=\"M478.34,143.5L470.34,146.86L470.34,140.14Z\" fill=\"var(--_l)\" stroke=\"none\"/></g><g class=\"pele-edge pele-association\" data-id=\"edge-3\"><path d=\"M203,178C234.15,178 234.15,165.5 265.3,165.5L271.3,165.5\"/><path class=\"pele-marker\" d=\"M278.3,165.5L270.3,168.86L270.3,162.14Z\" fill=\"var(--_l)\" stroke=\"none\"/></g></g><g class=\"pele-nodes\"><g class=\"pele-node pele-actor usecase-actor usecase-actor-normal\" data-id=\"User\" transform=\"translate(28,99)\"><g class=\"pele-actor-figure\" transform=\"translate(0,-15)\"><circle cy=\"-21\" r=\"9\" fill=\"var(--_s)\" stroke=\"var(--_b)\"/><path d=\"M0,-12V10M-14,-3H14M0,10L-12,30M0,10L12,30\" fill=\"none\" stroke=\"var(--_b)\"/></g><text class=\"pele-label\" x=\"0\" y=\"38.6\" text-anchor=\"middle\">User</text></g><g class=\"pele-node pele-actor usecase-actor usecase-actor-normal\" data-id=\"Bank\" transform=\"translate(501.34,158.5)\"><g class=\"pele-actor-figure\" transform=\"translate(0,-15)\"><circle cy=\"-21\" r=\"9\" fill=\"var(--_s)\" stroke=\"var(--_b)\"/><path d=\"M0,-12V10M-14,-3H14M0,10L-12,30M0,10L12,30\" fill=\"none\" stroke=\"var(--_b)\"/></g><text class=\"pele-label\" x=\"0\" y=\"38.6\" text-anchor=\"middle\">Bank</text></g><g class=\"pele-node pele-actor usecase-actor usecase-actor-normal\" data-id=\"Clerk\" transform=\"translate(180,193)\"><g class=\"pele-actor-figure\" transform=\"translate(0,-15)\"><circle cy=\"-21\" r=\"9\" fill=\"var(--_s)\" stroke=\"var(--_b)\"/><path d=\"M0,-12V10M-14,-3H14M0,10L-12,30M0,10L12,30\" fill=\"none\" stroke=\"var(--_b)\"/></g><text class=\"pele-label\" x=\"0\" y=\"38.6\" text-anchor=\"middle\">Clerk</text></g><g class=\"pele-node pele-usecase usecase-element usecase-ellipse\" data-id=\"Browse\" transform=\"translate(320.67,74)\"><ellipse rx=\"48.67\" ry=\"26\" fill=\"var(--_s)\" stroke=\"var(--_b)\"/><text class=\"pele-label\" x=\"0\" y=\"5.6\" text-anchor=\"middle\">Browse</text></g><g class=\"pele-node pele-usecase usecase-element usecase-ellipse\" data-id=\"Pay\" transform=\"translate(320.67,158.5)\"><ellipse rx=\"44\" ry=\"26\" fill=\"var(--_s)\" stroke=\"var(--_b)\"/><text class=\"pele-label\" x=\"0\" y=\"5.6\" text-anchor=\"middle\">Pay</text></g></g></svg>",
  )
  inspect(
    svg_of(
      "usecase-beta\nsystemBoundary P[\"Payments\"]@{ type: package }\n  Pay\nend\nactor A\nA --> Pay",
    ),
    content="<svg xmlns=\"http://www.w3.org/2000/svg\" class=\"pele pele-usecase\" viewBox=\"0 0 276 140\" width=\"276\" height=\"140\" style=\"max-width:100%;height:auto;--_bg:var(--pele-bg,#fff);--_fg:var(--pele-fg,#1f1f1f);--_m:var(--pele-muted,#6e6e6e);--_l:var(--pele-line,#1f1f1f);--_s:var(--pele-surface,#f3f3f3);--_a:var(--pele-surface-alt,#e6e6e6);--_b:var(--pele-border,#8a8a8a);--_c:var(--pele-accent,#5b7bd5);color:var(--_fg);--_fm:var(--pele-font-mono,monospace);font:16px sans-serif;letter-spacing:normal;word-spacing:normal;text-transform:none;direction:ltr;font-family:var(--pele-font,sans-serif)\" fill=\"var(--_fg)\" role=\"graphics-document document\" aria-roledescription=\"usecase\"><g class=\"pele-clusters\"><g class=\"pele-cluster pele-boundary system-boundary system-boundary-package\" data-id=\"P\"><rect class=\"pele-boundary-tab\" x=\"120\" y=\"8\" width=\"91.14\" height=\"36\" fill=\"var(--_a)\" fill-opacity=\"0.5\" stroke=\"var(--_b)\"/><rect x=\"120\" y=\"44\" width=\"148\" height=\"88\" fill=\"var(--_a)\" fill-opacity=\"0.5\" stroke=\"var(--_b)\"/><text class=\"pele-cluster-label\" fill=\"var(--_m)\" x=\"165.57\" y=\"31.6\" text-anchor=\"middle\">Payments</text></g></g><g class=\"pele-edges\" fill=\"none\" stroke=\"var(--_l)\" stroke-linecap=\"round\"><g class=\"pele-edge pele-association\" data-id=\"edge-0\"><path d=\"M51,71C85.5,71 85.5,86 120,86L153,86\"/><path class=\"pele-marker\" d=\"M160,86L152,89.36L152,82.64Z\" fill=\"var(--_l)\" stroke=\"none\"/></g></g><g class=\"pele-nodes\"><g class=\"pele-node pele-actor usecase-actor usecase-actor-normal\" data-id=\"A\" transform=\"translate(28,86)\"><g class=\"pele-actor-figure\" transform=\"translate(0,-15)\"><circle cy=\"-21\" r=\"9\" fill=\"var(--_s)\" stroke=\"var(--_b)\"/><path d=\"M0,-12V10M-14,-3H14M0,10L-12,30M0,10L12,30\" fill=\"none\" stroke=\"var(--_b)\"/></g><text class=\"pele-label\" x=\"0\" y=\"38.6\" text-anchor=\"middle\">A</text></g><g class=\"pele-node pele-usecase usecase-element usecase-ellipse\" data-id=\"Pay\" transform=\"translate(204,86)\"><ellipse rx=\"44\" ry=\"26\" fill=\"var(--_s)\" stroke=\"var(--_b)\"/><text class=\"pele-label\" x=\"0\" y=\"5.6\" text-anchor=\"middle\">Pay</text></g></g></svg>",
  )
}

///|
test "render_usecase: relationships with markers, labels and semantic kinds" {
  inspect(
    svg_of(
      "usecase-beta\nA a@--> B\nA b@<-- B\nA c@-- B\nA d@--o B\nA e@o-- B\nA f@--x B\nA g@x-- B",
    ),
    content="<svg xmlns=\"http://www.w3.org/2000/svg\" class=\"pele pele-usecase\" viewBox=\"0 0 264 112\" width=\"264\" height=\"112\" style=\"max-width:100%;height:auto;--_bg:var(--pele-bg,#fff);--_fg:var(--pele-fg,#1f1f1f);--_m:var(--pele-muted,#6e6e6e);--_l:var(--pele-line,#1f1f1f);--_s:var(--pele-surface,#f3f3f3);--_a:var(--pele-surface-alt,#e6e6e6);--_b:var(--pele-border,#8a8a8a);--_c:var(--pele-accent,#5b7bd5);color:var(--_fg);--_fm:var(--pele-font-mono,monospace);font:16px sans-serif;letter-spacing:normal;word-spacing:normal;text-transform:none;direction:ltr;font-family:var(--pele-font,sans-serif)\" fill=\"var(--_fg)\" role=\"graphics-document document\" aria-roledescription=\"usecase\"><g class=\"pele-edges\" fill=\"none\" stroke=\"var(--_l)\" stroke-linecap=\"round\"><g class=\"pele-edge pele-association\" data-id=\"a\"><path d=\"M87.2,40.4C109.6,40.4 109.6,8 132,8C147.9,8 147.9,40.4 163.8,40.4L169.8,40.4\"/><path class=\"pele-marker\" d=\"M176.8,40.4L168.8,43.76L168.8,37.04Z\" fill=\"var(--_l)\" stroke=\"none\"/></g><g class=\"pele-edge pele-association\" data-id=\"b\"><path d=\"M99.33,45.6L105.33,45.6C118.66,45.6 118.66,24 132,24C151.84,24 151.84,45.6 171.67,45.6\"/><path class=\"pele-marker\" d=\"M92.33,45.6L100.33,42.24L100.33,48.96Z\" fill=\"var(--_l)\" stroke=\"none\"/></g><g class=\"pele-edge pele-association\" data-id=\"c\"><path d=\"M95.11,50.8C113.56,50.8 113.56,40 132,40C150.44,40 150.44,50.8 168.89,50.8\"/></g><g class=\"pele-edge pele-association\" data-id=\"d\"><path d=\"M96,56L160,56\"/><circle class=\"pele-marker\" cx=\"164\" cy=\"56\" r=\"3.5\" fill=\"var(--_l)\" stroke=\"none\"/></g><g class=\"pele-edge pele-association\" data-id=\"e\"><path d=\"M103.11,61.2L109.11,61.2C120.56,61.2 120.56,72 132,72C150.44,72 150.44,61.2 168.89,61.2\"/><circle class=\"pele-marker\" cx=\"99.11\" cy=\"61.2\" r=\"3.5\" fill=\"var(--_l)\" stroke=\"none\"/></g><g class=\"pele-edge pele-association\" data-id=\"f\"><path d=\"M92.33,66.4C112.16,66.4 112.16,88 132,88C146.84,88 146.84,66.4 161.67,66.4L167.67,66.4\"/><path class=\"pele-marker\" d=\"M164.17,62.9L171.17,69.9M164.17,69.9L171.17,62.9\"/></g><g class=\"pele-edge pele-association\" data-id=\"g\"><path d=\"M91.2,71.6L97.2,71.6C114.6,71.6 114.6,104 132,104C154.4,104 154.4,71.6 176.8,71.6\"/><path class=\"pele-marker\" d=\"M94.7,75.1L87.7,68.1M94.7,68.1L87.7,75.1\"/></g></g><g class=\"pele-nodes\"><g class=\"pele-node pele-usecase usecase-element usecase-ellipse\" data-id=\"A\" transform=\"translate(52,56)\"><ellipse rx=\"44\" ry=\"26\" fill=\"var(--_s)\" stroke=\"var(--_b)\"/><text class=\"pele-label\" x=\"0\" y=\"5.6\" text-anchor=\"middle\">A</text></g><g class=\"pele-node pele-usecase usecase-element usecase-ellipse\" data-id=\"B\" transform=\"translate(212,56)\"><ellipse rx=\"44\" ry=\"26\" fill=\"var(--_s)\" stroke=\"var(--_b)\"/><text class=\"pele-label\" x=\"0\" y=\"5.6\" text-anchor=\"middle\">B</text></g></g></svg>",
  )
  inspect(
    svg_of(
      "usecase-beta\nactor User\nUser -- \"starts a session\" --> Login\nLogin ..> : include Auth\nAudit ..> : extend Login\nactor Admin\nAdmin --|> User\nLogin ----> Far",
    ),
    content="<svg xmlns=\"http://www.w3.org/2000/svg\" class=\"pele pele-usecase\" viewBox=\"0 0 956 190\" width=\"956\" height=\"190\" style=\"max-width:100%;height:auto;--_bg:var(--pele-bg,#fff);--_fg:var(--pele-fg,#1f1f1f);--_m:var(--pele-muted,#6e6e6e);--_l:var(--pele-line,#1f1f1f);--_s:var(--pele-surface,#f3f3f3);--_a:var(--pele-surface-alt,#e6e6e6);--_b:var(--pele-border,#8a8a8a);--_c:var(--pele-accent,#5b7bd5);color:var(--_fg);--_fm:var(--pele-font-mono,monospace);font:16px sans-serif;letter-spacing:normal;word-spacing:normal;text-transform:none;direction:ltr;font-family:var(--pele-font,sans-serif)\" fill=\"var(--_fg)\" role=\"graphics-document document\" aria-roledescription=\"usecase\"><g class=\"pele-edges\" fill=\"none\" stroke=\"var(--_l)\" stroke-linecap=\"round\"><g class=\"pele-edge pele-association\" data-id=\"edge-0\"><path d=\"M192.34,38C220.84,38 220.84,53 249.34,53L358.6,53C370.91,53 370.91,97.5 383.23,97.5L389.23,97.5\"/><path class=\"pele-marker\" d=\"M396.23,97.5L388.23,100.86L388.23,94.14Z\" fill=\"var(--_l)\" stroke=\"none\"/></g><g class=\"pele-edge pele-include\" data-id=\"edge-1\"><path d=\"M480.98,97.5C499.79,97.5 499.79,79.5 518.6,79.5L620.19,79.5\" stroke-dasharray=\"5 4\"/><path class=\"pele-marker\" d=\"M627.19,79.5L619.19,82.86L619.19,76.14Z\" fill=\"var(--_l)\" stroke=\"none\"/></g><g class=\"pele-edge pele-extend\" data-id=\"edge-2\"><path d=\"M213.34,156L358.6,156C370.91,156 370.91,111.5 383.23,111.5L389.23,111.5\" stroke-dasharray=\"5 4\"/><path class=\"pele-marker\" d=\"M396.23,111.5L388.23,114.86L388.23,108.14Z\" fill=\"var(--_l)\" stroke=\"none\"/></g><g class=\"pele-edge pele-generalization\" data-id=\"edge-3\"><path d=\"M53.67,38L134.34,38\"/><path class=\"pele-marker\" d=\"M146.34,38L134.34,44L134.34,32Z\" fill=\"var(--_bg)\" stroke=\"var(--_l)\" stroke-linejoin=\"round\"/></g><g class=\"pele-edge pele-association\" data-id=\"edge-4\"><path d=\"M480.98,111.5C508.86,111.5 508.86,129.5 536.75,129.5L852.19,129.5\"/><path clas