    content="<svg xmlns=\"http://www.w3.org/2000/svg\" class=\"pele pele-usecase\" viewBox=\"0 0 104 354\" width=\"104\" height=\"354\" style=\"max-width:100%;height:auto;--_bg:var(--pele-bg,#fff);--_fg:var(--pele-fg,#1f1f1f);--_m:var(--pele-muted,#6e6e6e);--_l:var(--pele-line,#1f1f1f);--_s:var(--pele-surface,#f3f3f3);--_a:var(--pele-surface-alt,#e6e6e6);--_b:var(--pele-border,#8a8a8a);--_c:var(--pele-accent,#5b7bd5);color:var(--_fg);--_fm:var(--pele-font-mono,monospace);font:16px sans-serif;letter-spacing:normal;word-spacing:normal;text-transform:none;direction:ltr;font-family:var(--pele-font,sans-serif)\" fill=\"var(--_fg)\" role=\"graphics-document document\" aria-roledescription=\"usecase\"><g class=\"pele-edges\" fill=\"none\" stroke=\"var(--_l)\" stroke-linecap=\"round\"><g class=\"pele-edge pele-association\" data-id=\"edge-0\"><path d=\"M52,254L52,191\"/><path class=\"pele-marker\" d=\"M52,184L55.36,192L48.64,192Z\" fill=\"var(--_l)\" stroke=\"none\"/></g><g class=\"pele-edge pele-association\" data-id=\"edge-1\"><path d=\"M52,132L52,67\"/><path class=\"pele-marker\" d=\"M52,60L55.36,68L48.64,68Z\" fill=\"var(--_l)\" stroke=\"none\"/></g></g><g class=\"pele-nodes\"><g class=\"pele-node pele-actor usecase-actor usecase-actor-normal\" data-id=\"A\" transform=\"translate(52,301)\"><g class=\"pele-actor-figure\" transform=\"translate(0,-15)\"><circle cy=\"-21\" r=\"9\" fill=\"var(--_s)\" stroke=\"var(--_b)\"/><path d=\"M0,-12V10M-14,-3H14M0,10L-12,30M0,10L12,30\" fill=\"none\" stroke=\"var(--_b)\"/></g><text class=\"pele-label\" x=\"0\" y=\"38.6\" text-anchor=\"middle\">A</text></g><g class=\"pele-node pele-usecase usecase-element usecase-ellipse\" data-id=\"B\" transform=\"translate(52,158)\"><ellipse rx=\"44\" ry=\"26\" fill=\"var(--_s)\" stroke=\"var(--_b)\"/><text class=\"pele-label\" x=\"0\" y=\"5.6\" text-anchor=\"middle\">B</text></g><g class=\"pele-node pele-usecase usecase-element usecase-ellipse\" data-id=\"C\" transform=\"translate(52,34)\"><ellipse rx=\"44\" ry=\"26\" fill=\"var(--_s)\" stroke=\"var(--_b)\"/><text class=\"pele-label\" x=\"0\" y=\"5.6\" text-anchor=\"middle\">C</text></g></g></svg>",
