{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: [
    "github>Omochice/personal-renovate-config#v3.0.0",
    "github>Omochice/personal-renovate-config:nix#v3.0.0",
  ],
  customManagers: [
    {
      customType: "regex",
      description: "Registry dependencies pinned in moon.mod",
      managerFilePatterns: ["*/moon.mod"],
      matchStrings: ['"(?<depName>[^"@\\s/]+/[^"@\\s/]+)@(?<currentValue>\\d+\\.\\d+\\.\\d+[^"\\s]*)"'],
      datasourceTemplate: "custom.mooncakes",
      versioningTemplate: "semver",
    },
    {
      customType: "regex",
      // The nix manager only re-locks the ref already written in flake.nix, so it never proposes a newer pele tag.
      description: "The pele release the port is compared against",
      managerFilePatterns: ["/^flake\\.nix$/"],
      matchStrings: ['"github:(?<depName>obsidianmd/pele)/(?<currentValue>[^"]+)"'],
      datasourceTemplate: "github-tags",
      versioningTemplate: "semver",
    },
  ],
  customDatasources: {
    mooncakes: {
      defaultRegistryUrlTemplate: "https://mooncakes.io/api/v0/modules/{{packageName}}",
      // The trailing [] keeps a module with a single release an array, which JSONata would otherwise unwrap into an object that Renovate rejects.
      transformTemplates: [
        '{"releases": versions[yanked = false].{"version": version}[], "sourceUrl": metadata.repository}',
      ],
    },
  },
  packageRules: [
    {
      description: "The workspace's own modules resolve to the local members, not to the registry",
      matchDatasources: ["custom.mooncakes"],
      matchPackageNames: ["omochice/**"],
      enabled: false,
    },
    {
      description: "The pele the port is compared against is locked by hand, because a new release also needs its npmDepsHash, regenerated goldens and the port's changes to match them",
      matchManagers: ["nix"],
      matchPackageNames: ["https://github.com/obsidianmd/pele"],
      enabled: false,
    },
    {
      description: "A new pele release is proposed only to announce it; the pull request fails CI until flake.lock, npmDepsHash, the goldens and the port are updated by hand",
      matchManagers: ["custom.regex"],
      matchPackageNames: ["obsidianmd/pele"],
      minimumReleaseAge: "1 day",
    },
  ],
}
