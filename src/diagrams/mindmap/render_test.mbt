///|
fn svg(source : String, max_width? : Double) -> String {
  let options = { ..@types.RenderOptions::default(), max_width, }
  let result = @core.render([@mindmap.mindmap], source, options) catch {
    @errors.PeleError(failure) => return failure.message
  }
  "\{result.width}x\{result.height} \{result.svg}"
}

///|
test "draws a node per line and a link per child" {
  inspect(
    svg("mindmap\n  root((Center))\n    A\n      A1\n      A2\n    B"),
    content="315x86 <svg xmlns=\"http://www.w3.org/2000/svg\" class=\"pele pele-mindmap\" viewBox=\"0 0 315 86\" width=\"315\" height=\"86\" style=\"max-width:100%;height:auto;--_bg:var(--pele-bg,#fff);--_fg:var(--pele-fg,#1f1f1f);--_m:var(--pele-muted,#6e6e6e);--_l:var(--pele-line,#1f1f1f);--_s:var(--pele-surface,#f3f3f3);--_a:var(--pele-surface-alt,#e6e6e6);--_b:var(--pele-border,#8a8a8a);--_c:var(--pele-accent,#5b7bd5);color:var(--_fg);--_fm:var(--pele-font-mono,monospace);font:16px sans-serif;letter-spacing:normal;word-spacing:normal;text-transform:none;direction:ltr;font-family:var(--pele-font,sans-serif)\" fill=\"var(--_fg)\" role=\"graphics-document document\" aria-roledescription=\"mindmap\"><g transform=\"translate(117.51,42.84)\"><g class=\"pele-branch pele-section-0\"><g class=\"pele-edges\" fill=\"none\" stroke=\"var(--pele-series-1,#4c78a8)\" stroke-width=\"1.5\"><path class=\"pele-edge\" d=\"M34.84,0C60.84,0 60.84,0 86.84,0\"/><path class=\"pele-edge\" d=\"M121.51,0C139.51,0 139.51,-16 157.51,-16\"/><path class=\"pele-edge\" d=\"M121.51,0C139.51,0 139.51,16 157.51,16\"/></g><g class=\"pele-node pele-shape-branch\" data-id=\"A\" transform=\"translate(104.18,0)\"><rect x=\"-17.34\" y=\"-15\" width=\"34.67\" height=\"30\" rx=\"15\" fill=\"var(--pele-series-1,#4c78a8)\" fill-opacity=\"0.22\" stroke=\"var(--pele-series-1,#4c78a8)\"/><text class=\"pele-label\" x=\"0\" y=\"5.6\" text-anchor=\"middle\">A</text></g><g class=\"pele-node pele-shape-text\" data-id=\"A1\" transform=\"translate(173.3,-16)\"><text class=\"pele-label\" x=\"0\" y=\"5.6\" text-anchor=\"middle\">A1</text></g><g class=\"pele-node pele-shape-text\" data-id=\"A2\" transform=\"translate(173.3,16)\"><text class=\"pele-label\" x=\"0\" y=\"5.6\" text-anchor=\"middle\">A2</text></g></g><g class=\"pele-branch pele-section-1\"><g class=\"pele-edges\" fill=\"none\" stroke=\"var(--pele-series-2,#f58518)\" stroke-width=\"1.5\"><path class=\"pele-edge\" d=\"M-34.84,0C-60.84,0 -60.84,0 -86.84,0\"/></g><g class=\"pele-node pele-shape-text\" data-id=\"B\" transform=\"translate(-98.18,0)\"><text class=\"pele-label\" x=\"0\" y=\"5.6\" text-anchor=\"middle\">B</text></g></g><g class=\"pele-node pele-shape-circle pele-root\" data-id=\"root\" transform=\"translate(0,0)\"><circle r=\"34.84\" fill=\"var(--_s)\" stroke=\"var(--_b)\"/><text class=\"pele-label\" x=\"0\" y=\"5.6\" text-anchor=\"middle\">Center</text></g></g></svg>",
  )
}

///|
test "maps each pair of delimiters to its shape" {
  inspect(
    svg(
