///|
test "keeps branch sides when a growing final branch reaches a balanced tie" {
  inspect(
    svg(
      "mindmap\n  [root]\n    [Build]\n      [Prototype]\n      [Iterate]\n    [Review]\n      [Test]\n      [Refine]\n    [Ship]\n      [Launch]",
    ),
