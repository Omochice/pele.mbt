///|
test "escapes text, ids and classes" {
  inspect(
    svg(
      "mindmap\n  a<b>\"&[<i onload=x>\"&]\n  ::icon(x\" onload=\"y)\n  :::a\"b <c> d=e",
    ),
    content="69x64 <svg xmlns=\"http://www.w3.org/2000/svg\" class=\"pele pele-mindmap\" viewBox=\"0 0 69 64\" width=\"69\" height=\"64\" style=\"max-width:100%;height:auto;--_bg:var(--pele-bg,#fff);--_fg:var(--pele-fg,#1f1f1f);--_m:var(--pele-muted,#6e6e6e);--_l:var(--pele-line,#1f1f1f);--_s:var(--pele-surface,#f3f3f3);--_a:var(--pele-surface-alt,#e6e6e6);--_b:var(--pele-border,#8a8a8a);--_c:var(--pele-accent,#5b7bd5);color:var(--_fg);--_r:var(--pele-radius,4px);--_fm:var(--pele-font-mono,monospace);font:16px sans-serif;letter-spacing:normal;word-spacing:normal;text-transform:none;direction:ltr;font-family:var(--pele-font,sans-serif)\" fill=\"var(--_fg)\" role=\"graphics-document document\" aria-roledescription=\"mindmap\"><g transform=\"translate(34.18,32)\"><g class=\"pele-node pele-shape-rect pele-root a b c d e\" data-id=\"a&lt;b&gt;&quot;&amp;\" transform=\"translate(0,0)\"><rect x=\"-26.18\" y=\"-24\" width=\"52.35\" height=\"48\" fill=\"var(--_s)\" stroke=\"var(--_b)\" style=\"rx:var(--_r)\"/><text class=\"pele-label\" font-style=\"italic\" text-anchor=\"middle\" xml:space=\"preserve\"><tspan x=\"0\" y=\"5.6\">&quot;&amp;</tspan></text></g></g></svg>",
  )
}

///|
test "ignores a decoration that comes before any node" {
  inspect(
    svg("mindmap\n::icon(fa fa-book)\n:::big\nroot"),
    content="96x64 <svg xmlns=\"http://www.w3.org/2000/svg\" class=\"pele pele-mindmap\" viewBox=\"0 0 96 64\" width=\"96\" height=\"64\" style=\"max-width:100%;height:auto;--_bg:var(--pele-bg,#fff);--_fg:var(--pele-fg,#1f1f1f);--_m:var(--pele-muted,#6e6e6e);--_l:var(--pele-line,#1f1f1f);--_s:var(--pele-surface,#f3f3f3);--_a:var(--pele-surface-alt,#e6e6e6);--_b:var(--pele-border,#8a8a8a);--_c:var(--pele-accent,#5b7bd5);color:var(--_fg);--_fm:var(--pele-font-mono,monospace);font:16px sans-serif;letter-spacing:normal;word-spacing:normal;text-transform:none;direction:ltr;font-family:var(--pele-font,sans-serif)\" fill=\"var(--_fg)\" role=\"graphics-document document\" aria-roledescription=\"mindmap\"><g transform=\"translate(47.78,32)\"><g class=\"pele-node pele-shape-stadium pele-root\" data-id=\"root\" transform=\"translate(0,0)\"><rect x=\"-39.78\" y=\"-24\" width=\"79.57\" height=\"48\" rx=\"24\" fill=\"var(--_s)\" stroke=\"var(--_b)\"/><text class=\"pele-label\" x=\"0\" y=\"5.6\" text-anchor=\"middle\">root</text></g></g></svg>",
  )
}

///|
test "follows Mermaid on unclear indentation" {
  inspect(
    svg("mindmap\nRoot\n    A\n        B\n      C\n   D"),
    content="324x72 <svg xmlns=\"http://www.w3.org/2000/svg\" class=\"pele pele-mindmap\" viewBox=\"0 0 324 72\" width=\"324\" height=\"72\" style=\"max-width:100%;height:auto;--_bg:var(--pele-bg,#fff);--_fg:var(--pele-fg,#1f1f1f);--_m:var(--pele-muted,#6e6e6e);--_l:var(--pele-line,#1f1f1f);--_s:var(--pele-surface,#f3f3f3);--_a:var(--pele-surface-alt,#e6e6e6);--_b:var(--pele-border,#8a8a8a);--_c:var(--pele-accent,#5b7bd5);color:var(--_fg);--_fm:var(--pele-font-mono,monospace);font:16px sans-serif;letter-spacing:normal;word-spacing:normal;text-transform:none;direction:ltr;font-family:var(--pele-font,sans-serif)\" fill=\"var(--_fg)\" role=\"graphics-document document\" aria-roledescription=\"mindmap\"><g transform=\"translate(126.45,36)\"><g class=\"pele-branch pele-section-0\"><g class=\"pele-edges\" fill=\"none\" stroke=\"var(--pele-series-1,#4c78a8)\" stroke-width=\"1.5\"><path class=\"pele-edge\" d=\"M42.9,0C68.9,0 68.9,0 94.9,0\"/><path class=\"pele-edge\" d=\"M129.57,0C147.57,0 147.57,-16 165.57,-16\"/><path class=\"pele-edge\" d=\"M129.57,0C147.57,0 147.57,16 165.57,16\"/></g><g class=\"pele-node pele-shape-branch\" data-id=\"A\" transform=\"translate(112.23,0)\"><rect x=\"-17.34\" y=\"-15\" width=\"34.67\" height=\"30\" rx=\"15\" fill=\"var(--pele-series-1,#4c78a8)\" fill-opacity=\"0.22\" stroke=\"var(--pele-series-1,#4c78a8)\"/><text class=\"pele-label\" x=\"0\" y=\"5.6\" text-anchor=\"middle\">A</text></g><g class=\"pele-node pele-shape-text\" data-id=\"B\" transform=\"translate(176.9,-16)\"><text class=\"pele-label\" x=\"0\" y=\"5.6\" text-anchor=\"middle\">B</text></g><g class=\"pele-node pele-shape-text\" data-id=\"C\" transform=\"translate(177.34,16)\"><text class=\"pele-label\" x=\"0\" y=\"5.6\" text-anchor=\"middle\">C</text></g></g><g class=\"pele-branch pele-section-1\"><g class=\"pele-edges\" fill=\"none\" stroke=\"var(--pele-series-2,#f58518)\" stroke-width=\"1.5\"><path class=\"pele-edge\" d=\"M-42.9,0C-68.9,0 -68.9,0 -94.9,0\"/></g><g class=\"pele-node pele-shape-text\" data-id=\"D\" transform=\"translate(-106.67,0)\"><text class=\"pele-label\" x=\"0\" y=\"5.6\" text-anchor=\"middle\">D</text></g></g><g class=\"pele-node pele-shape-stadium pele-root\" data-id=\"Root\" transform=\"translate(0,0)\"><rect x=\"-42.9\" y=\"-24\" width=\"85.79\" height=\"48\" rx=\"24\" fill=\"var(--_s)\" stroke=\"var(--_b)\"/><text class=\"pele-label\" x=\"0\" y=\"5.6\" text-anchor=\"middle\">Root</text></g></g></svg>",
  )
}

///|
test "an empty node label still takes a line of room" {
  inspect(
    svg("mindmap\n  root\n    a[ ]\n    b"),
    content="269x64 <svg xmlns=\"http://www.w3.org/2000/svg\" class=\"pele pele-mindmap\" viewBox=\"0 0 269 64\" width=\"269\" height=\"64\" style=\"max-width:100%;height:auto;--_bg:var(--pele-bg,#fff);--_fg:var(--pele-fg,#1f1f1f);--_m:var(--pele-muted,#6e6e6e);--_l:var(--pele-line,#1f1f1f);--_s:var(--pele-surface,#f3f3f3);--_a:var(--pele-surface-alt,#e6e6e6);--_b:var(--pele-border,#8a8a8a);--_c:var(--pele-accent,#5b7bd5);color:var(--_fg);--_r:var(--pele-radius,4px);--_fm:var(--pele-font-mono,monospace);font:16px sans-serif;letter-spacing:normal;word-spacing:normal;text-transform:none;direction:ltr;font-family:var(--pele-font,sans-serif)\" fill=\"var(--_fg)\" role=\"graphics-document document\" aria-roledescription=\"mindmap\"><g transform=\"translate(120.68,32)\"><g class=\"pele-branch pele-section-0\"><g class=\"pele-edges\" fill=\"none\" stroke=\"var(--pele-series-1,#4c78a8)\" stroke-width=\"1.5\"><path class=\"pele-edge\" d=\"M39.78,0C65.78,0 65.78,0 91.78,0\"/></g><g class=\"pele-node pele-shape-rect\" data-id=\"a\" transform=\"translate(115.78,0)\"><rect x=\"-24\" y=\"-24\" width=\"48\" height=\"48\" fill=\"var(--pele-series-1,#4c78a8)\" fill-opacity=\"0.22\" stroke=\"var(--pele-series-1,#4c78a8)\" style=\"rx:var(--_r)\"/><text class=\"pele-label\" x=\"0\" y=\"5.6\" text-anchor=\"middle\"></text></g></g><g class=\"pele-branch pele-section-1\"><g class=\"pele-edges\" fill=\"none\" stroke=\"var(--pele-series-2,#f58518)\" stroke-width=\"1.5\"><path class=\"pele-edge\" d=\"M-39.78,0C-65.78,0 -65.78,0 -91.78,0\"/></g><g class=\"pele-node pele-shape-text\" data-id=\"b\" transform=\"translate(-102.23,0)\"><text class=\"pele-label\" x=\"0\" y=\"5.6\" text-anchor=\"middle\">b</text></g></g><g class=\"pele-node pele-shape-stadium pele-root\" data-id=\"root\" transform=\"translate(0,0)\"><rect x=\"-39.78\" y=\"-24\" width=\"79.57\" height=\"48\" rx=\"24\" fill=\"var(--_s)\" stroke=\"var(--_b)\"/><text class=\"pele-label\" x=\"0\" y=\"5.6\" text-anchor=\"middle\">root</text></g></g></svg>",
  )
}

///|
test "a second root is an error" {
  inspect(
    svg("mindmap\n  root\n  other"),
    content="There can be only one root. No parent could be found for (\"other\")",
  )
}
