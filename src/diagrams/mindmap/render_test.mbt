///|
test "formats markdown and breaks lines" {
  inspect(
    svg(
      "mindmap\n  id1[\"`**Root** with\na second line`\"]\n    id2[One<br/>Two]\n    id3[*emphasis*]",
    ),
    content="421x88 <svg xmlns=\"http://www.w3.org/2000/svg\" class=\"pele pele-mindmap\" viewBox=\"0 0 421 88\" width=\"421\" height=\"88\" style=\"max-width:100%;height:auto;--_bg:var(--pele-bg,#fff);--_fg:var(--pele-fg,#1f1f1f);--_m:var(--pele-muted,#6e6e6e);--_l:var(--pele-line,#1f1f1f);--_s:var(--pele-surface,#f3f3f3);--_a:var(--pele-surface-alt,#e6e6e6);--_b:var(--pele-border,#8a8a8a);--_c:var(--pele-accent,#5b7bd5);color:var(--_fg);--_r:var(--pele-radius,4px);--_w:var(--pele-bold-weight,bold);--_fm:var(--pele-font-mono,monospace);font:16px sans-serif;letter-spacing:normal;word-spacing:normal;text-transform:none;direction:ltr;font-family:var(--pele-font,sans-serif)\" fill=\"var(--_fg)\" role=\"graphics-document document\" aria-roledescription=\"mindmap\"><g transform=\"translate(229.6,44)\"><g class=\"pele-branch pele-section-0\"><g class=\"pele-edges\" fill=\"none\" stroke=\"var(--pele-series-1,#4c78a8)\" stroke-width=\"1.5\"><path class=\"pele-edge\" d=\"M65.14,0C91.14,0 91.14,0 117.14,0\"/></g><g class=\"pele-node pele-shape-rect\" data-id=\"id2\" transform=\"translate(150.26,0)\"><rect x=\"-33.12\" y=\"-36\" width=\"66.24\" height=\"72\" fill=\"var(--pele-series-1,#4c78a8)\" fill-opacity=\"0.22\" stroke=\"var(--pele-series-1,#4c78a8)\" style=\"rx:var(--_r)\"/><text class=\"pele-label\" text-anchor=\"middle\" xml:space=\"preserve\"><tspan x=\"0\" y=\"-6.4\">One</tspan><tspan x=\"0\" y=\"17.6\">Two</tspan></text></g></g><g class=\"pele-branch pele-section-1\"><g class=\"pele-edges\" fill=\"none\" stroke=\"var(--pele-series-2,#f58518)\" stroke-width=\"1.5\"><path class=\"pele-edge\" d=\"M-65.14,0C-91.14,0 -91.14,0 -117.14,0\"/></g><g class=\"pele-node pele-shape-rect\" data-id=\"id3\" transform=\"translate(-169.37,0)\"><rect x=\"-52.23\" y=\"-24\" width=\"104.46\" height=\"48\" fill=\"var(--pele-series-2,#f58518)\" fill-opacity=\"0.22\" stroke=\"var(--pele-series-2,#f58518)\" style=\"rx:var(--_r)\"/><text class=\"pele-label\" font-style=\"italic\" text-anchor=\"middle\" xml:space=\"preserve\"><tspan x=\"0\" y=\"5.6\">emphasis</tspan></text></g></g><g class=\"pele-node pele-shape-rect pele-root\" data-id=\"id1\" transform=\"translate(0,0)\"><rect x=\"-65.14\" y=\"-36\" width=\"130.27\" height=\"72\" fill=\"var(--_s)\" stroke=\"var(--_b)\" style=\"rx:var(--_r)\"/><text class=\"pele-label\" text-anchor=\"middle\" xml:space=\"preserve\"><tspan x=\"0\" y=\"-6.4\" font-weight=\"var(--_w)\">Root</tspan><tspan> with</tspan><tspan x=\"0\" y=\"17.6\">a second line</tspan></text></g></g></svg>",
  )
}

///|
