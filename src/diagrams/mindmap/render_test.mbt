e-text\" data-id=\"c\" transform=\"translate(38,164)\"><text class=\"pele-label\" x=\"0\" y=\"5.6\" text-anchor=\"middle\">c</text></g></g><g class=\"pele-node pele-shape-stadium pele-root\" data-id=\"root\" transform=\"translate(39.78,24)\"><rect x=\"-39.78\" y=\"-24\" width=\"79.57\" height=\"48\" rx=\"24\" fill=\"var(--_s)\" stroke=\"var(--_b)\"/><text class=\"pele-label\" x=\"0\" y=\"5.6\" text-anchor=\"middle\">root</text></g></g></svg>",
