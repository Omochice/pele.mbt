///|
test "stays across when the host is at the breakpoint" {
  inspect(
    svg(
      "mindmap\n  root((mindmap))\n    Origins\n      Long history\n      Popularisation\n        British popular psychology author Tony Buzan\n    Research\n      On effectiveness<br/>and features\n      On Automatic creation\n        Uses\n            Creative techniques\n            Strategic planning\n    Tools\n      Pen and paper\n      Mermaid",
      max_width=640,
    ),
