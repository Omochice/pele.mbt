///|
/// A host that has exactly the icons in `pairs`, by name.
fn host(pairs : Array[(String, String)]) -> @types.IconResolver {
  let icons = Map::from_array(pairs)
  name => icons.get(name)
}

///|
/// The size and drawing of `source` for a host with `icons`, or the message of its error.
fn with_icons(source : String, icons~ : @types.IconResolver) -> String {
  let options = { ..@types.RenderOptions::default(), icons: Some(icons), }
  let result = @core.render([@state.state], source, options) catch {
    @errors.PeleError(failure) => return failure.message
  }
  "\{result.width}x\{result.height} \{result.svg}"
}

///|
test "states, groups, notes and edge labels draw the host's icons" {
  inspect(
    with_icons(
      "stateDiagram-v2\n  s1 : fa:fa-car First\n  s1 --> s2 : fa:fa-car go\n  state \"fa:fa-car Group\" as g {\n    s3 : fa:fa-car x\n  }\n  note right of s1\n    fa:fa-car note\n  end note\n  s2 : fa:fa-car desc line\n",
      icons=host([("fa:fa-car", "<path id=\"car\"/>")]),
    ),
    content="378x241 <svg xmlns=\"http://www.w3.org/2000/svg\" class=\"pele pele-state\" viewBox=\"0 0 378 241\" width=\"378\" height=\"241\" style=\"max-width:100%;height:auto;--_bg:var(--pele-bg,#fff);--_fg:var(--pele-fg,#1f1f1f);--_m:var(--pele-muted,#6e6e6e);--_l:var(--pele-line,#1f1f1f);--_s:var(--pele-surface,#f3f3f3);--_a:var(--pele-surface-alt,#e6e6e6);--_b:var(--pele-border,#8a8a8a);--_c:var(--pele-accent,#5b7bd5);color:var(--_fg);--_fm:var(--pele-font-mono,monospace);font:16px sans-serif;letter-spacing:normal;word-spacing:normal;text-transform:none;direction:ltr;font-family:var(--pele-font,sans-serif)\" fill=\"var(--_fg)\" role=\"graphics-document document\" aria-roledescription=\"state\"><g class=\"pele-clusters\"><g class=\"pele-cluster pele-state-composite\" data-id=\"g\"><rect x=\"268.2\" y=\"8\" width=\"100.91\" height=\"112\" rx=\"10\" fill=\"var(--_a)\" fill-opacity=\"0.5\" stroke=\"var(--_b)\"/><path d=\"M268.2,44H369.12\" fill=\"none\" stroke=\"var(--_b)\"/><text class=\"pele-cluster-label\" text-anchor=\"middle\" xml:space=\"preserve\"><tspan x=\"304.2\" y=\"31.6\" text-anchor=\"start\"> Group</tspan></text><svg class=\"pele-icon\" data-icon=\"fa:fa-car\" x=\"284.2\" y=\"17.2\" width=\"17.6\" height=\"17.6\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path id=\"car\"/></svg></g></g><g class=\"pele-edges\" fill=\"none\" stroke=\"var(--_l)\" stroke-linecap=\"round\"><g class=\"pele-edge pele-transition\" data-id=\"edge0\"><path d=\"M67.79,120L67.79,182\"/><path class=\"pele-marker\" d=\"M67.79,189L64.43,181L71.15,181Z\" fill=\"var(--_l)\" stroke=\"none\"/></g><g class=\"pele-edge pele-note-edge\" stroke=\"var(--_b)\" stroke-dasharray=\"3 4\" data-id=\"s1-s1----note-1\"><path d=\"M111.57,98L155.57,98\"/></g></g><g class=\"pele-edge-labels\" font-size=\"14\"><g class=\"pele-edge-label\" data-id=\"edge0\"><rect x=\"45.31\" y=\"140.5\" width=\"44.96\" height=\"21\" rx=\"3\" fill=\"var(--_bg)\"/><text text-anchor=\"middle\" xml:space=\"preserve\"><tspan x=\"66.81\" y=\"155.9\" text-anchor=\"start\"> go</tspan></text><svg class=\"pele-icon\" data-icon=\"fa:fa-car\" x=\"49.31\" y=\"143.3\" width=\"15.4\" height=\"15.4\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path id=\"car\"/></svg></g></g><g class=\"pele-nodes\"><g class=\"pele-node pele-state\" data-id=\"s2\" transform=\"translate(67.79,211)\"><rect x=\"-59.79\" y=\"-22\" width=\"119.58\" height=\"44\" rx=\"10\" fill=\"var(--_s)\" stroke=\"var(--_b)\"/><text class=\"pele-label\" text-anchor=\"middle\" xml:space=\"preserve\"><tspan x=\"-23.79\" y=\"5.6\" text-anchor=\"start\"> desc line</tspan></text><svg class=\"pele-icon\" data-icon=\"fa:fa-car\" x=\"-43.79\" y=\"-8.8\" width=\"17.6\" height=\"17.6\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path id=\"car\"/></svg></g><g class=\"pele-node pele-state\" data-id=\"s3\" transform=\"translate(318.66,82)\"><rect x=\"-32.22\" y=\"-22\" width=\"64.45\" height=\"44\" rx=\"10\" fill=\"var(--_s)\" stroke=\"var(--_b)\"/><text class=\"pele-label\" text-anchor=\"middle\" xml:space=\"preserve\"><tspan x=\"3.78\" y=\"5.6\" text-anchor=\"start\"> x</tspan></text><svg class=\"pele-icon\" data-icon=\"fa:fa-car\" x=\"-16.22\" y=\"-8.8\" width=\"17.6\" height=\"17.6\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path id=\"car\"/></svg></g><g class=\"pele-node pele-state\" data-id=\"s1\" transform=\"translate(67.79,98)\"><rect x=\"-43.78\" y=\"-22\" width=\"87.55\" height=\"44\" rx=\"10\" fill=\"var(--_s)\" stroke=\"var(--_b)\"/><text class=\"pele-label\" text-anchor=\"middle\" xml:space=\"preserve\"><tspan x=\"-7.78\" y=\"5.6\" text-anchor=\"start\"> First</tspan></text><svg class=\"pele-icon\" data-icon=\"fa:fa-car\" x=\"-27.78\" y=\"-8.8\" width=\"17.6\" height=\"17.6\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path id=\"car\"/></svg></g><g class=\"pele-note\" data-id=\"s1----note-1\" transform=\"translate(191.89,98)\"><path d=\"M-36.32,-18.5H28.32L36.32,-10.5V18.5H-36.32Z\" fill=\"var(--_bg)\" stroke=\"var(--_b)\"/><path d=\"M28.32,-18.5V-10.5H36.32\" fill=\"none\" stroke=\"var(--_b)\"/><text class=\"pele-label\" font-size=\"14\" fill=\"var(--_m)\" text-anchor=\"middle\" xml:space=\"preserve\"><tspan x=\"-6.82\" y=\"4.9\" text-anchor=\"start\"> note</tspan></text><svg class=\"pele-icon\" data-icon=\"fa:fa-car\" x=\"-24.32\" y=\"-7.7\" width=\"15.4\" height=\"15.4\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path id=\"car\"/></svg></g></g></svg>",
  )
}
