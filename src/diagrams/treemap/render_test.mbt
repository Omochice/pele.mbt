///|
test "a plain treemap draws sections with a header and leaves with a name and a value" {
  inspect(
    svg(
      "treemap-beta\n\"Category A\"\n    \"Item A1\": 10\n    \"Item A2\": 20\n\"Category B\"\n    \"Item B1\": 15\n    \"Item B2\": 25\n",
    ),
    content="656x416 <svg xmlns=\"http://www.w3.org/2000/svg\" class=\"pele pele-treemap\" viewBox=\"0 0 656 416\" width=\"656\" height=\"416\" style=\"max-width:100%;height:auto;--_bg:var(--pele-bg,#fff);--_fg:var(--pele-fg,#1f1f1f);--_m:var(--pele-muted,#6e6e6e);--_l:var(--pele-line,#1f1f1f);--_s:var(--pele-surface,#f3f3f3);--_a:var(--pele-surface-alt,#e6e6e6);--_b:var(--pele-border,#8a8a8a);--_c:var(--pele-accent,#5b7bd5);color:var(--_fg);--_r:var(--pele-radius,4px);--_hw:var(--pele-heading-weight,bold);--_fm:var(--pele-font-mono,monospace);font:16px sans-serif;letter-spacing:normal;word-spacing:normal;text-transform:none;direction:ltr;font-family:var(--pele-font,sans-serif)\" fill=\"var(--_fg)\" role=\"graphics-document document\" aria-roledescription=\"treemap\"><g class=\"pele-sections\" font-size=\"14\"><g class=\"pele-node pele-section\" data-id=\"Category B\"><rect x=\"8\" y=\"8\" width=\"364\" height=\"400\" fill=\"var(--pele-series-2,#f58518)\" fill-opacity=\"0.12\" stroke=\"var(--pele-series-2,#f58518)\" style=\"rx:var(--_r)\"/><text x=\"16\" y=\"27.9\" font-weight=\"var(--_hw)\">Category B</text><text class=\"pele-value\" x=\"364\" y=\"27.2\" font-size=\"12\" text-anchor=\"end\" fill=\"var(--_m)\">40</text></g><g class=\"pele-node pele-section\" data-id=\"Category A\"><rect x=\"376\" y=\"8\" width=\"272\" height=\"400\" fill=\"var(--pele-series-1,#4c78a8)\" fill-opacity=\"0.12\" stroke=\"var(--pele-series-1,#4c78a8)\" style=\"rx:var(--_r)\"/><text x=\"384\" y=\"27.9\" font-weight=\"var(--_hw)\">Category A</text><text class=\"pele-value\" x=\"640\" y=\"27.2\" font-size=\"12\" text-anchor=\"end\" fill=\"var(--_m)\">30</text></g></g><g class=\"pele-leaves\" text-anchor=\"middle\" fill=\"var(--_bg)\"><g class=\"pele-node pele-leaf\" data-id=\"Item B2\"><rect x=\"14\" y=\"36\" width=\"352\" height=\"227\" fill=\"var(--pele-series-2,#f58518)\" style=\"rx:var(--_r)\"/><text x=\"190\" y=\"146.98\" font-size=\"16\">Item B2</text><text class=\"pele-value\" x=\"190\" y=\"164.05\" font-size=\"13\">25</text></g><g class=\"pele-node pele-leaf\" data-id=\"Item B1\"><rect x=\"14\" y=\"267\" width=\"352\" height=\"135\" fill=\"var(--pele-series-2,#f58518)\" style=\"rx:var(--_r)\"/><text x=\"190\" y=\"331.98\" font-size=\"16\">Item B1</text><text class=\"pele-value\" x=\"190\" y=\"349.05\" font-size=\"13\">15</text></g><g class=\"pele-node pele-leaf\" data-id=\"Item A2\"><rect x=\"382\" y=\"36\" width=\"260\" height=\"243\" fill=\"var(--pele-series-1,#4c78a8)\" style=\"rx:var(--_r)\"/><text x=\"512\" y=\"154.98\" font-size=\"16\">Item A2</text><text class=\"pele-value\" x=\"512\" y=\"172.05\" font-size=\"13\">20</text></g><g class=\"pele-node pele-leaf\" data-id=\"Item A1\"><rect x=\"382\" y=\"283\" width=\"260\" height=\"119\" fill=\"var(--pele-series-1,#4c78a8)\" style=\"rx:var(--_r)\"/><text x=\"512\" y=\"339.98\" font-size=\"16\">Item A1</text><text class=\"pele-value\" x=\"512\" y=\"357.05\" font-size=\"13\">10</text></g></g></svg>",
  )
}

///|
test "a class gives its declarations to the boxes and their text" {
  inspect(
    svg(
      "treemap\n\"S\":::frame\n  \"a\": 1:::hot\n  \"b\": 2\nclassDef hot fill:red,color:blue,stroke:#FFD600;\nclassDef frame fill:#eee,stroke-width:2px",
    ),
    content="656x416 <svg xmlns=\"http://www.w3.org/2000/svg\" class=\"pele pele-treemap\" viewBox=\"0 0 656 416\" width=\"656\" height=\"416\" style=\"max-width:100%;height:auto;--_bg:var(--pele-bg,#fff);--_fg:var(--pele-fg,#1f1f1f);--_m:var(--pele-muted,#6e6e6e);--_l:var(--pele-line,#1f1f1f);--_s:var(--pele-surface,#f3f3f3);--_a:var(--pele-surface-alt,#e6e6e6);--_b:var(--pele-border,#8a8a8a);--_c:var(--pele-accent,#5b7bd5);color:var(--_fg);--_r:var(--pele-radius,4px);--_hw:var(--pele-heading-weight,bold);--_fm:var(--pele-font-mono,monospace);font:16px sans-serif;letter-spacing:normal;word-spacing:normal;text-transform:none;direction:ltr;font-family:var(--pele-font,sans-serif)\" fill=\"var(--_fg)\" role=\"graphics-document document\" aria-roledescription=\"treemap\"><g class=\"pele-sections\" font-size=\"14\"><g class=\"pele-node pele-section frame\" data-id=\"S\"><rect x=\"8\" y=\"8\" width=\"640\" height=\"400\" fill=\"var(--pele-series-1,#4c78a8)\" stroke=\"var(--pele-series-1,#4c78a8)\" style=\"rx:var(--_r);fill:#eee;stroke-width:2px;\"/><text x=\"16\" y=\"27.9\" font-weight=\"var(--_hw)\">S</text><text class=\"pele-value\" x=\"640\" y=\"27.2\" font-size=\"12\" text-anchor=\"end\" fill=\"var(--_m)\">3</text></g></g><g class=\"pele-leaves\" text-anchor=\"middle\" fill=\"var(--_bg)\"><g class=\"pele-node pele-leaf\" data-id=\"b\"><rect x=\"14\" y=\"36\" width=\"417\" height=\"366\" fill=\"var(--pele-series-1,#4c78a8)\" style=\"rx:var(--_r)\"/><text x=\"222.5\" y=\"216.48\" font-size=\"16\">b</text><text class=\"pele-value\" x=\"222.5\" y=\"233.55\" font-size=\"13\">2</text></g><g class=\"pele-node pele-leaf hot\" data-id=\"a\"><rect x=\"435\" y=\"36\" width=\"207\" height=\"366\" fill=\"var(--pele-series-1,#4c78a8)\" style=\"rx:var(--_r);fill:red;stroke:#FFD600;\"/><text x=\"538.5\" y=\"216.48\" font-size=\"16\" style=\"fill:blue;\">a</text><text class=\"pele-value\" x=\"538.5\" y=\"233.55\" font-size=\"13\" style=\"fill:blue;\">1</text></g></g></svg>",
  )
}

///|
test "text that does not fit is shrunk, shortened or left out" {
  inspect(
    svg(
      "treemap\n\"A section with a very long name indeed\"\n  \"big\": 1000\n  \"A leaf with quite a long name\": 60\n  \"tiny\": 12\n\"other\": 3000",
    ),
    content="656x416 <svg xmlns=\"http://www.w3.org/2000/svg\" class=\"pele pele-treemap\" viewBox=\"0 0 656 416\" width=\"656\" height=\"416\" style=\"max-width:100%;height:auto;--_bg:var(--pele-bg,#fff);--_fg:var(--pele-fg,#1f1f1f);--_m:var(--pele-muted,#6e6e6e);--_l:var(--pele-line,#1f1f1f);--_s:var(--pele-surface,#f3f3f3);--_a:var(--pele-surface-alt,#e6e6e6);--_b:var(--pele-border,#8a8a8a);--_c:var(--pele-accent,#5b7bd5);color:var(--_fg);--_r:var(--pele-radius,4px);--_hw:var(--pele-heading-weight,bold);--_fm:var(--pele-font-mono,monospace);font:16px sans-serif;letter-spacing:normal;word-spacing:normal;text-transform:none;direction:ltr;font-family:var(--pele-font,sans-serif)\" fill=\"var(--_fg)\" role=\"graphics-document document\" aria-roledescription=\"treemap\"><g class=\"pele-sections\" font-size=\"14\"><g class=\"pele-node pele-section\" data-id=\"A section with a very long name indeed\"><rect x=\"482\" y=\"8\" width=\"166\" height=\"400\" fill=\"var(--pele-series-1,#4c78a8)\" fill-opacity=\"0.12\" stroke=\"var(--pele-series-1,#4c78a8)\" style=\"rx:var(--_r)\"/><text x=\"490\" y=\"27.9\" font-weight=\"var(--_hw)\">A section with…</text><text class=\"pele-value\" x=\"640\" y=\"27.2\" font-size=\"12\" text-anchor=\"end\" fill=\"var(--_m)\">1,072</text></g></g><g class=\"pele-leaves\" text-anchor=\"middle\" fill=\"var(--_bg)\"><g class=\"pele-node pele-leaf\" data-id=\"other\"><rect x=\"8\" y=\"8\" width=\"470\" height=\"400\" fill=\"var(--pele-series-2,#f58518)\" style=\"rx:var(--_r)\"/><text x=\"243\" y=\"205.48\" font-size=\"16\">other</text><text class=\"pele-value\" x=\"243\" y=\"222.55\" font-size=\"13\">3,000</text></g><g class=\"pele-node pele-leaf\" data-id=\"big\"><rect x=\"488\" y=\"36\" width=\"154\" height=\"341\" fill=\"var(--pele-series-1,#4c78a8)\" style=\"rx:var(--_r)\"/><text x=\"565\" y=\"203.98\" font-size=\"16\">big</text><text class=\"pele-value\" x=\"565\" y=\"221.05\" font-size=\"13\">1,000</text></g><g class=\"pele-node pele-leaf\" data-id=\"A leaf with quite a long name\"><rect x=\"488\" y=\"381\" width=\"128\" height=\"21\" fill=\"var(--pele-series-1,#4c78a8)\" style=\"rx:var(--_r)\"/><text x=\"552\" y=\"394.65\" font-size=\"9\">A leaf with quite a long name</text></g><g class=\"pele-node pele-leaf\" data-id=\"tiny\"><rect x=\"620\" y=\"381\" width=\"22\" height=\"21\" fill=\"var(--pele-series-1,#4c78a8)\" style=\"rx:var(--_r)\"/><text x=\"631\" y=\"394.65\" font-size=\"9\">ti…</text></g></g></svg>",
  )
}

///|
test "the title from the front matter is drawn above the treemap" {
  inspect(
    svg("---\ntitle: From front matter\n---\ntreemap\n\"a\": 1"),
    content="656x448 <svg xmlns=\"http://www.w3.org/2000/svg\" class=\"pele pele-treemap\" viewBox=\"0 0 656 448\" width=\"656\" height=\"448\" style=\"max-width:100%;height:auto;--_bg:var(--pele-bg,#fff);--_fg:var(--pele-fg,#1f1f1f);--_m:var(--pele-muted,#6e6e6e);--_l:var(--pele-line,#1f1f1f);--_s:var(--pele-surface,#f3f3f3);--_a:var(--pele-surface-alt,#e6e6e6);--_b:var(--pele-border,#8a8a8a);--_c:var(--pele-accent,#5b7bd5);color:var(--_fg);--_r:var(--pele-radius,4px);--_tw:var(--pele-title-weight,bold);--_fm:var(--pele-font-mono,monospace);font:16px sans-serif;letter-spacing:normal;word-spacing:normal;text-transform:none;direction:ltr;font-family:var(--pele-font,sans-serif)\" fill=\"var(--_fg)\" role=\"graphics-document document\" aria-roledescription=\"treemap\"><text class=\"pele-title\" font-weight=\"var(--_tw)\" text-anchor=\"middle\" xml:space=\"preserve\"><tspan x=\"328\" y=\"25.6\">From front matter</tspan></text><g class=\"pele-leaves\" text-anchor=\"middle\" fill=\"var(--_bg)\"><g class=\"pele-node pele-leaf\" data-id=\"a\"><rect x=\"8\" y=\"40\" width=\"640\" height=\"400\" fill=\"var(--pele-series-1,#4c78a8)\" style=\"rx:var(--_r)\"/><text x=\"328\" y=\"237.48\" font-size=\"16\">a</text><text class=\"pele-value\" x=\"328\" y=\"254.55\" font-size=\"13\">1</text></g></g></svg>",
  )
}

///|
test "accessible names are written" {
  inspect(
    svg("treemap\naccTitle: Name\naccDescr: Text\n\"a\": 1"),
    content="656x416 <svg xmlns=\"http://www.w3.org/2000/svg\" class=\"pele pele-treemap\" viewBox=\"0 0 656 416\" width=\"656\" height=\"416\" style=\"max-width:100%;height:auto;--_bg:var(--pele-bg,#fff);--_fg:var(--pele-fg,#1f1f1f);--_m:var(--pele-muted,#6e6e6e);--_l:var(--pele-line,#1f1f1f);--_s:var(--pele-surface,#f3f3f3);--_a:var(--pele-surface-alt,#e6e6e6);--_b:var(--pele-border,#8a8a8a);--_c:var(--pele-accent,#5b7bd5);color:var(--_fg);--_r:var(--pele-radius,4px);--_fm:var(--pele-font-mono,monospace);font:16px sans-serif;letter-spacing:normal;word-spacing:normal;text-transform:none;direction:ltr;font-family:var(--pele-font,sans-serif)\" fill=\"var(--_fg)\" role=\"graphics-document document\" aria-roledescription=\"treemap\" aria-labelledby=\"pele-title\" aria-describedby=\"pele-desc\"><title id=\"pele-title\">Name</title><desc id=\"pele-desc\">Text</desc><g class=\"pele-leaves\" text-anchor=\"middle\" fill=\"var(--_bg)\"><g class=\"pele-node pele-leaf\" data-id=\"a\"><rect x=\"8\" y=\"8\" width=\"640\" height=\"400\" fill=\"var(--pele-series-1,#4c78a8)\" style=\"rx:var(--_r)\"/><text x=\"328\" y=\"205.48\" font-size=\"16\">a</text><text class=\"pele-value\" x=\"328\" y=\"222.55\" font-size=\"13\">1</text></g></g></svg>",
  )
}

///|
test "a treemap with no rows is an empty drawing" {
  inspect(
    svg("treemap"),
    content="656x416 <svg xmlns=\"http://www.w3.org/2000/svg\" class=\"pele pele-treemap\" viewBox=\"0 0 656 416\" width=\"656\" height=\"416\" style=\"max-width:100%;height:auto;--_bg:var(--pele-bg,#fff);--_fg:var(--pele-fg,#1f1f1f);--_m:var(--pele-muted,#6e6e6e);--_l:var(--pele-line,#1f1f1f);--_s:var(--pele-surface,#f3f3f3);--_a:var(--pele-surface-alt,#e6e6e6);--_b:var(--pele-border,#8a8a8a);--_c:var(--pele-accent,#5b7bd5);color:var(--_fg);--_fm:var(--pele-font-mono,monospace);font:16px sans-serif;letter-spacing:normal;word-spacing:normal;text-transform:none;direction:ltr;font-family:var(--pele-font,sans-serif)\" fill=\"var(--_fg)\" role=\"graphics-document document\" aria-roledescription=\"treemap\"></svg>",
  )
}

///|
test "names are escaped and unsafe declarations are dropped" {
  inspect(
    svg(
      "treemap\n\"<script>x</script>\":::bad\n  \"<img src=x onerror=alert(1)>\": 1:::bad\nclassDef bad fill:url(javascript:alert(1)),stroke:red",
    ),
    content="656x416 <svg xmlns=\"http://www.w3.org/2000/svg\" class=\"pele pele-treemap\" viewBox=\"0 0 656 416\" width=\"656\" height=\"416\" style=\"max-width:100%;height:auto;--_bg:var(--pele-bg,#fff);--_fg:var(--pele-fg,#1f1f1f);--_m:var(--pele-muted,#6e6e6e);--_l:var(--pele-line,#1f1f1f);--_s:var(--pele-surface,#f3f3f3);--_a:var(--pele-surface-alt,#e6e6e6);--_b:var(--pele-border,#8a8a8a);--_c:var(--pele-accent,#5b7bd5);color:var(--_fg);--_r:var(--pele-radius,4px);--_hw:var(--pele-heading-weight,bold);--_fm:var(--pele-font-mono,monospace);font:16px sans-serif;letter-spacing:normal;word-spacing:normal;text-transform:none;direction:ltr;font-family:var(--pele-font,sans-serif)\" fill=\"var(--_fg)\" role=\"graphics-document document\" aria-roledescription=\"treemap\"><g class=\"pele-sections\" font-size=\"14\"><g class=\"pele-node pele-section bad\" data-id=\"&lt;script&gt;x&lt;/script&gt;\"><rect x=\"8\" y=\"8\" width=\"640\" height=\"400\" fill=\"var(--pele-series-1,#4c78a8)\" fill-opacity=\"0.12\" stroke=\"var(--pele-series-1,#4c78a8)\" style=\"rx:var(--_r);stroke:red;\"/><text x=\"16\" y=\"27.9\" font-weight=\"var(--_hw)\">&lt;script&gt;x&lt;/script&gt;</text><text class=\"pele-value\" x=\"640\" y=\"27.2\" font-size=\"12\" text-anchor=\"end\" fill=\"var(--_m)\">1</text></g></g><g class=\"pele-leaves\" text-anchor=\"middle\" fill=\"var(--_bg)\"><g class=\"pele-node pele-leaf bad\" data-id=\"&lt;img src=x onerror=alert(1)&gt;\"><rect x=\"14\" y=\"36\" width=\"628\" height=\"366\" fill=\"var(--pele-series-1,#4c78a8)\" style=\"rx:var(--_r);stroke:red;\"/><text x=\"328\" y=\"216.48\" font-size=\"16\">&lt;img src=x onerror=alert(1)&gt;</text><text class=\"pele-value\" x=\"328\" y=\"233.55\" font-size=\"13\">1</text></g></g></svg>",
  )
}

///|
test "a treemap with nothing to size is an empty drawing" {
  inspect(
    svg("treemap\n\"a\": 0\n\"b\": ."),
    content="656x416 <svg xmlns=\"http://www.w3.org/2000/svg\" class=\"pele pele-treemap\" viewBox=\"0 0 656 416\" width=\"656\" height=\"416\" style=\"max-width:100%;height:auto;--_bg:var(--pele-bg,#fff);--_fg:var(--pele-fg,#1f1f1f);--_m:var(--pele-muted,#6e6e6e);--_l:var(--pele-line,#1f1f1f);--_s:var(--pele-surface,#f3f3f3);--_a:var(--pele-surface-alt,#e6e6e6);--_b:var(--pele-border,#8a8a8a);--_c:var(--pele-accent,#5b7bd5);color:var(--_fg);--_fm:var(--pele-font-mono,monospace);font:16px sans-serif;letter-spacing:normal;word-spacing:normal;text-transform:none;direction:ltr;font-family:var(--pele-font,sans-serif)\" fill=\"var(--_fg)\" role=\"graphics-document document\" aria-roledescription=\"treemap\"></svg>",
  )
}

///|
test "a value format applies to every value" {
  inspect(
    svg(
      "---\nconfig:\n  treemap:\n    valueFormat: '$.1%'\n    showValues: true\n---\ntreemap\n\"Market\"\n  \"A\": 0.35\n  \"B\": 0.65",
    ),
    content="656x416 <svg xmlns=\"http://www.w3.org/2000/svg\" class=\"pele pele-treemap\" viewBox=\"0 0 656 416\" width=\"656\" height=\"416\" style=\"max-width:100%;height:auto;--_bg:var(--pele-bg,#fff);--_fg:var(--pele-fg,#1f1f1f);--_m:var(--pele-muted,#6e6e6e);--_l:var(--pele-line,#1f1f1f);--_s:var(--pele-surface,#f3f3f3);--_a:var(--pele-surface-alt,#e6e6e6);--_b:var(--pele-border,#8a8a8a);--_c:var(--pele-accent,#5b7bd5);color:var(--_fg);--_r:var(--pele-radius,4px);--_hw:var(--pele-heading-weight,bold);--_fm:var(--pele-font-mono,monospace);font:16px sans-serif;letter-spacing:normal;word-spacing:normal;text-transform:none;direction:ltr;font-family:var(--pele-font,sans-serif)\" fill=\"var(--_fg)\" role=\"graphics-document document\" aria-roledescription=\"treemap\"><g class=\"pele-sections\" font-size=\"14\"><g class=\"pele-node pele-section\" data-id=\"Market\"><rect x=\"8\" y=\"8\" width=\"640\" height=\"400\" fill=\"var(--pele-series-1,#4c78a8)\" fill-opacity=\"0.12\" stroke=\"var(--pele-series-1,#4c78a8)\" style=\"rx:var(--_r)\"/><text x=\"16\" y=\"27.9\" font-weight=\"var(--_hw)\">Market</text><text class=\"pele-value\" x=\"640\" y=\"27.2\" font-size=\"12\" text-anchor=\"end\" fill=\"var(--_m)\">$100.0%</text></g></g><g class=\"pele-leaves\" text-anchor=\"middle\" fill=\"var(--_bg)\"><g class=\"pele-node pele-leaf\" data-id=\"B\"><rect x=\"14\" y=\"36\" width=\"407\" height=\"366\" fill=\"var(--pele-series-1,#4c78a8)\" style=\"rx:var(--_r)\"/><text x=\"217.5\" y=\"216.48\" font-size=\"16\">B</text><text class=\"pele-value\" x=\"217.5\" y=\"233.55\" font-size=\"13\">$65.0%</text></g><g class=\"pele-node pele-leaf\" data-id=\"A\"><rect x=\"425\" y=\"36\" width=\"217\" height=\"366\" fill=\"var(--pele-series-1,#4c78a8)\" style=\"rx:var(--_r)\"/><text x=\"533.5\" y=\"216.48\" font-size=\"16\">A</text><text class=\"pele-value\" x=\"533.5\" y=\"233.55\" font-size=\"13\">$35.0%</text></g></g></svg>",
  )
}

///|
test "a treemap is narrowed to the width the host has" {
  inspect(
    svg(
      "treemap\n\"Category A\"\n    \"Item A1\": 10\n    \"Item A2\": 20\n\"Category B\"\n    \"Item B1\": 15\n    \"Item B2\": 25\n",
      max_width=400,
    ),
