///|
/// A number as JavaScript's `String` writes it, which writes -0 as 0.
fn js_number(value : Double) -> String {
  if value == 0.0 {
    "0"
  } else {
    value.to_string()
  }
}

///|
/// Lays out a graph written as space-separated fields, and writes the result the same way.
/// The input is the direction, the options, then each node and each edge.
/// The output is the size, each node's center and size, then each edge's route and label center.
/// The expectations below are pele v1.8.0's own output for the same input, run in Node and written with `String`, so the strings match only when every coordinate is the same double.
/// They cover layouts that flowchart, class and state goldens make, and pele's random test graphs.
fn run_oracle(input : String) -> String {
  let fields = input.split(" ").map(field => field.to_owned()).collect()
  let mut at = 0
  let next = fn() {
    at += 1
    fields[at - 1]
  }
  let number = fn() {
    let field = next()
    match field {
      "Infinity" => @double.infinity
      "-Infinity" => @double.neg_infinity
      _ => @string.parse_double(field) catch { _ => @double.not_a_number }
    }
  }
  let int = fn() { number().to_int() }
  let flag = fn() { next() == "1" }
  let dir_of = fn(name : String) -> @layout.Dir {
    match name {
      "BT" => BT
      "LR" => LR
      "RL" => RL
      _ => TB
    }
  }
  let dir = dir_of(next())
  let node_sep = number()
  let edge_sep = number()
  let rank_sep = number()
  let port_sep = number()
  let tracks = flag()
  let straight = flag()
  let apart = flag()
  let head_room = number()
  let opt = @layout.LayeredOptions::new(
    node_sep~,
    edge_sep~,
    rank_sep~,
    port_sep~,
    tracks~,
    straight~,
    apart~,
    head_room~,
  )
  let nodes = Array::makei(int(), _ => {
    let node = @layout.cnode(number(), number(), parent=int())
    node.is_group = flag()
    let name = next()
    node.dir = if name == "-" { None } else { Some(dir_of(name)) }
    node.pad_x = number()
    node.pad_top = number()
    node.pad_bottom = number()
    node.min_w = number()
    node.seq = number()
    node.span = number()
    node
  })
  let edges = Array::makei(int(), _ => {
    let src = int()
    let dst = int()
    let minlen = int()
    let label_w = number()
    let label_h = number()
    @layout.CEdge::{
      src,
      dst,
      minlen,
      label_w,
      label_h,
      route: [],
      label_x: 0,
      label_y: 0,
    }
  })
  let size = @layout.compound_layout(nodes, edges, dir, opt)
  let out = [js_number(size.width), js_number(size.height)]
  for node in nodes {
    out.push(js_number(node.x))
    out.push(js_number(node.y))
    out.push(js_number(node.w))
    out.push(js_number(node.h))
  }
  for e in edges {
    out.push("|")
    for value in e.route {
      out.push(js_number(value))
    }
    out.push(js_number(e.label_x))
    out.push(js_number(e.label_y))
  }
  out.join(" ")
}

///|
/// Fails at the first field where the layout differs from pele's.
fn check_oracle(input : String, expected : String) -> Unit raise {
  let actual = run_oracle(input)
  if actual == expected {
    return
  }
  let got = actual.split(" ").map(field => field.to_owned()).collect()
  let want = expected.split(" ").map(field => field.to_owned()).collect()
  let mut i = 0
  while i < got.length() && i < want.length() && got[i] == want[i] {
    i += 1
  }
  let from = if i > 6 { i - 6 } else { 0 }
  let around = fn(list : Array[String]) {
    list[from:if i + 6 < list.length() { i + 6 } else { list.length() }]
    .iter()
    .collect()
    .join(" ")
  }
  fail("field \{i}: got [\{around(got)}] want [\{around(want)}]")
}

