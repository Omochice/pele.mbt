// The expected times were taken from node with TZ=UTC.

///|
test "parses date strings as V8 does" {
  let cases : Array[(String, String)] = [
    ("2017-07-20", "1500508800000"),
    ("2017-07", "1498867200000"),
    ("2017", "1483228800000"),
    ("+002017-07-20", "1500508800000"),
    ("-000001-01-01", "-62198755200000"),
    ("-000000-01-01", "978307200000"),
    ("2017-07-20T10:00", "1500544800000"),
    ("2017-07-20T10:00:30.5Z", "1500544830500"),
    ("2017-07-20T24:00", "1500595200000"),
    ("2017-07-20T24:01", "NaN"),
    ("2017-07-20T10:00+0530", "1500525000000"),
    ("2017-07-20T10:00-05:30", "1500564600000"),
    ("2017-07-20T10:00:00.123456789", "1500544800123"),
    ("2017-13-01", "NaN"),
    ("2017-02-31", "1488499200000"),
    ("202-12-01", "-55763856000000"),
    ("2017-7-20", "1500508800000"),
    ("2017-07-20 10:00", "1500544800000"),
    ("not a date", "NaN"),
    ("Jan 5, 2024", "1704412800000"),
    ("5 January 2024", "1704412800000"),
    ("January 5 2024 10:30 PM", "1704493800000"),
    ("Tue Mar 05 2024 10:00:00 GMT+0100", "1709629200000"),
    ("2024/03/05", "1709596800000"),
    ("03/05/2024", "1709596800000"),
    ("3/5/24", "1709596800000"),
    ("12:30", "NaN"),
    ("1/2/3 4:5:6.7", "1041480306700"),
    ("abc 2024", "1704067200000"),
    ("abc2024", "NaN"),
    ("(note) 2024-01-01", "1704067200000"),
    ("2024-01-01 (x", "1704067200000"),
    ("Mar 5 2024 UTC+2", "1709589600000"),
    ("Mar 5 2024 EST", "1709614800000"),
    ("Mar 5 2024 10:00 -0800", "1709661600000"),
    ("Mar 5 2024 10:00 +8", "1709604000000"),
    ("Mar 5 2024 10:00 +123", "1709627820000"),
    ("Mar 5 2024 10:00 +12345", "NaN"),
    ("Mar 5 2024 10:00 +05:", "1709614800000"),
    ("10:00 Mar 5 2024 pm", "1709676000000"),
    ("2024-01-01T", "NaN"),
    ("2024-01-01Tx", "NaN"),
    ("", "NaN"),
    (" ", "NaN"),
    ("1", "978307200000"),
    ("99", "915148800000"),
    ("50 1 1", "-631152000000"),
    ("49/1/1", "2493072000000"),
    ("Z 2024", "1704067200000"),
    ("2024 z", "1704067200000"),
    ("1:2:3 13 pm 5/5/5", "NaN"),
    ("5/5/5 13:00 pm", "NaN"),
    ("5/5/5 12:00 am", "1115251200000"),
    ("5/5/5 1::", "1115254800000"),
    ("5/5/5 1:2:3:4", "1115254923004"),
    ("5/5/5 10.123", "NaN"),
    ("5/5/5 10:20.5", "NaN"),
    ("May 1 1 1 1", "NaN"),
    ("2024-01-01 +5", "NaN"),
    ("2024-01-01 utc +5", "1704049200000"),
    ("0000-01-01", "-62167219200000"),
    ("9999-12-31T23:59:59.999Z", "253402300799999"),
    ("+275760-09-13", "8640000000000000"),
    ("+275760-09-14", "NaN"),
    ("-271821-04-20", "-8640000000000000"),
    ("-271821-04-19", "NaN"),
    ("1970-01-01T00:00:00.0001", "0"),
    ("12/31/1969 23:59:59.999", "-1"),
    ("Sat, 01 Jan 2000 00:00:00 GMT", "946684800000"),
    ("2000-01-01T00:00:00.000+24:00", "NaN"),
    ("2000-01-01T00:00:00.000+23:59", "946598460000"),
    ("x\u{a0}2024", "1704067200000"),
    ("2024\u{2028}1\u{2028}1", "NaN"),
    ("May\u{2028} 5 2024", "1714867200000"),
    ("1 2 3 4", "NaN"),
    ("2024-01-01-", "NaN"),
    ("jan-5-2024", "1704412800000"),
    ("5-jan-2024", "1704412800000"),
    ("2024 5 jan", "1704412800000"),
    ("31 2024 jan", "1706659200000"),
    ("0x10", "NaN"),
    ("2024-1-1T10:00", "NaN"),
    ("Mar 5 2024 10:00 +300000:", "629632800000"),
    ("Mar 5 2024 10:00 +600000:", "NaN"),
    ("Mar 5 2024 10:00 +1193047:", "1709630896000"),
    ("2024-01-01\u{0}x", "1704067200000"),
    ("Jan 5", "978652800000"),
  ]
  let wrong = cases.filter(case => {
    @date.parse_date(case.0).to_string() != case.1
  })
  inspect(wrong.map(case => case.0).join("|"), content="")
}
